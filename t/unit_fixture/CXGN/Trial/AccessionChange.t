scenario 'entry numbers' => sub {
    $schema->resultset('Project::Projectprop')->create({ project_id => $trial_id, type_id => $t{entry_numbers}, value => encode_json({ map { $acc{$_} => 100 + $_ } 1 .. 5 }) });
    my $map = sub { decode_json($schema->resultset('Project::Projectprop')->find({ project_id => $trial_id, type_id => $t{entry_numbers} })->value) };
    my $tmp = new_accession('review_tmp_accession');
    my $ac = $change->();

    my $plan = $ac->plan([ { plot_id => $plot{10}, new_stock_id => $tmp->stock_id } ]);
    is_deeply($plan->{entry_numbers}, [], 'one plot: test_accession3 stays in the trial and keeps its entry number');
    ok((grep { /review_tmp_accession has no entry number/ } @{$plan->{warnings}}), 'warning about the missing entry number');

    $plan = $ac->plan($ac->changes_for_stock($acc{3}, $acc{1}));
    is_deeply($plan->{entry_numbers}, [], 'into an accession that has one: no change');
    is_deeply($plan->{warnings}, [], 'and no warning');

    $plan = $ac->apply($ac->changes_for_stock($acc{3}, $tmp->stock_id));
    is_deeply($plan->{entry_numbers}, [ { stock_id => $tmp->stock_id, stock_name => 'review_tmp_accession', entry_number => 103, from_stock_id => $acc{3} } ], 'every plot: the entry number moves');
    my $after = $map->();
    is($after->{ $tmp->stock_id }, 103, 'stored for the new accession');
    ok(!exists($after->{ $acc{3} }), 'removed for the old one');
    is($after->{ $acc{1} }, 101, 'others kept');
};

