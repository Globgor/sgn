scenario 'RCBD with the template trialName_accessionName_repNumber: merging two accessions cannot keep the names unique' => sub {
    $schema->resultset('Project::Projectprop')->create({ project_id => $rcbd_id, type_id => $t{template}, value => encode_json({ review_format => { name_attributes => [ 'trialName', 'accessionName', 'repNumber' ] } }) });
    my $ac = $rcbd_change->();
    my $changes = $ac->changes_for_stock(stock_id('review_rcbd_acc_A'), stock_id('review_rcbd_acc_B'));
    # the plots of B are named after the template already
    foreach my $u (values %{ $ac->load_units() }) {
        rename_stock($u->{plot_id}, join('_', 'review_rcbd_trial', $u->{stock_name}, $u->{replicate})) if $u->{stock_name} eq 'review_rcbd_acc_B';
    }
    my $plan = $ac->plan($changes);
    ok((grep { /already exists/ } @{$plan->{errors}}), 'refused: '.join(' ', @{$plan->{errors}}));
    dies_with(sub { $ac->apply($changes) }, qr/already exists/, 'apply');
    is($ac->load_units()->{ $plot_a->{plot_id} }->{stock_name}, 'review_rcbd_acc_A', 'nothing changed');
    $ac->apply($changes, { rename_plots => 'none' });
    is($ac->load_units()->{ $plot_a->{plot_id} }->{stock_name}, 'review_rcbd_acc_B', 'with rename_plots none it works');
};

