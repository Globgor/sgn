# Tests CXGN::Trial::AccessionChange: changing the accession of plots in a
# field trial (and of wells in a genotyping plate).
#
# Every scenario runs in a transaction that is rolled back afterwards, so the
# fixture is unchanged for the scenarios after it and for other tests. The RCBD
# trial with plants and tissue samples is created once and removed at the end.

use strict;
use warnings;

use lib 't/lib';
use Test::More;
use SGN::Test::Fixture;
use SGN::Model::Cvterm;
use JSON;
use DateTime;
use File::Temp 'tempfile';
use CXGN::Trial;
use CXGN::Trial::TrialDesign;
use CXGN::Trial::TrialCreate;
use CXGN::Trial::TrialLayout;

BEGIN { use_ok('CXGN::Trial::AccessionChange'); }

my $f = SGN::Test::Fixture->new();
my $schema = $f->bcs_schema;
$schema->storage->auto_savepoint(1);

sub cvterm_id { return SGN::Model::Cvterm->get_cvterm_row($schema, $_[0], $_[1])->cvterm_id(); }
my %t = (
    plot_of => cvterm_id('plot_of', 'stock_relationship'),
    plant_of => cvterm_id('plant_of', 'stock_relationship'),
    subplot_of => cvterm_id('subplot_of', 'stock_relationship'),
    tissue_sample_of => cvterm_id('tissue_sample_of', 'stock_relationship'),
    intercrop_plot_of => cvterm_id('intercrop_plot_of', 'stock_relationship'),
    replicate => cvterm_id('replicate', 'stock_property'),
    block => cvterm_id('block', 'stock_property'),
    plot_number => cvterm_id('plot number', 'stock_property'),
    is_a_control => cvterm_id('is a control', 'stock_property'),
    accession => cvterm_id('accession', 'stock_type'),
    plot => cvterm_id('plot', 'stock_type'),
    tissue_sample => cvterm_id('tissue_sample', 'stock_type'),
    template => cvterm_id('plot_autogenerated_name_metadata', 'project_property'),
    entry_numbers => cvterm_id('project_entry_number_map', 'project_property'),
    genotyping_layout => cvterm_id('genotyping_layout', 'experiment_type'),
);

sub stock { return $schema->resultset('Stock::Stock')->find({ uniquename => $_[0] }); }
sub stock_id { my $s = stock($_[0]) or die "no stock $_[0]\n"; return $s->stock_id; }
sub name_of { return $schema->resultset('Stock::Stock')->find({ stock_id => $_[0] })->uniquename; }
sub linked_stock {
    my ($subject_id, $type) = @_;
    die "unknown relationship $type\n" if !$t{$type};
    my @rows = $schema->resultset('Stock::StockRelationship')->search({ subject_id => $subject_id, type_id => $t{$type} })->all;
    my @accessions = grep { $_->type_id == $t{accession} } map { $_->object } @rows;
    return join(',', sort map { $_->uniquename } @accessions);
}
sub prop {
    my ($stock_id, $type, $value) = @_;
    my $rs = $schema->resultset('Stock::Stockprop')->search({ stock_id => $stock_id, type_id => $t{$type} });
    if (@_ > 2) {
        $rs->delete;
        $schema->resultset('Stock::Stockprop')->create({ stock_id => $stock_id, type_id => $t{$type}, value => $value, rank => 0 }) if defined $value;
    }
    my $row = $rs->first;
    return $row ? $row->value : undef;
}
sub rename_stock { my ($id, $name) = @_; $schema->resultset('Stock::Stock')->find({ stock_id => $id })->update({ uniquename => $name, name => $name }); }
sub new_accession {
    my $name = shift;
    my $organism_id = stock('test_accession1')->organism_id;
    return $schema->resultset('Stock::Stock')->create({ uniquename => $name, name => $name, type_id => $t{accession}, organism_id => $organism_id });
}
sub cached_design {
    my $trial_id = shift;
    my $design = CXGN::Trial::TrialLayout->new({ schema => $schema, trial_id => $trial_id, experiment_type => 'field_layout' })->get_design();
    return { map { $_->{plot_name} => $_ } values %$design };
}
sub dies_with {
    my ($code, $pattern, $name) = @_;
    my $ok = eval { $code->(); 1 };
    my $error = $@;
    ok(!$ok, "$name: dies");
    like($error // '', $pattern, "$name: message");
}

sub scenario {
    my ($name, $code) = @_;
    subtest $name => sub {
        $schema->txn_begin();
        my $ok = eval { $code->(); 1 };
        my $error = $@;
        $schema->txn_rollback();
        ok($ok, "$name: ran") or diag($error);
    };
}

# --- test_trial: CRD, 15 plots, five accessions ------------------------------
my $trial_id = $schema->resultset('Project::Project')->find({ name => 'test_trial' })->project_id();
my %acc = map { $_ => stock_id("test_accession$_") } 1..5;
my %plot = map { $_ => stock_id("test_trial2$_") } 1..15;   # by plot number
my $fixture_state = { map { $_ => [ linked_stock($plot{$_}, 'plot_of'), prop($plot{$_}, 'replicate'), name_of($plot{$_}) ] } keys %plot };
my $change = sub { CXGN::Trial::AccessionChange->new({ schema => $schema, trial_id => $trial_id, @_ }) };

is($change->()->design_type, 'CRD', 'test_trial is a CRD');

scenario 'replace_name_part' => sub {
    my $r = \&CXGN::Trial::AccessionChange::replace_name_part;
    is(($r->('T-rep1-A1_3', 'A1', 'B2'))[0], 'T-rep1-B2_3', 'default RCBD name');
    is(($r->('T-plotno5-block1-A1_5', 'A1', 'B2'))[0], 'T-plotno5-block1-B2_5', 'default augmented name');
    is(($r->('T_A1_5', 'A1', 'B2'))[0], 'T_B2_5', 'greenhouse name');
    is(($r->('A1', 'A1', 'B2'))[0], 'B2', 'the whole name');
    is(($r->('18CHIP_309_3_NC16-0748', 'NC16-0748', 'MC14-0363'))[0], '18CHIP_309_3_MC14-0363', 'at the end, with a dash inside the name (#2097)');
    is(($r->('TA1X-rep1-A1_1', 'A1', 'B2'))[0], 'TA1X-rep1-B2_1', 'not inside the trial name');
    is(($r->('T-rep1-A10_1', 'A1', 'B2'))[0], 'T-rep1-A10_1', 'not inside a longer accession name');
    is(($r->('test_trial23', 'trial2', 'B2'))[0], 'test_trial23', 'not inside another part');
    my ($name, $reason) = $r->('A1_A1', 'A1', 'B2');
    ok(!defined($name), 'twice: not renamed');
    like($reason, qr/more than once/, 'twice: reason');
    ($name, $reason) = $r->('2021-A1-rep1-A1_1', 'A1', 'B2');
    ok(!defined($name), 'twice with separators: not renamed');
    is(($r->('T-rep1-A(1)_1', 'A(1)', 'B.2'))[0], 'T-rep1-B.2_1', 'regex characters in the old name');
    is(($r->('T-rep1-AX1_1', 'A.1', 'B2'))[0], 'T-rep1-AX1_1', 'a dot matches only a dot');
    is(($r->('T-rep1-A1_1', 'A1', 'B$2\\1'))[0], 'T-rep1-B$2\\1_1', 'special characters in the new name');
};

scenario 'CRD: replace test_accession3 by test_accession1 in every plot' => sub {
    my $ac = $change->();
    my $changes = $ac->changes_for_stock($acc{3}, $acc{1});
    is_deeply([ map { $_->{plot_id} } @$changes ], [ @plot{3, 4, 10} ], 'the three plots of test_accession3');
    my $plan = $ac->plan($changes);
    is_deeply($plan->{errors}, [], 'no errors');
    is(scalar(@{$plan->{changes}}), 3, 'three changes');
    is_deeply({ map { name_of($_->{plot_id}) => [ $_->{old}, $_->{new} ] } @{$plan->{replicates}} },
        { test_trial25 => [1, 3], test_trial28 => [2, 4], test_trial210 => [3, 5], test_trial211 => [3, 6] },
        'CRD: replicates of test_accession1 numbered again by plot number');
    is_deeply($plan->{renames}, [], 'no plot name contains the accession name');
    is(linked_stock($plot{3}, 'plot_of'), 'test_accession3', 'plan changes nothing');

    $ac->apply($changes);
    is(linked_stock($plot{$_}, 'plot_of'), 'test_accession1', "plot $_ has test_accession1") for (3, 4, 10);
    is_deeply([ map { prop($plot{$_}, 'replicate') } (3, 4, 5, 8, 10, 11) ], [1 .. 6], 'replicates 1..6');
    my $design = cached_design($trial_id);
    is($design->{test_trial210}->{accession_name}, 'test_accession1', 'cached layout regenerated');
    is($design->{test_trial211}->{rep_number}, 6, 'cached layout has the new replicate');
};

scenario 'invalid changes are refused and change nothing' => sub {
    my $ac = $change->();
    my $other_plot = $schema->resultset('Stock::Stock')->search({ type_id => $t{plot}, stock_id => { -not_in => [ values %plot ] } })->first->stock_id;
    my $obsolete = new_accession('review_obsolete_accession');
    $obsolete->update({ is_obsolete => 1 });
    my @cases = (
        [ [ { plot_id => $other_plot, new_stock_id => $acc{1} } ], qr/not part of this trial/, 'plot of another trial' ],
        [ [ { plot_id => 'abc', new_stock_id => $acc{1} } ], qr/not part of this trial/, 'not a plot id' ],
        [ [ { plot_id => $plot{10}, new_stock_id => $acc{1} }, { plot_id => $plot{10}, new_stock_id => $acc{2} } ], qr/more than once/, 'the same plot twice' ],
        [ [ { plot_id => $plot{10}, new_stock_id => 999999999 } ], qr/does not exist/, 'unknown stock' ],
        [ [ { plot_id => $plot{10} } ], qr/does not exist/, 'no stock' ],
        [ [ { plot_id => $plot{10}, new_stock_id => $obsolete->stock_id } ], qr/obsolete/, 'obsolete stock' ],
        [ [ { plot_id => $plot{10}, new_stock_id => $plot{1} } ], qr/test_trial21 is not an accession\./, 'a plot as the new stock' ],
        [ [ { plot_id => $plot{10}, new_stock_id => stock_id('cross_test1') } ], qr/cross_test1 is not an accession\./, 'a cross in a trial of accessions' ],
        [ [], qr/Nothing to change/, 'no changes' ],
    );
    foreach my $case (@cases) {
        dies_with(sub { $ac->apply($case->[0]) }, $case->[1], $case->[2]);
    }
    dies_with(sub { $change->(stock_type => 'cross')->apply([ { plot_id => $plot{10}, new_stock_id => $acc{1} } ]) }, qr/not a cross/, 'stock_type cross');
    my $plan = $ac->plan($ac->changes_for_stock($acc{3}, $plot{1}));
    is_deeply($plan->{errors}, [ 'Stock test_trial21 is not an accession.' ], 'an error that concerns three plots is listed once');
    dies_with(sub { $ac->apply([ { plot_id => $plot{10}, new_stock_id => $acc{1} } ], { rename_plots => 'all' }) }, qr/Unknown rename_plots/, 'unknown option');
    # a plot with two plot_of stocks
    $schema->resultset('Stock::StockRelationship')->create({ subject_id => $plot{1}, object_id => $acc{2}, type_id => $t{plot_of} });
    dies_with(sub { $ac->apply([ { plot_id => $plot{1}, new_stock_id => $acc{1} } ]) }, qr/linked to 2 stocks/, 'plot with two accessions');
    $schema->resultset('Stock::StockRelationship')->search({ subject_id => $plot{1}, object_id => $acc{2}, type_id => $t{plot_of} })->delete;
    is_deeply({ map { $_ => [ linked_stock($plot{$_}, 'plot_of'), prop($plot{$_}, 'replicate'), name_of($plot{$_}) ] } keys %plot }, $fixture_state, 'nothing was changed');
};

scenario 'a change to the current stock does nothing; a new name alone renames' => sub {
    my $ac = $change->();
    my $plan = $ac->apply([ { plot_id => $plot{10}, new_stock_id => $acc{3} } ]);
    is_deeply($plan->{unchanged}, [ 'test_trial210' ], 'reported as unchanged');
    is_deeply([ @{$plan->{changes}}, @{$plan->{replicates}}, @{$plan->{renames}} ], [], 'nothing planned');
    $plan = $ac->apply([ { plot_id => $plot{10}, new_stock_id => $acc{3}, new_plot_name => '  review_renamed_plot ' } ]);
    is(name_of($plot{10}), 'review_renamed_plot', 'renamed (spaces trimmed)');
    is(linked_stock($plot{10}, 'plot_of'), 'test_accession3', 'same accession');
    $plan = $ac->apply([ { plot_id => $plot{11}, new_stock_id => $acc{1}, new_plot_name => '   ' } ]);
    is_deeply($plan->{unchanged}, [ 'test_trial211' ], 'a blank new name is no new name');
};

scenario 'explicit names: two plots can swap names, conflicts are refused' => sub {
    my $ac = $change->();
    $ac->apply([ { plot_id => $plot{1}, new_stock_id => $acc{4}, new_plot_name => 'test_trial22' },
                 { plot_id => $plot{2}, new_stock_id => $acc{5}, new_plot_name => 'test_trial21' } ]);
    is_deeply([ name_of($plot{1}), name_of($plot{2}) ], [ 'test_trial22', 'test_trial21' ], 'names swapped');
    dies_with(sub { $ac->apply([ { plot_id => $plot{3}, new_stock_id => $acc{3}, new_plot_name => 'test_accession1' } ]) }, qr/already exists/, 'name of another stock');
    dies_with(sub { $ac->apply([ { plot_id => $plot{3}, new_stock_id => $acc{3}, new_plot_name => 'review_same' }, { plot_id => $plot{4}, new_stock_id => $acc{3}, new_plot_name => 'review_same' } ]) }, qr/2 stocks would be named review_same/, 'the same new name twice');
    dies_with(sub { $ac->apply([ { plot_id => $plot{3}, new_stock_id => $acc{3}, new_plot_name => 'test_trial24' } ]) }, qr/already exists/, 'name of a plot that keeps it');
};

scenario 'no template: the accession name is replaced where it is a whole part of the plot name' => sub {
    rename_stock($plot{3}, 'test_trial-rep1-test_accession3_3');
    rename_stock($plot{4}, 'test_accession3_x_test_accession3');
    my $ac = $change->();
    my $plan = $ac->apply($ac->changes_for_stock($acc{3}, $acc{1}));
    is(name_of($plot{3}), 'test_trial-rep1-test_accession1_3', 'renamed');
    is(name_of($plot{4}), 'test_accession3_x_test_accession3', 'twice: left as it is');
    is_deeply([ map { $_->{plot_name} } @{$plan->{not_renamed}} ], [ 'test_accession3_x_test_accession3' ], 'and reported');
    is(name_of($plot{10}), 'test_trial210', 'a name without the accession name is kept');
    is(name_of($plot{5}), 'test_trial25', 'plots that only get a new replicate keep their names');
};

scenario 'no template: an accession name inside another part of the name is not replaced' => sub {
    my $trial2 = new_accession('trial2');
    my $ac = $change->();
    $ac->apply($ac->changes_for_stock($acc{3}, $trial2->stock_id));
    $ac->apply($ac->changes_for_stock($trial2->stock_id, $acc{3}));
    is_deeply([ map { name_of($plot{$_}) } (3, 4, 10) ], [ 'test_trial23', 'test_trial24', 'test_trial210' ], 'names kept');
    is(linked_stock($plot{10}, 'plot_of'), 'test_accession3', 'accession back');
};

scenario 'rename_plots none keeps every name' => sub {
    rename_stock($plot{3}, 'test_trial-rep1-test_accession3_3');
    my $ac = $change->();
    my $plan = $ac->apply($ac->changes_for_stock($acc{3}, $acc{1}), { rename_plots => 'none' });
    is(name_of($plot{3}), 'test_trial-rep1-test_accession3_3', 'kept');
    is(linked_stock($plot{3}, 'plot_of'), 'test_accession1', 'accession changed');
};

scenario 'CRD with the template trialName_accessionName_repNumber: names follow the template, swapping names between plots' => sub {
    $schema->resultset('Project::Projectprop')->create({ project_id => $trial_id, type_id => $t{template}, value => encode_json({ review_format => { name_attributes => [ 'trialName', 'accessionName', 'repNumber' ] } }) });
    foreach my $n (keys %plot) {
        rename_stock($plot{$n}, join('_', 'test_trial', linked_stock($plot{$n}, 'plot_of'), prop($plot{$n}, 'replicate')));
    }
    my $ac = $change->();
    my $plan = $ac->apply($ac->changes_for_stock($acc{3}, $acc{1}));
    is_deeply([ map { name_of($plot{$_}) } (3, 4, 5, 8, 10, 11) ], [ map { "test_trial_test_accession1_$_" } 1 .. 6 ], 'every plot of test_accession1 has its template name');
    is(name_of($plot{1}), 'test_trial_test_accession4_1', 'other plots keep their names');
    is(scalar(grep { $_->{type} eq 'plot' } @{$plan->{renames}}), 6, 'six plots renamed');
};

scenario 'template with a text part and the breeding program' => sub {
    $schema->resultset('Project::Projectprop')->create({ project_id => $trial_id, type_id => $t{template}, value => encode_json({ review_format => { name_attributes => [ 'breedingProgram', { text => 'X' }, 'trialName', 'plotNumber', 'accessionName' ] } }) });
    my $ac = $change->();
    my $plan = $ac->plan([ { plot_id => $plot{10}, new_stock_id => $acc{2} } ]);
    my ($rename) = grep { $_->{stock_id} == $plot{10} } @{$plan->{renames}};
    like($rename->{new_name}, qr/^[^_]+_X_test_trial_10_test_accession2$/, 'template name: '.$rename->{new_name});
};

scenario 'the trial is read from the database, not from the cached layout' => sub {
    cached_design($trial_id);
    # plot 2 gets test_accession3 without the cache knowing it
    $schema->resultset('Stock::StockRelationship')->search({ subject_id => $plot{2}, type_id => $t{plot_of} })->update({ object_id => $acc{3} });
    my $tmp = new_accession('review_tmp_accession');
    my $ac = $change->();
    my $changes = $ac->changes_for_stock($acc{3}, $tmp->stock_id);
    is(scalar(@$changes), 4, 'four plots, plot 2 included');
    $ac->apply($changes);
    is_deeply([ map { prop($plot{$_}, 'replicate') } (2, 3, 4, 10) ], [1, 2, 3, 4], 'replicates 1..4');
};

scenario 'CRD: a plot without replicate keeps none, no error' => sub {
    prop($plot{10}, 'replicate', undef);
    my $ac = $change->();
    $ac->apply($ac->changes_for_stock($acc{3}, $acc{1}));
    ok(!defined(prop($plot{10}, 'replicate')), 'plot 10 still has no replicate');
    is_deeply([ map { prop($plot{$_}, 'replicate') } (3, 4, 5, 8, 11) ], [1 .. 5], 'the others 1..5');
};

scenario 'entry numbers' => sub {
    $schema->resultset('Project::Projectprop')->create({ project_id => $trial_id, type_id => $t{entry_numbers}, value => encode_json({ map { $acc{$_} => 100 + $_ } 1 .. 5 }) });
    my $map = sub { decode_json($schema->resultset('Project::Projectprop')->find({ project_id => $trial_id, type_id => $t{entry_numbers} })->value) };
    my $tmp = new_accession('review_tmp_accession');
    my $ac = $change->();

    my $plan = $ac->plan([ { plot_id => $plot{10}, new_stock_id => $tmp->stock_id } ]);
    is_deeply($plan->{entry_numbers}, [], 'one plot: test_accession3 stays in the trial and keeps its entry number');
    ok((grep { /review_tmp_accession has no entry number/ } @{$plan->{warnings}}), 'warning about the missing entry number');

    $plan = $ac->plan($ac->changes_for_stock($acc{3}, $acc{1}));
    is_deeply($plan->{entry_numbers}, [], 'into an accession that has one: no change');
    is_deeply($plan->{warnings}, [], 'and no warning');

    $plan = $ac->apply($ac->changes_for_stock($acc{3}, $tmp->stock_id));
    is_deeply($plan->{entry_numbers}, [ { stock_id => $tmp->stock_id, stock_name => 'review_tmp_accession', entry_number => 103, from_stock_id => $acc{3} } ], 'every plot: the entry number moves');
    my $after = $map->();
    is($after->{ $tmp->stock_id }, 103, 'stored for the new accession');
    ok(!exists($after->{ $acc{3} }), 'removed for the old one');
    is($after->{ $acc{1} }, 101, 'others kept');
};

scenario 'warnings: check plots' => sub {
    prop($plot{10}, 'is_a_control', 1);
    my $plan = $change->()->plan([ { plot_id => $plot{10}, new_stock_id => $acc{1} } ]);
    ok((grep { /test_trial210 is a check plot/ } @{$plan->{warnings}}), 'check plot warning');
};

scenario 'intercropping: the new accession cannot also be the intercrop of the plot' => sub {
    $schema->resultset('Stock::StockRelationship')->create({ subject_id => $plot{10}, object_id => $acc{1}, type_id => $t{intercrop_plot_of} });
    dies_with(sub { $change->()->apply([ { plot_id => $plot{10}, new_stock_id => $acc{1} } ]) }, qr/already has test_accession1 as an intercrop/, 'intercrop');
    $change->()->apply([ { plot_id => $plot{10}, new_stock_id => $acc{2} } ]);
    is(linked_stock($plot{10}, 'plot_of'), 'test_accession2', 'another accession is fine');
    is($schema->resultset('Stock::StockRelationship')->search({ subject_id => $plot{10}, type_id => $t{intercrop_plot_of} })->first->object_id, $acc{1}, 'intercrop kept');
};

scenario 'a plot changed after planning is not overwritten' => sub {
    my $ac = $change->();
    my $plan = $ac->plan($ac->changes_for_stock($acc{3}, $acc{1}));
    $schema->resultset('Stock::StockRelationship')->search({ subject_id => $plot{10}, type_id => $t{plot_of} })->update({ object_id => $acc{2} });
    dies_with(sub { $schema->txn_do(sub { $ac->_execute($plan) }) }, qr/changed by someone else/, 'execute an old plan');
    is(linked_stock($plot{3}, 'plot_of'), 'test_accession3', 'the plots before it were rolled back');
    is(linked_stock($plot{10}, 'plot_of'), 'test_accession2', 'the other change is kept');
};

scenario 'crosses and family names' => sub {
    my $cross_id = stock_id('cross_test1');
    my $family = $schema->resultset('Stock::Stock')->create({ uniquename => 'review_family', name => 'review_family', type_id => cvterm_id('family_name', 'stock_type'), organism_id => stock('test_accession1')->organism_id });
    dies_with(sub { $change->(stock_type => 'accession')->apply([ { plot_id => $plot{10}, new_stock_id => $cross_id } ]) }, qr/cross_test1 is not an accession\./, 'a cross in a trial of accessions');
    $change->(stock_type => 'cross')->apply([ { plot_id => $plot{10}, new_stock_id => $cross_id } ]);
    my $rel = $schema->resultset('Stock::StockRelationship')->find({ subject_id => $plot{10}, type_id => $t{plot_of} });
    is($rel->object_id, $cross_id, 'plot 10 has the cross');
    my $ac = $change->(stock_type => 'family_name');
    $ac->apply([ { plot_id => $plot{10}, new_stock_id => $family->stock_id } ]);
    is($ac->load_units()->{ $plot{10} }->{stock_name}, 'review_family', 'and then the family name');
    # the trial_stock_type property of the trial decides when no stock_type is given
    $schema->resultset('Project::Projectprop')->create({ project_id => $trial_id, type_id => cvterm_id('trial_stock_type', 'project_property'), value => 'cross' });
    $change->()->apply([ { plot_id => $plot{11}, new_stock_id => $cross_id } ]);
    is($change->()->load_units()->{ $plot{11} }->{stock_name}, 'cross_test1', 'a cross in a trial of crosses');
    dies_with(sub { $change->()->apply([ { plot_id => $plot{12}, new_stock_id => $acc{1} } ]) }, qr/test_accession1 is not a cross\./, 'an accession in a trial of crosses');
    is(cached_design($trial_id)->{test_trial210}->{accession_name}, 'review_family', 'cached layout');
};

# --- an RCBD trial with plants and tissue samples ------------------------------
my @rcbd_accessions = map { new_accession("review_rcbd_acc_$_")->stock_id } ('A', 'B', 'C', 'D');
my $td = CXGN::Trial::TrialDesign->new();
$td->set_trial_name('review_rcbd_trial');
$td->set_stock_list([ map { "review_rcbd_acc_$_" } ('A', 'B', 'C', 'D') ]);
$td->set_plot_start_number(1);
$td->set_plot_number_increment(1);
$td->set_number_of_blocks(2);
$td->set_design_type('RCBD');
$td->set_plot_layout_format('serpentine');
$td->calculate_design();
my $save = CXGN::Trial::TrialCreate->new({
    chado_schema => $schema, dbh => $f->dbh(), owner_id => 41, design => $td->get_design(), program => 'test',
    trial_year => '2026', trial_description => 'AccessionChange.t', trial_location => 'test_location',
    trial_name => 'review_rcbd_trial', design_type => 'RCBD', operator => 'janedoe',
})->save_trial();
my $rcbd_id = $save->{trial_id};
ok($rcbd_id, 'RCBD trial created');
my $rcbd_trial = CXGN::Trial->new({ bcs_schema => $schema, trial_id => $rcbd_id, phenome_schema => $f->phenome_schema, metadata_schema => $f->metadata_schema });
my $temp_dir = $f->config->{basepath}.'/'.$f->config->{tempfiles_subdir};
mkdir("$temp_dir/delete_nd_experiment_ids/") if !-d "$temp_dir/delete_nd_experiment_ids/";
my (undef, $nd_experiment_ids_file) = tempfile("$temp_dir/delete_nd_experiment_ids/fileXXXX");
my $phenotype_store_config = {
    basepath => $temp_dir,
    dbhost => $f->config->{dbhost},
    dbuser => $f->config->{dbuser},
    dbname => $f->config->{dbname},
    dbpass => $f->config->{dbpass},
    temp_file_nd_experiment_id => $nd_experiment_ids_file,
    user_id => '41',
    metadata_hash => { archived_file => 'none', archived_file_type => 'new stock treatment auto inheritance', operator => 'janedoe', date => DateTime->now()->ymd() },
};
ok($rcbd_trial->create_plant_entities(2, 1, undef, undef, undef, undef, $phenotype_store_config), 'plants created');
ok($rcbd_trial->create_tissue_samples(['leaf'], 1, 0, undef, undef, $phenotype_store_config), 'tissue samples created');

my $rcbd_change = sub { CXGN::Trial::AccessionChange->new({ schema => $schema, trial_id => $rcbd_id, @_ }) };
my $rcbd_units = $rcbd_change->()->load_units();
my @rcbd_plots = sort { $a->{plot_number} <=> $b->{plot_number} } values %$rcbd_units;
is(scalar(@rcbd_plots), 8, 'eight plots');
my ($plot_a) = grep { $_->{stock_name} eq 'review_rcbd_acc_A' && $_->{block} == 1 } @rcbd_plots;
like($plot_a->{plot_name}, qr/^review_rcbd_trial-rep1-review_rcbd_acc_A_\d+$/, 'default RCBD plot name: '.$plot_a->{plot_name});

sub plants_of { my $plot_id = shift; return [ sort map { $_->object_id } $schema->resultset('Stock::StockRelationship')->search({ subject_id => $plot_id, type_id => $t{plant_of} })->all ]; }
sub tissue_samples_of {
    my $parent_ids = shift;
    return [ sort map { $_->subject_id } $schema->resultset('Stock::StockRelationship')->search({ 'me.object_id' => { -in => $parent_ids }, 'me.type_id' => $t{tissue_sample_of}, 'subject.type_id' => $t{tissue_sample} }, { join => 'subject' })->all ];
}

scenario 'RCBD: replicates and blocks are kept; plants and tissue samples follow their plot' => sub {
    my $ac = $rcbd_change->();
    my $plants = plants_of($plot_a->{plot_id});
    is(scalar(@$plants), 2, 'two plants');
    my $samples = tissue_samples_of($plants);
    is(scalar(@$samples), 2, 'two tissue samples');

    my $plan = $ac->apply($ac->changes_for_stock(stock_id('review_rcbd_acc_A'), stock_id('review_rcbd_acc_B')));
    is_deeply($plan->{replicates}, [], 'RCBD: no replicate changes');
    my $units = $ac->load_units();
    foreach my $u (values %$units) {
        is($u->{replicate}, $u->{block}, "$u->{plot_name}: replicate = block");
    }
    my $plot = $units->{ $plot_a->{plot_id} };
    is($plot->{stock_name}, 'review_rcbd_acc_B', 'accession changed');
    (my $expected = $plot_a->{plot_name}) =~ s/review_rcbd_acc_A/review_rcbd_acc_B/;
    is($plot->{plot_name}, $expected, 'plot renamed: '.$expected);
    is_deeply(plants_of($plot_a->{plot_id}), $plants, 'the plants stay in the plot');
    foreach my $plant_id (@$plants) {
        is(linked_stock($plant_id, 'plant_of'), 'review_rcbd_acc_B', 'plant '.name_of($plant_id).' has the new accession');
        like(name_of($plant_id), qr/^\Q$expected\E_plant_/, 'plant renamed with the plot');
    }
    foreach my $sample_id (@$samples) {
        is(linked_stock($sample_id, 'tissue_sample_of'), 'review_rcbd_acc_B', 'tissue sample '.name_of($sample_id).' has the new accession');
        like(name_of($sample_id), qr/^\Q$expected\E_/, 'tissue sample renamed with the plot');
    }
    my $design = cached_design($rcbd_id);
    is($design->{$expected}->{accession_name}, 'review_rcbd_acc_B', 'cached layout');
    is_deeply([ sort @{ $design->{$expected}->{plant_names} } ], [ sort map { name_of($_) } @$plants ], 'cached layout has the new plant names');
};

scenario 'RCBD: swap the accessions of two plots, as Substitute does' => sub {
    my ($plot_b) = grep { $_->{stock_name} eq 'review_rcbd_acc_B' && $_->{block} == 1 } @rcbd_plots;
    my $ac = $rcbd_change->();
    $ac->apply([ { plot_id => $plot_a->{plot_id}, new_stock_id => $plot_b->{stock_id} }, { plot_id => $plot_b->{plot_id}, new_stock_id => $plot_a->{stock_id} } ]);
    my $units = $ac->load_units();
    is($units->{ $plot_a->{plot_id} }->{stock_name}, 'review_rcbd_acc_B', 'first plot');
    is($units->{ $plot_b->{plot_id} }->{stock_name}, 'review_rcbd_acc_A', 'second plot');
    is_deeply([ map { $units->{ $_->{plot_id} }->{plot_number} } ($plot_a, $plot_b) ], [ $plot_a->{plot_number}, $plot_b->{plot_number} ], 'plot numbers kept');
    is_deeply([ map { linked_stock($_, 'plant_of') } @{ plants_of($plot_a->{plot_id}) } ], [ 'review_rcbd_acc_B', 'review_rcbd_acc_B' ], 'plants of the first plot');
};

scenario 'RCBD: samples of a plot in other trials keep the accession, with a warning' => sub {
    my $well = $schema->resultset('Stock::Stock')->create({ uniquename => 'review_plate_well_A01', name => 'review_plate_well_A01', type_id => $t{tissue_sample}, organism_id => stock('test_accession1')->organism_id });
    $schema->resultset('Stock::StockRelationship')->create({ subject_id => $well->stock_id, object_id => $plot_a->{plot_id}, type_id => $t{tissue_sample_of} });
    $schema->resultset('Stock::StockRelationship')->create({ subject_id => $well->stock_id, object_id => $plot_a->{stock_id}, type_id => $t{tissue_sample_of} });
    my $ac = $rcbd_change->();
    my $plan = $ac->apply([ { plot_id => $plot_a->{plot_id}, new_stock_id => stock_id('review_rcbd_acc_C') } ]);
    ok((grep { /sample\(s\) of plot .* in other trials .*review_plate_well_A01.* keep review_rcbd_acc_A/ } @{$plan->{warnings}}), 'warning');
    is(linked_stock($well->stock_id, 'tissue_sample_of'), 'review_rcbd_acc_A', 'the well keeps its accession');
    is(name_of($well->stock_id), 'review_plate_well_A01', 'and its name');
};

scenario 'RCBD with the template trialName_accessionName_repNumber: merging two accessions cannot keep the names unique' => sub {
    $schema->resultset('Project::Projectprop')->create({ project_id => $rcbd_id, type_id => $t{template}, value => encode_json({ review_format => { name_attributes => [ 'trialName', 'accessionName', 'repNumber' ] } }) });
    my $ac = $rcbd_change->();
    my $changes = $ac->changes_for_stock(stock_id('review_rcbd_acc_A'), stock_id('review_rcbd_acc_B'));
    # the plots of B are named after the template already
    foreach my $u (values %{ $ac->load_units() }) {
        rename_stock($u->{plot_id}, join('_', 'review_rcbd_trial', $u->{stock_name}, $u->{replicate})) if $u->{stock_name} eq 'review_rcbd_acc_B';
    }
    my $plan = $ac->plan($changes);
    ok((grep { /already exists/ } @{$plan->{errors}}), 'refused: '.join(' ', @{$plan->{errors}}));
    dies_with(sub { $ac->apply($changes) }, qr/already exists/, 'apply');
    is($ac->load_units()->{ $plot_a->{plot_id} }->{stock_name}, 'review_rcbd_acc_A', 'nothing changed');
    $ac->apply($changes, { rename_plots => 'none' });
    is($ac->load_units()->{ $plot_a->{plot_id} }->{stock_name}, 'review_rcbd_acc_B', 'with rename_plots none it works');
};

