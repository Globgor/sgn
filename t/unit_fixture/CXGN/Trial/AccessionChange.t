scenario 'subplots and the plants in them follow their plot' => sub {
    my $ac = CXGN::Trial::AccessionChange->new({ schema => $schema, trial_id => $subplot_trial_id });
    my ($plot) = grep { $_->{stock_name} eq 'review_rcbd_acc_A' } values %{ $ac->load_units() };
    my @subplots = map { $_->object_id } $schema->resultset('Stock::StockRelationship')->search({ subject_id => $plot->{plot_id}, type_id => $t{subplot_of} })->all;
    is(scalar(@subplots), 2, 'two subplots');
    my @plants = map { $_->subject_id } $schema->resultset('Stock::StockRelationship')->search({ object_id => { -in => \@subplots }, type_id => cvterm_id('plant_of_subplot', 'stock_relationship') })->all;
    is(scalar(@plants), 4, 'four plants in them');
    my $plan = $ac->apply([ { plot_id => $plot->{plot_id}, new_stock_id => stock_id('review_rcbd_acc_C') } ]);
    is(linked_stock($_, 'subplot_of'), 'review_rcbd_acc_C', 'subplot '.name_of($_).' has the new accession') for @subplots;
    is(linked_stock($_, 'plant_of'), 'review_rcbd_acc_C', 'plant '.name_of($_).' has the new accession') for @plants;
    my $new_plot_name = name_of($plot->{plot_id});
    like($new_plot_name, qr/review_rcbd_acc_C/, 'plot renamed: '.$new_plot_name);
    like(name_of($_), qr/^\Q$new_plot_name\E_/, 'renamed with the plot: '.name_of($_)) for (@subplots, @plants);
    is($schema->resultset('Stock::StockRelationship')->search({ subject_id => { -in => \@plants }, object_id => { -in => \@subplots }, type_id => cvterm_id('plant_of_subplot', 'stock_relationship') })->count, 4, 'plants stay in their subplots');
};

# --- a genotyping plate --------------------------------------------------------
scenario 'genotyping plate: the accession of a well' => sub {
    my $project = $schema->resultset('Project::Project')->create({ name => 'review_plate', description => 'AccessionChange.t' });
    my $geolocation = $schema->resultset('NaturalDiversity::NdGeolocation')->search({})->first;
    my $experiment = $schema->resultset('NaturalDiversity::NdExperiment')->create({ nd_geolocation_id => $geolocation->nd_geolocation_id, type_id => $t{genotyping_layout} });
    $experiment->create_related('nd_experiment_projects', { project_id => $project->project_id });
    my %wells;
    foreach my $position ('A01', 'A02') {
        my $well = $schema->resultset('Stock::Stock')->create({ uniquename => "review_plate_$position", name => "review_plate_$position", type_id => $t{tissue_sample}, organism_id => stock('test_accession1')->organism_id });
        $experiment->create_related('nd_experiment_stocks', { stock_id => $well->stock_id, type_id => $t{genotyping_layout} });
        $schema->resultset('Stock::StockRelationship')->create({ subject_id => $well->stock_id, object_id => $acc{1}, type_id => $t{tissue_sample_of} });
        $schema->resultset('Stock::StockRelationship')->create({ subject_id => $well->stock_id, object_id => $plot{5}, type_id => $t{tissue_sample_of} });
        prop($well->stock_id, 'plot_number', $position);
        $wells{$position} = $well->stock_id;
    }
    my $ac = CXGN::Trial::AccessionChange->new({ schema => $schema, trial_id => $project->project_id, experiment_type => 'genotyping_layout' });
    is(scalar(keys %{ $ac->load_units() }), 2, 'two wells');
    my $plan = $ac->plan([ { plot_id => $wells{A01}, new_stock_id => $acc{2} } ]);
    is_deeply($plan->{errors}, [], 'no errors') or diag(join("\n", @{$plan->{errors}}));
    eval { $ac->_execute($plan) if !@{$plan->{errors}}; 1 } or diag("layout cache of the minimal plate: $@");
    is(linked_stock($wells{A01}, 'tissue_sample_of'), 'test_accession2', 'the well has the new accession');
    is($schema->resultset('Stock::StockRelationship')->search({ subject_id => $wells{A01}, object_id => $plot{5}, type_id => $t{tissue_sample_of} })->count, 1, 'its source plot is kept');
    is(name_of($wells{A01}), 'review_plate_A01', 'not renamed');
    $plan = $ac->plan([ { plot_id => $wells{A02}, new_stock_id => $acc{2}, new_plot_name => 'x' } ]);
    ok((grep { /cannot be renamed/ } @{$plan->{errors}}), 'wells cannot be renamed');
};

