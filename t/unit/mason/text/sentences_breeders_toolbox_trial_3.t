=head1 NAME

t/unit/mason/text/sentences_breeders_toolbox_trial_3.t - breeders_toolbox/trial templates, part 3 of 5: sentences appear in the user's language

=head1 DESCRIPTION

Renders components with SGN::Test::MasonText in English and with a test
translation. Components needing real data are compiled only.

=cut

use strict;
use warnings;
use utf8;

use lib 't/lib';
use Test::More;
use SGN::Test::MasonText qw( page_sentences_ok component_compiles_ok );

page_sentences_ok(
    '/breeders_toolbox/trial/set_phenotypes_fully_uploaded.mas',
    '{trial} Phenotypes Fully Uploaded',
);

page_sentences_ok(
    '/breeders_toolbox/trial/trial_coords_upload_dialogs.mas',
    'Upload Coordinates to {trial}',
);

page_sentences_ok(
    '/breeders_toolbox/trial/trial_create_dialogs.mas',
    'Plots can be named automatically by the database, or you may define a template to structure plot names. Visit the {em}Autogenerated Name Metadata{end_em} section of your breeding program to add plot name templates.',
);

page_sentences_ok(
    '/breeders_toolbox/trial/trial_entry_numbers_template_dialog.mas',
    'This workflow will generate an Excel spreadsheet which can be used to upload entry numbers (numbers assigned to acccessions in a set of trials). In the first step, select one or more trials you want to assign accession entry numbers. Then, download the Excel template containing the selected trials\' accessions. Once you have the entry numbers filled in, use the {strong}Upload Template{end_strong} function to upload the accession numbers to the database.',
    'Download the generated template and fill in the {column} column for each Accession you want to assign an entry number to. An entry number is not required for each Accession, but each entry number should be unique for this set of Trial(s). Once you have filled out the template, you can upload it to the database using the {strong}Upload Template{end_strong} function.',
    '{strong}Select Trial(s):{end_strong} Select one or more individual Trials or a List of Trials to assign entry numbers.',
);

page_sentences_ok(
    '/breeders_toolbox/trial/trial_entry_numbers_upload_dialog.mas',
    '{column} The entry number to assign to the Accession in all of the specified Trial(s). The entry number should be unique in this set of Trial(s).',
    '{column} (required) the name(s) of the Trials to assign entry numbers in (can include more than one comma-separated Trial name)',
    '{column} (required) the unique name of the Accession record, must exist in the database',
);

done_testing;
