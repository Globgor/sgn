=head1 NAME

t/unit/mason/text/tracking_activities_1.t - tracking_activities templates, part 1 of 2: the text is shown in the user's language

=head1 DESCRIPTION

Renders the components with HTML::Mason through SGN::Test::MasonText, without a
database or a Catalyst context. Each text must be on the page in English and,
with a test catalog, in its translated form. A component that needs real data
to run is only compiled.

=cut

use strict;
use warnings;
use utf8;

use lib 't/lib';
use Test::More;
use SGN::Test::MasonText qw( page_texts_ok component_compiles_ok );

page_texts_ok(
    '/tracking_activities/active_tracking_identifiers.mas',
    'Add Identifiers to a List',
    'Tracking Identifier',
);

page_texts_ok(
    '/tracking_activities/activity_info_details.mas',
    'You need to be logged in or you do not have sufficient privileges to update status of this tracking identifier.',
    'New information was saved.',
    'Go to Project Page',
    'Activity Details',
    'Close & Reload',
    'Update Status',
);

page_texts_ok(
    '/tracking_activities/activity_project.mas',
    'View information about completed or terminated tracking ids in this project.',
    'View information about ongoing tracking ids in this project.',
    'View and edit basic information about the project.',
);

page_texts_ok(
    '/tracking_activities/activity_project_details.mas',
