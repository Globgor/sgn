=head1 NAME

t/unit/mason/text/scripts_breeders_toolbox_program.t - scripts in the breeders_toolbox/program templates: the script text is shown in the user's language

=head1 DESCRIPTION

Renders the components with HTML::Mason through SGN::Test::MasonText, without a
database or a Catalyst context. Each text must be on the page in English and,
with a test catalog, in its translated form, as a JSON string inside a script. A component that needs real data
to run is only compiled.

=cut

use strict;
use warnings;
use utf8;

use lib 't/lib';
use Test::More;
use SGN::Test::MasonText qw( page_script_texts_ok component_compiles_ok );

page_script_texts_ok(
    '/breeders_toolbox/program/add_autogenerated_name_metadata_dialog.mas',
    'An error occurred storing autogenerated name metadata.',
    'Please select a name type first',
    'Last serial number is required',
    'Breeding program is required',
    'Format name is required',
    'Name type is required',
);

page_script_texts_ok(
    '/breeders_toolbox/program/add_product_profile_dialog.mas',
    'The product profile was saved successfully.',
    'Please supply a product profile scope',
    'Please supply a product profile name',
    'Please select a trait list',
);

page_script_texts_ok(
    '/breeders_toolbox/program/create_profile_template_dialog.mas',
    'An error occurred creating the profile template.',
    'Please supply a template file name',
    'Please select a trait list',
);

page_script_texts_ok(
    '/breeders_toolbox/program/traits.mas',
    'Error retrieving traits assayed in this breeding program',
    'An error occurred retrieving trait histogram data.',
);

page_script_texts_ok(
    '/breeders_toolbox/program/upload_profile_dialog.mas',
    'Please choose a breeding program',
    'Please enter a profile name',
    'Please enter a scope',
    'No file selected',
);

done_testing;
