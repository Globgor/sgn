=head1 NAME

t/unit/mason/text/transformation_1.t - transformation templates, part 1 of 3: the text is shown in the user's language

=head1 DESCRIPTION

Renders the components with HTML::Mason through SGN::Test::MasonText, without a
database or a Catalyst context. Each text must be on the page in English and,
with a test catalog, in its translated form. A component that needs real data
to run is only compiled.

=cut

use strict;
use warnings;
use utf8;

use lib 't/lib';
use Test::More;
use SGN::Test::MasonText qw( page_texts_ok component_compiles_ok );

page_texts_ok(
    '/transformation/add_transformant_names_dialog.mas',
    'The new transformants (accessions) were saved successfully.',
    'Add New Transformant (Accession) Names',
    'Close & Reload',
    'Name Format:',
    'How many?',
    'Success',
);

page_texts_ok(
    '/transformation/add_transformants_using_list_dialog.mas',
    'The new transformants were stored successfully.',
    'Select a List of Accessions to Add:',
    'Add New Transformants Using a List',
    'Add Transformants Error',
    'Success',
    'Submit',
);

page_texts_ok(
    '/transformation/add_transformation_control_dialog.mas',
    'Set this Transformation ID as a Control:',
    'Set Transformation Control Error',
    'Set Transformation Control',
    'Select a control:',
    'Set as a Control',
    'Success',
);

page_texts_ok(
    '/transformation/add_transformation_identifier_dialog.mas',
    'The transformation ID was saved successfully.',
    'Plant Material (accession name):',
    'Add New Transformation ID',
    'Transformation ID:',
    'Vector Construct:',
    'Close & Reload',
);

page_texts_ok(
    '/transformation/add_transformation_project_dialog.mas',
    'If your transformation project is automatically linked to the tracking tool, please set up a naming format for the autogenerated names of your transformation project before using the tracking tool.',
