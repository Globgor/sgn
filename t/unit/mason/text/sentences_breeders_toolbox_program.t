=head1 NAME

t/unit/mason/text/sentences_breeders_toolbox_program.t - breeders_toolbox/program templates: sentences appear in the user's language

=head1 DESCRIPTION

Renders components with SGN::Test::MasonText in English and with a test
translation. Components needing real data are compiled only.

=cut

use strict;
use warnings;
use utf8;

use lib 't/lib';
use Test::More;
use SGN::Test::MasonText qw( page_sentences_ok component_compiles_ok );

page_sentences_ok(
    '/breeders_toolbox/program/add_autogenerated_name_metadata_dialog.mas',
    '{bold}Name Type{end_bold}: Name type is used to retrieve related information used as attributes in the naming format. For example, attributes for a transformant name can be breeding program, vector construct, plant material used in the transformation, transformation project, transformation ID, text field.',
    '{bold}Last Serial Number{end_bold}: If you previously used this naming format before using the database. This input field allows you to continue using your naming format by indicating the last serial number that you used.',
    '{bold}Breeding Program{end_bold}: Each breeding program can store different types of naming formats. You can choose which naming format you would like to use for each project.',
    'After you use the naming format to add new names in the database, the last serial number is automatically updated and stored as new metadata of that naming format.',
    '{bold}Attributes for Basename{end_bold}: You can specify attributes you would like to include in a basename, as well as the order of these attributes.',
    '{bold}Format Name{end_bold}: Format name must be globally unique. It is an identifier used for capturing all metadata related to each naming format.',
);

page_sentences_ok(
    '/breeders_toolbox/program/upload_profile_dialog.mas',
    'Please indicates {bold}either{end_bold} a target value {bold}or{end_bold} a benchmark variety for each targeted trait. Benchmark variety must exist in the database.',
    'The template already contains trait names based on your trait list',
    'Default is 1',
);

done_testing;
