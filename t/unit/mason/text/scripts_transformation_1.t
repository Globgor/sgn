=head1 NAME

t/unit/mason/text/scripts_transformation_1.t - scripts in the transformation templates, part 1 of 2: the script text is shown in the user's language

=head1 DESCRIPTION

Renders the components with HTML::Mason through SGN::Test::MasonText, without a
database or a Catalyst context. Each text must be on the page in English and,
with a test catalog, in its translated form, as a JSON string inside a script. A component that needs real data
to run is only compiled.

=cut

use strict;
use warnings;
use utf8;

use lib 't/lib';
use Test::More;
use SGN::Test::MasonText qw( page_script_texts_ok component_compiles_ok );

page_script_texts_ok(
    '/transformation/add_transformant_names_dialog.mas',
    'Please set name format for autogenerated names for this project first. You can find Set Autogenerated Names link on the project page',
    'An error occurred creating new transformants',
);

page_script_texts_ok(
    '/transformation/add_transformants_using_list_dialog.mas',
    'An error occurred adding new transformants',
    'Please select a list',
);

page_script_texts_ok(
    '/transformation/add_transformation_control_dialog.mas',
    'This transformation ID has already been set as a control',
    'Error retrieving transformation ID info',
    'Please select a control',
);

page_script_texts_ok(
    '/transformation/add_transformation_identifier_dialog.mas',
    'An error occurred creating transformation ID',
    'Transformation ID is required',
    'Vector construct is required',
    'Plant material is required',
);

page_script_texts_ok(
    '/transformation/add_transformation_project_dialog.mas',
    'Breeding program is required',
    'Project name is required',
    'Description is required',
    'Location is required',
    'Year is required',
);

page_script_texts_ok(
    '/transformation/control_transformants_section.mas',
    'Number of Insertions',
    'Accession',
);

page_script_texts_ok(
    '/transformation/download_obsolete_metadata_using_list_dialog.mas',
    'The obsoleted stock list did not pass validation. Please correct the list and try again',
    'Please select an obsoleted stock list!',
);

page_script_texts_ok(
    '/transformation/edit_transformation_details.mas',
    'An error occurred updating transformation ID details',
);

page_script_texts_ok(
    '/transformation/obsolete_accessions_dialog.mas',
    'Please select accessions that you would like to obsolete',
    'Error obsoleting accessions.',
);

page_script_texts_ok(
    '/transformation/obsoleted_transformants_section.mas',
    'Obsoleted by',
    'Accession',
    'Date',
    'Note',
);

page_script_texts_ok(
    '/transformation/set_default_plant_material_dialog.mas',
    'An error occurred saving default plant material',
    'Plant material is required',
);

page_script_texts_ok(
    '/transformation/set_transformant_names_dialog.mas',
    'Please set up autogenerated name format for your breeding program first',
    'Error storing autogenerated name format!',
    'Please select a name format',
);

done_testing;
