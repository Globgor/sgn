# Review tests for replace_stock (Field Layout Tools -> Edit Field Layout -> Replace Accession).
# Each scenario starts from the fixture state of test_trial and restores it afterwards.
# The assertions describe the behaviour a user would expect; failures are findings.

use strict;
use warnings;

use lib 't/lib';
use SGN::Test::Fixture;
use Test::More;
use Test::WWW::Mechanize;
use JSON::XS;
use Data::Dumper;
use SGN::Model::Cvterm;
use CXGN::Trial::TrialLayout;
$Data::Dumper::Indent = 0;
$Data::Dumper::Sortkeys = 1;

my $f = SGN::Test::Fixture->new();
my $schema = $f->bcs_schema;
my $mech = Test::WWW::Mechanize->new;
my $base = 'http://localhost:3010';

$mech->post_ok("$base/brapi/v1/token", [ username => 'janedoe', password => 'secretpw', grant_type => 'password' ], 'login');

my $trial_id = $schema->resultset('Project::Project')->find({ name => 'test_trial' })->project_id();
my $plot_of_id = SGN::Model::Cvterm->get_cvterm_row($schema, 'plot_of', 'stock_relationship')->cvterm_id();
my $rep_id = SGN::Model::Cvterm->get_cvterm_row($schema, 'replicate', 'stock_property')->cvterm_id();
my $plot_number_id = SGN::Model::Cvterm->get_cvterm_row($schema, 'plot number', 'stock_property')->cvterm_id();
my $accession_type_id = SGN::Model::Cvterm->get_cvterm_row($schema, 'accession', 'stock_type')->cvterm_id();
my $tmpl_type_id = SGN::Model::Cvterm->get_cvterm_row($schema, 'plot_autogenerated_name_metadata', 'project_property')->cvterm_id();

my %acc = map { $_ => $schema->resultset('Stock::Stock')->find({ uniquename => $_, type_id => $accession_type_id })->stock_id } map { "test_accession$_" } 1..5;
my @plot_ids = (38857..38871);
my $organism_id = $schema->resultset('Stock::Stock')->find({ stock_id => $acc{test_accession3} })->organism_id;

# the real state in the database (not the layout cache)
sub db_state {
    my %s;
    foreach my $pid (@plot_ids) {
        my $plot = $schema->resultset('Stock::Stock')->find({ stock_id => $pid });
        my $rel = $schema->resultset('Stock::StockRelationship')->find({ subject_id => $pid, type_id => $plot_of_id });
        my $acc = $schema->resultset('Stock::Stock')->find({ stock_id => $rel->object_id });
        my $rep = $schema->resultset('Stock::Stockprop')->find({ stock_id => $pid, type_id => $rep_id });
        my $pn = $schema->resultset('Stock::Stockprop')->find({ stock_id => $pid, type_id => $plot_number_id });
        $s{$pid} = { name => $plot->uniquename, acc => $acc->uniquename, acc_id => $acc->stock_id, rep => ($rep ? $rep->value : undef), plot_number => $pn->value };
    }
    return \%s;
}

my $original = db_state();

sub restore {
    # two passes so that no intermediate name collides
    foreach my $pid (@plot_ids) {
        $schema->resultset('Stock::Stock')->find({ stock_id => $pid })->update({ uniquename => "review_tmp_$pid", name => "review_tmp_$pid" });
    }
    foreach my $pid (@plot_ids) {
        my $o = $original->{$pid};
        $schema->resultset('Stock::Stock')->find({ stock_id => $pid })->update({ uniquename => $o->{name}, name => $o->{name} });
        $schema->resultset('Stock::StockRelationship')->search({ subject_id => $pid, type_id => $plot_of_id })->update({ object_id => $o->{acc_id} });
        $schema->resultset('Stock::Stockprop')->search({ stock_id => $pid, type_id => $rep_id })->delete();
        $schema->resultset('Stock::Stockprop')->create({ stock_id => $pid, type_id => $rep_id, value => $o->{rep}, rank => 0 }) if defined $o->{rep};
    }
    $schema->resultset('Project::Projectprop')->search({ project_id => $trial_id, type_id => $tmpl_type_id })->delete();
    $mech->get_ok("$base/ajax/breeders/trial/$trial_id/refresh_cache", 'refresh cache after restore');
    is_deeply(db_state(), $original, 'fixture state restored');
}

sub replace_stock {
    my ($old_id, $new_name) = @_;
    $mech->post("$base/ajax/breeders/trial/$trial_id/replace_stock", [ old_stock_id => $old_id, new_stock => $new_name, trial_stock_type => 'accession' ]);
    my $r = eval { decode_json($mech->content) } || { http_status => $mech->status, raw => substr($mech->content, 0, 300) };
    diag("replace_stock($old_id -> $new_name): " . Dumper($r));
    return $r;
}

sub new_accession {
    my $name = shift;
    return $schema->resultset('Stock::Stock')->create({ uniquename => $name, name => $name, type_id => $accession_type_id, organism_id => $organism_id });
}

sub show { my $s = shift; diag(join("\n", map { sprintf("  plot %-3s %-40s %-28s rep=%s", $s->{$_}{plot_number}, $s->{$_}{name}, $s->{$_}{acc}, $s->{$_}{rep} // 'undef') } sort { $s->{$a}{plot_number} <=> $s->{$b}{plot_number} } keys %$s)); }

my $only = $ENV{REVIEW_ONLY} || '';
sub want { my $n = shift; return !$only || $only =~ /\b$n\b/; }

$mech->get_ok("$base/ajax/breeders/trial/$trial_id/refresh_cache");

# ---------------------------------------------------------------------------
if (want('S1')) {
    note('S1: replace test_accession3 by test_accession1, which is already in the trial');
    my $r = replace_stock($acc{test_accession3}, 'test_accession1');
    is_deeply($r, { success => 1 }, 'S1 succeeds');
    my $s = db_state(); show($s);
    my %rep_by_pn = map { $s->{$_}{plot_number} => $s->{$_}{rep} } grep { $s->{$_}{acc} eq 'test_accession1' } keys %$s;
    is_deeply(\%rep_by_pn, { 3 => 1, 4 => 2, 5 => 3, 8 => 4, 10 => 5, 11 => 6 }, 'S1 reps of test_accession1 renumbered by plot number');
    restore();
}

# ---------------------------------------------------------------------------
if (want('S2')) {
    note('S2: a plot of the replaced accession has no replicate stockprop (rep_number is optional on upload)');
    my $tmp = new_accession('review_tmp_acc_s2');
    $schema->resultset('Stock::Stockprop')->search({ stock_id => 38866, type_id => $rep_id })->delete();
    $mech->get_ok("$base/ajax/breeders/trial/$trial_id/refresh_cache");
    my $r = replace_stock($acc{test_accession3}, 'review_tmp_acc_s2');
    is_deeply($r, { success => 1 }, 'S2 succeeds although a plot has no rep number');
    my $s = db_state(); show($s);
    restore();
    $tmp->delete();

    note('S2b: a plot of the accession that is replaced INTO has no replicate stockprop');
    $schema->resultset('Stock::Stockprop')->search({ stock_id => 38861, type_id => $rep_id })->delete();
    $mech->get_ok("$base/ajax/breeders/trial/$trial_id/refresh_cache");
    $r = replace_stock($acc{test_accession3}, 'test_accession1');
    is_deeply($r, { success => 1 }, 'S2b succeeds although a plot of the target accession has no rep number');
    restore();
}

# ---------------------------------------------------------------------------
if (want('S3')) {
    note('S3: plot name template trialName_accessionName_repNumber (accepted by AddAutogeneratedNameMetadata as unique)');
    my $attempts = $ENV{REVIEW_S3_ATTEMPTS} || 6;
    my ($ok, $fail) = (0, 0);
    for my $i (1..$attempts) {
        $schema->resultset('Project::Projectprop')->create({ project_id => $trial_id, type_id => $tmpl_type_id, value => encode_json({ review_fmt => { name_attributes => [ 'trialName', 'accessionName', 'repNumber' ] } }) });
        my $st = db_state();
        foreach my $pid (@plot_ids) {
            my $n = join('_', 'test_trial', $st->{$pid}{acc}, $st->{$pid}{rep});
            $schema->resultset('Stock::Stock')->find({ stock_id => $pid })->update({ uniquename => $n, name => $n });
        }
        $mech->get_ok("$base/ajax/breeders/trial/$trial_id/refresh_cache");
        my $r = replace_stock($acc{test_accession3}, 'test_accession1');
        if ($r->{success}) {
            $ok++;
            my $s = db_state(); show($s);
            my %name_by_pn = map { $s->{$_}{plot_number} => $s->{$_}{name} } grep { $s->{$_}{acc} eq 'test_accession1' } keys %$s;
            is_deeply(\%name_by_pn, { map { $_->[0] => "test_trial_test_accession1_$_->[1]" } ([3,1],[4,2],[5,3],[8,4],[10,5],[11,6]) }, "S3 attempt $i: names follow the template");
        } else {
            $fail++;
        }
        # restore() also removes the template; the names were template names, restore puts back the fixture names
        restore();
    }
    diag("S3: $ok of $attempts attempts succeeded, $fail failed");
    is($fail, 0, 'S3 replace_stock with a valid template never fails on its own intermediate names');
}

# ---------------------------------------------------------------------------
if (want('S4')) {
    note('S4: the accession name happens to be a substring of a plot name (no template)');
    my $tmp = new_accession('trial2');
    my $r = replace_stock($acc{test_accession3}, 'trial2');
    is_deeply($r, { success => 1 }, 'S4 test_accession3 -> trial2 succeeds');
    my $s = db_state(); show($s);
    is($s->{38859}{name}, 'test_trial23', 'S4 plot test_trial23 keeps its name (test_accession3 is not in it)');
    $r = replace_stock($tmp->stock_id, 'test_accession3');
    is_deeply($r, { success => 1 }, 'S4 trial2 -> test_accession3 succeeds');
    $s = db_state(); show($s);
    is_deeply([ map { $s->{$_}{name} } (38859, 38860, 38866) ], [ 'test_trial23', 'test_trial24', 'test_trial210' ], 'S4 plot names are not changed where "trial2" is only a part of the trial name');
    restore();
    $tmp->delete();
}

# ---------------------------------------------------------------------------
if (want('S5')) {
    note('S5: stale layout cache (the trial was changed without regenerating the cache, as replace_stock did before this PR)');
    my $tmp = new_accession('review_tmp_acc_s5');
    $mech->get_ok("$base/ajax/breeders/trial/$trial_id/refresh_cache");
    # plot 2 (test_accession5, rep 1) moves to test_accession3 in the database only
    $schema->resultset('Stock::StockRelationship')->search({ subject_id => 38858, type_id => $plot_of_id })->update({ object_id => $acc{test_accession3} });
    my $r = replace_stock($acc{test_accession3}, 'review_tmp_acc_s5');
    is_deeply($r, { success => 1 }, 'S5 succeeds');
    my $s = db_state(); show($s);
    my @reps = sort { $a <=> $b } map { $s->{$_}{rep} } grep { $s->{$_}{acc} eq 'review_tmp_acc_s5' } keys %$s;
    is_deeply(\@reps, [1, 2, 3, 4], 'S5 reps of the new accession are 1..4 (computed from the real layout, not the stale cache)');
    restore();
    $tmp->delete();
}

done_testing();
