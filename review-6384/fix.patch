+
+# Renames several plots at once. Takes a hashref of plot_id => [old_name, new_name].
+# A new name may be the current name of another plot in the set (for example when
+# replicate numbers in template names shift), so every plot first gets a temporary
+# name. Returns an error string, or nothing.
+sub rename_plots {
+    my $self = shift;
+    my $renames = shift;
+
+    my %new_names = map { $renames->{$_}->[1] => 1 } keys %$renames;
+    if (scalar(keys %new_names) != scalar(keys %$renames)) {
+        return "The new plot names are not unique";
+    }
+
+    my %temp_names;
+    foreach my $plot_id (sort { $a <=> $b } keys %$renames) {
+        my $temp_name = $renames->{$plot_id}->[0]."__renaming_".$plot_id;
+        my $error = $self->replace_plot_name_fieldMap($plot_id, $renames->{$plot_id}->[0], $temp_name);
+        return $error if $error;
+        $temp_names{$plot_id} = $temp_name;
+    }
+    foreach my $plot_id (sort { $a <=> $b } keys %$renames) {
+        my $error = $self->replace_plot_name_fieldMap($plot_id, $temp_names{$plot_id}, $renames->{$plot_id}->[1]);
+        return $error if $error;
     }
+    return;
 }
 
