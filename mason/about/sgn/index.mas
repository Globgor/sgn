<div class="col-sm-11 col-md-11 col-lg-11">
<& /util/sentence.mas, text => __x('The Breedbase system has evolved from the {link}Sol Genomics Network (SGN){end_link} and {link2}Cassavabase{end_link2} and related sites (see {link3}RTBbase.org{end_link3}).'), link => '<a href="https://solgenomics.net">', end_link => '</a>', link2 => '<a href="https://cassavabase.org/">', end_link2 => '</a>', link3 => '<a href="https://rtbbase.org">', end_link3 => '</a>' &>
</div>
