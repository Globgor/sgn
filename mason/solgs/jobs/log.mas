<%doc>

=head1 NAME

/solgs/jobs/log.mas - displays status of submitted analyses jobs

=AUTHOR

Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>


<& /util/import_javascript.mas, classes => ["solGS.analysisStatus","jquery.dataTables"] &>


<div id="analysis_log_div" style="display:none">
  <button id="clear_dead_jobs_button" class='btn btn-sm btn-primary'><% __('Dismiss failed and timed out jobs') |h %></button>
  <br>
  <button id="clear_jobs_cache_button" class='btn btn-sm btn-primary'><% __('Dismiss all jobs older than') |h %></button> 
  <select id="keep_recent_jobs_select">
    <option value='one_week'><% __('One week') |h %></option>
    <option value='one_month'><% __('One month') |h %></option>
    <option value='six_months'><% __('Six months') |h %></option>
    <option value='one_year'><% __('One year') |h %></option>
  </select>
  <br>
  <table class="table" id="analysis_list" style="text-align: left;">
    <thead>
      <tr>
    	<th><% __('Analysis name') |h %></th>
        <th><% __('Analysis type') |h %></th>
        <th><% __('Submitted on') |h %></th>
    	<th><% __('Status') |h %></th>
    	<th><% __('Result page') |h %></th>
      </tr>
    </thead>
  </table>
</div>