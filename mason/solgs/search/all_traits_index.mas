<%doc>
A subset of GS traits list.
</%doc>

<%args>

$index
$traits_list

</%args>

<& /page/page_title.mas, 
   title=>$m->interp->apply_escapes( __('List of traits with GS data'), 'h' )
&>

<&| /page/info_section.mas, 
   title    => qq |Traits beginning with "$index" |
&>

<&/page/columnar_table.mas,
   data         => $traits_list,
  __align       => 'l',
  __alt_freq    => 2,
  __alt_width   => 1,
  __cellpadding => 20,
 &>

</&>
