<%doc>
solgs search results view.
</%doc>

<%args>

$result
$query
$pager => undef;
$page_links => undef;
$form => undef;
$genotyping_protocol_id => ''
</%args>

<& /util/import_javascript.mas, classes => ["solGS.solGS"] &>

<& /page/page_title.mas,
    title => $m->interp->apply_escapes( __('Traits with genomic selection data'), 'h' ),
&>
  
% if ($result) 
% { 

<&| /page/info_section.mas,
      title => $m->interp->apply_escapes( __('Search Results'), 'h' ),
&>
  <& /page/columnar_table.mas,
     headings    => ['Name', 'Definition'],
    data         => $result,
    __alt_freq   => 2,
    __alt_width  => 1,
    __align      => 'l'
  &>

  </&>
  
%}
%else
%{
<&| /page/info_section.mas,
      title => $m->interp->apply_escapes( __('Search Results'), 'h' ),
&>
%if ( $query )
%{
<br>No results found for <i><strong>'<% $query %>'.</strong></i><br />
%}
%else
%{
<br><% __('No results. Search again with a trait name.') |h %><br />
%}
</&>
%}

<input type="hidden" id="genotyping_protocol_id" value="<% $genotyping_protocol_id %>" />
