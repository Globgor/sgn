<%doc>

solGS search results view.

</%doc>

<%args>

$result
$form

</%args>

<& /page/page_title.mas,
    title => $m->interp->apply_escapes( __('solGS search results'), 'h' ),
&>
  
% if ($result) 
% { 

<&| /page/info_section.mas,
      title => $m->interp->apply_escapes( __('Search Results'), 'h' ),
&>

<& /page/columnar_table.mas,
     headings    => [ 'Population', 'Location', 'Year', 'PI' ],
     data        => $result,
    __alt_freq   => 2,
    __alt_width  => 1,
    __align      => 'l'
 &>
</&>

%}
%else
%{
<&| /page/info_section.mas,
      title => $m->interp->apply_escapes( __('No Search Results'), 'h' ),
&>

<br><% __('No results. Search again with a different term.') |h %><br />

</&>

%}

<&| /page/info_section.mas,
    title       => $m->interp->apply_escapes( __('Search'), 'h' ),
    collapsible => '1',
    collapsed   =>  1
&>

<& /search/solgs.mas, form => $form &>

</&>



