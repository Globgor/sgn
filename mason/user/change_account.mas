
<%args>
  $logged_in_username
  $private_email => ''
</%args>

<& /page/page_title.mas, title => $m->interp->apply_escapes( __("Update User Information"), 'h' ) &>

<% __('Please verify your current password to make changes. Select changes desired by checking the appropriate checkbox and entering the new information.') |h %> <br /><br />

<style>

.textlabel {
  width: 200px;
  white-space: nowrap;
  max-width: 150px;
  overflow: hidden;
  text-overflow: ellipsis;
  float:left;     
}

.input { 
  width: 200px;
  white-space:nowrap;
}

.checkboxes { 
  width: 20px;
  text-align: left;
}

.form-control { 
  width: 200px;
}

</style>

<form id="change_account_form" name="change_account_form"> 
<div>
  <label class="textlabel" for="current_password" id="current_password_label"><& /util/sentence.mas, text => __x('Current password {font}*{end_font}'), font => '<font color="red">', end_font => '</font>' &></label>
  <input type="password" class="form-control" id="current_password" name="current_password" />
</div>

<br />
<h4><input type="checkbox" id="change_password" name="change_password"><% __('Change password') |h %></input></h4>

<div>
  <label class="textlabel" for="new_password" ><% __('New password') |h %></label>
  <input class="form-control" id="new_password" name="new_password" type="password" />
</div>

<div>
  <label class="textlabel" for="confirm_password" ><% __('Confirm password') |h %></label>
  <input class="form-control" id="confirm_password" name="confirm_password" type="password" />
</div>
<br />
<br />

<h4><input type="checkbox" id="change_email" name="change_email"><% __('Change email') |h %></input></h4>
<div><% __('Your private e-mail address is not publicly displayed online. It is used only for SGN staff to contact you about changes to your record or for e-mailing your password to you. Changing your private e-mail address will trigger a confirmation message from SGN to verify the address is usable by SGN.') |h %></div><br />
<div>
  <label class="textlabel" for="private_email" ><% __('New email') |h %></label>
  <input class="form-control" id="private_email" name="private_email" value="<% $private_email %>" />
</div>
<div>
  <label class="textlabel" for="confirm_email" ><% __('Confirm email') |h %></label>
  <input class="form-control" id="confirm_email" name="confirm_email" value="<% $private_email %>" />
</div>

<br />
<br />
<h4><input class="checkboxes" type="checkbox" id="change_username" name="change_username"><% __('Change username') |h %></input></h4>
<div>
  <label class="textlabel" for="new_username"><% __('New username') |h %></label>
  <input class="form-control" id="new_username" name="new_username" value="<% $logged_in_username %>" />
</div>

<br />

<br />
<br />
<button class="btn btn-secondary" type="clear_form" id="clear_form"><% __('Reset form') |h %></button>

<button type="submit" class="btn btn-primary" id="submit_account_info"><% __('Change Account Information') |h %></button>

</form>


<script>
  jQuery(document).ready( function() { 
    jQuery('#change_account_form').submit( function(event) { 
       event.preventDefault();
       var form_data = jQuery('#change_account_form').serialize();
       // alert(JSON.stringify(form_data));
       jQuery.ajax( { 
         url: '/ajax/user/update',
         method: 'POST',
         data: form_data,
         error: function(r) { alert(<% __('An error occurred! Sorry!') |js %>);  },
         success: function(r) {
           if (r.error) { alert(r.error); }
           else { 
             alert("Done! " +r.message);
           }
         }
       });
    });
  });

</script>
