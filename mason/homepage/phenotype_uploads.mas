<%args>
$phenotype_files => undef
</%args>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="panel panel-default">
                <div class="panel-heading"><% __('Phenotype Files Uploaded') |h %></div>
                    <div class="panel-body">
                        <table class="table table-bordered" id="homepage_phenotype_uploads" alt="">
                            <thead>
                                <tr><th><% __('Filename') |h %></th><th><% __('Date Uploaded') |h %></th><th><% __('Uploaded By') |h %></th><th><% __('File Type') |h %></th><th><% __('Options') |h %></th><th><% __('Trial') |h %></th></tr>
                            </thead>
                            <tbody>
% foreach my $f (@$phenotype_files) {
                                <tr>
                                    <td><% $f->{metadata}->[4] %></td>
                                    <td><% $f->{metadata}->[1] %></td>
                                    <td><a href="/solpeople/profile/<% $f->{metadata}->[2] %>"><% $f->{metadata}->[3] %></a></td>
                                    <td><% $f->{metadata}->[6] %></td>
                                    <td><a href="/breeders/phenotyping/view/<% $f->{metadata}->[0] %>"><% __('View') |h %></a> | <a href="/breeders/phenotyping/download/<% $f->{metadata}->[0] %>"><% __('Download') |h %></a></td>
                                    <td>
% foreach my $p (keys %{$f->{project_ids}}) {
                                        <a href='/breeders/trial/<% $p %>'><% $f->{project_ids}->{$p} %></a>&nbsp;&nbsp;
% }
                                    </td>
                                </tr>
% }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
jQuery(document).ready(function() {
    jQuery('#homepage_phenotype_uploads').DataTable({
        "ordering": false,
    });
});
</script>
