<%doc>

=head1 NAME 
qtl/qtl_form/geno_form.mas - a mason component for a genotype data file submission

=AUTHOR
Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$pop_id
$guide

</%args>

<& /page/page_title.mas, title => $m->interp->apply_escapes( __("Step 4: Submit Genotype Data"), 'h' ) &>
<&| /page/info_section.mas, title => $m->interp->apply_escapes( __("Genotype Dataset"), 'h' ), subtitle => $guide &>

<form action="/phenome/qtl_load.pl" method="POST" enctype="MULTIPART/FORM-DATA">         
     <table cellspacing=20>
      <tr>
        <td> <% __('Genotype Dataset:') |h %> </td>
	<td> <input type="file" name="geno_file" size=40>
	<td> <input type="hidden" name="type" value="geno_form"> </td>
	<td> <input type="hidden" name="pop_id" value=<% $pop_id %> > </td>  
	<td> <input type="submit" value="<% __('Submit') |h %>"> </td>
     </tr>  
    </table>
</form>
</&>
