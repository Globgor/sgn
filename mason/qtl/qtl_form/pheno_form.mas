<%doc>

=head1 NAME 
qtl/qtl_form/pheno_form.mas - a mason component for a phenotype data file submission

=AUTHOR
Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$pop_id
$guide

</%args>

<& /page/page_title.mas, title => $m->interp->apply_escapes( __("Step 3: Submit Phenotype Data"), 'h' ) &>
<&| /page/info_section.mas, title => $m->interp->apply_escapes( __("Phenotype Dataset"), 'h' ), subtitle => $guide &>

 <form action="/phenome/qtl_load.pl" method="POST" enctype="MULTIPART/FORM-DATA"> 
     <table cellspacing=20>
     <tr>
       <td><% __('Phenotype Dataset:') |h %></td>
       <td><input type="file" name="pheno_file" size=40>
       <td> <input type="hidden" name="type" value="pheno_form"></td> 
       <td> <input type="hidden" name="pop_id" value = <% $pop_id %> ></td>
       <td><input type="submit" value="<% __('Submit') |h %>"> </td>
     </tr>            
    </table>
</form>

</&>
