<%doc>
QTL search results view.
</%doc>

<%args>

$data
$pager
$page_links
$query

</%args>

<& /page/page_title.mas,
    title => $m->interp->apply_escapes( __('QTL search results'), 'h' ),
&>
  
% if ($data) 
% { 

<&| /page/info_section.mas,
      title => $m->interp->apply_escapes( __('Search Results'), 'h' ),
&>
  <& /page/columnar_table.mas,
     headings    => [ 'Trait name', 'Definition', 'QTL' ],
    data         => $data,
    __alt_freq   => 2,
    __alt_width  => 1,
    __align      => 'l'
  &>
  </&>
  <& /page/pagination_control.mas, 
     pager     => $pager, 
    link_maker => $page_links 
  &> 
%}
%else
%{
<&| /page/info_section.mas,
      title => $m->interp->apply_escapes( __('Search Results'), 'h' ),
&>
%if ( $query )
%{
<br>No results found for <i><strong>'<% $query %>'.</strong></i><br />
%}
%else
%{
<br><% __('No results. Search again with with a trait name.') |h %><br />
%}
</&>
%}

<&| /page/info_section.mas,
    title       => $m->interp->apply_escapes( __('Search'), 'h' ),
    collapsible => '1',
    collapsed   => 1
 &>

<& /search/phenotypes/qtl.mas &>

</&>


