=cut

</%doc>

<&| /page/info_section.mas, 
   title      => $m->interp->apply_escapes( __("Step 2: Traits list"), 'h' ),
  collapsible => 1,
  collapsed   => 1
&>

<% __('The traits list file needs to be in a text file and should look like the following format.') |h %><br/>

<pre>
  traits             definition                            unit
  fruit perimeter    the maximum perimeter of the fruit    cm
  fruit area         total area of the fruit               sq. cm
  fruit weight
</pre>


<% __('The definition and unit are optional but would make the phenotype data more informative to users of the database.') |h %><br/>

<% __('Use of the Solanaceae Phenotype Ontology is highly encouraged to allow cross-study comparative analysis but not required.') |h %> <br/>  
</&>
