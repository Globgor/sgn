<%args>
    $content => ''
    $sha1
    $bulk_js_menu
    $bulk_download_stats
    $bulk_download_success
</%args>
<% $bulk_js_menu %>
<h1><% __('Feature Download Summary') |h %></h1>

% if($bulk_download_success) {
    <% __('Your query was successful.') |h %><br>
<div id="bulk_download_stats">
<% $bulk_download_stats %>
</div>
Download as <a href="/bulk/feature/download/<% $sha1 %>.fasta">Fasta</a>
% } else {
    <% __('Your query did not contain any valid identifiers. Please try again.') |h %>
% }
