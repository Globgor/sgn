
<%args>
$stock_id
</%args>

<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Pedigree string'), 'h' ) &>
  <select id="pedigree_level_select">
    <option value="Parents"><% __('Parents') |h %></option>
    <option value="Grandparents"><% __('Grandparents') |h %></option>
    <option value="Great-Grandparents"><% __('Great-Grandparents') |h %></option>
  </select>

  <span id="pedigree_string"><% __('[loading...]') |h %></span>

  <br /><br />
</&>

<script>

jQuery(document).ready(function($) {

  get_pedigree_string(<% $stock_id %>);
  jQuery('#pedigree_level_select').change( function() {
    jQuery('#pedigree_string').html('[loading...]');
    get_pedigree_string(<% $stock_id %>);
  });
});

function get_pedigree_string(stock_id) {
    jQuery.ajax( {
      url : '/stock/'+ stock_id +'/pedigreestring',
      data : { 'level' : jQuery('#pedigree_level_select').val() },
      error : function(response) {
         alert("an error occurred");
      },
      success: function(response) {
         jQuery('#pedigree_string').html(response.pedigree_string);
      }
    });
}

</script>
