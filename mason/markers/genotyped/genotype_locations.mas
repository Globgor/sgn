<%args>
    $markers => undef
</%args>

<%init>
    if ( !$markers ) {
        print "<p><strong>ERROR: </strong>Missing variant markers!</p>";
    }
</%init>

<table class="table table-striped">
    <thead>
        <tr>
            <th><% __('Marker') |h %></th>
            <th><% __('Protocol') |h %></th>
            <th><% __('Species') |h %></th>
            <th><% __('Reference') |h %></th>
            <th><% __('Chromosome') |h %></th>
            <th><% __('Position') |h %></th>
            <th><% __('Ref') |h %></th>
            <th><% __('Alt') |h %></th>
        </tr>
    </thead>
    <tbody>
% foreach my $marker (@$markers) {
        <tr>
            <td><strong><% $marker->{'marker_name'} %></strong></td>
            <td>
                <a href="/breeders_toolbox/protocol/<% $marker->{'nd_protocol_id'} %>">
                    <% $marker->{'nd_protocol_name'} %>
                </a>
            </td>
            <td><% $marker->{'species_name'} %></td>
            <td><% $marker->{'reference_genome_name'} %></td>
            <td><% $marker->{'chrom'} %></td>
            <td><% $marker->{'pos'} %></td>
            <td><% $marker->{'ref'} %></td>
            <td><% $marker->{'alt'} %></td>
        </tr>    
% }
    </tbody>
  </table>