<& /page/page_title.mas, title => $m->interp->apply_escapes( __('Display a sequence from a BLAST database'), 'h' ) &>

<form>
<table cellpadding="5" cellspacing="5" alt=""><tr>
<td><b><% __('Dataset') |h %></b></td><td> <select name="blast_db_id">
<option value="93">Tomato WGS Sequence</option>
<option value="56">Tomato BAC contigs</option>
</select></td></tr>

<td><b><% __('Id') |h %></b></td><td> <input type="text" name="id" size="10"/><br /></td></tr>

<tr><td colspan="3"><b>Highlight coordinates (enter as: 1-100,200-300)</b></td></tr>
<tr><td><b><% __('Coordinates:') |h %> </b></td><td> <input type="text" name="hilite_coords" size="10" /><br /></td></tr>

<tr><td><b><% __('Format') |h %></b></td><td><select name="format"><option value="html">html</option><option value="text">text</option></select></td></tr>

</table>

<input type="submit" />
</form>

