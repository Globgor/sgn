<%args>
    $feature
    $blast_url => undef
</%args>
<%once>
    use SGN::View::Feature 'mrna_cds_protein_sequence';
</%once>
<%perl>
    my @mrnas       = grep $_->type->name eq 'mRNA', $feature->child_features;
</%perl>


<&| /page/info_section.mas,
        title       => $m->interp->apply_escapes( __('Genomic sequence'), 'h' ),
        subtitle    => $m->interp->apply_escapes( __('unprocessed genomic sequence region underlying this gene'), 'h' ),
        empty_message => 'Not available',
        collapsible => 1,
        collapsed   => 1,
&>

   <& /feature/region_sequence.mas,
       feature   => $feature,
       blast_url => $blast_url,
   &>

</&>

% for my $mrna ( @mrnas ) {

  <&| /page/info_section.mas,
          title       => 'mRNA '. $mrna->name,
          collapsible => 1,
  &>

    <&| /page/info_section.mas,
       title => $m->interp->apply_escapes( __('Ontology terms'), 'h' ),
       subtitle => $m->interp->apply_escapes( __('terms associated with this mRNA'), 'h' ),
       collapsible => 1,
       is_subsection => 1,
    &>

      <& /feature/feature_cvterms.mas,
          feature   => $mrna,
      &>

    </&>

%   my ( $mrna_sequence, $cds_sequence, $protein_sequence ) = @{(mrna_cds_protein_sequence( $mrna ))[0] || [] };

    <&| /page/info_section.mas,
            title         => $m->interp->apply_escapes( __('cDNA sequence'), 'h' ),
            is_subsection => 1,
            subtitle      => $m->interp->apply_escapes( __('spliced cDNA sequence, including UTRs'), 'h' ),
            empty_message => 'Not available',
            collapsible   => 1,
            collapsed     => 1,
    &>

%  if( $mrna_sequence ) {

     <div style="margin-left: 3em">
       <& /sequence/with_markup.mas,
          seq       => $mrna_sequence,
          width     => 80,
          subdiv    => 10,
          blast_url => $blast_url,
        &>
     </div>
     <div style="margin-top: 1em">
        <& /feature/sequence_download.mas,
             feature => $mrna,
         &>
     </div>
% }

    </&>

    <&| /page/info_section.mas,
            title         => $m->interp->apply_escapes( __('Protein sequence'), 'h' ),
            is_subsection => 1,
            subtitle      => $m->interp->apply_escapes( __('translated polypeptide sequence'), 'h' ),
            empty_message => 'Not available',
            collapsible   => 1,
            collapsed     => 1,
    &>

%  if( $protein_sequence ) {

     <div style="margin-left: 3em">
       <& /sequence/with_markup.mas,
          seq       => $protein_sequence,
          width     => 80,
          subdiv    => 10,
          blast_url => $blast_url,
        &>
     </div>
%    if( $protein_sequence->can('feature_id') ) {
     <div style="margin-top: 1em">
        <& /feature/sequence_download.mas,
             feature => $protein_sequence,
         &>
     </div>
%    }
%  }
    </&>
  </&>
%}
