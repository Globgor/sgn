<%args>
$stock_id
$map_html => undef
</%args>

% print $map_html;

<table class="table table-hover table-bordered" id="stock_direct_genotypes_datatable">
    <thead>
        <tr>
            <th><% __('Genotyping Project Name') |h %></th>
            <th><% __('Genotyping Project Description') |h %></th>
            <th><% __('Protocol Name') |h %></th>
            <th><% __('Genotype Description') |h %></th>
            <th><% __('Download') |h %></th>
        </tr>
    </thead>
</table>

<script>

jQuery(document).ready(function () {

    jQuery('#stock_genotypes_section_onswitch').one("click", function() {
        var stock_genotypes_table = jQuery('#stock_direct_genotypes_datatable').DataTable({
            'destroy' : true,
            'searching' : false,
            'ordering'  : false,
            'processing': true,
            'serverSide': true,
            "scrollX": true,
            'ajax': '/stock/<% $stock_id %>/datatables/genotype_data'
        });
    });

});

</script>
