
<%args>
$stockref => undef
$preferred_species => ""
$editable_vector_props => {}
$editable_stock_props_definitions => {}

</%args>

% my $stock_id = $stockref->{stock_id};

<& /util/import_javascript.mas, classes => [ 'bootstrap_min.js', 'jquery.iframe-post-form','CXGN.List','CXGN.BreedersToolbox.Vector'] &>

<& /page/page_title.mas, title=> $m->interp->apply_escapes( __('Create a New Vector'), 'h' ) &>


<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Vector details"), 'h' )  &>

<& /breeders_toolbox/add_vectors_dialogs.mas, preferred_species=>$preferred_species, editable_vector_props=>$editable_vector_props, editable_stock_props_definitions=>$editable_stock_props_definitions &>

<div class="infosectioncontent">

<p><% __('Add new vector and details.') |h %></p>
<div style="margin-bottom:10px"><button style="float:right" class="btn btn-default" name="add_vectors_link"> <% __('Upload Vectors') |h %></button></div>
<div class="row">
  <div class="col-sm-12">


<div class="container-fluid">
  <div class="well">

  <form class="form-horizontal" id="newVectorForm" action="#" onsubmit="handleSubmit();return false">

    <div class="form-group">
      <label class="col-sm-3 control-label"><& /util/sentence.mas, text => __x('Uniquename {font}*{end_font}'), font => '<font color="red">', end_font => '</font>' &>
      </label>
      <div class="col-sm-6">
        <input type="text" class="form-control" value="" name="uniqueName" id="uniqueName" placeholder="<% __('Required') |h %>"/>
      </div>
      <input class="col-sm-1" type="checkbox" id="uniqueNameAutoCheck" name="uniqueNameAutoCheck" value="uniqueNameAutoCheck" onclick="jqueryAutoUniqueName()">
      <label class="col-sm-2" for="uniqueNameAutoCheck"> <% __('Auto generate uniquename') |h %></label><br>
    </div>
    <div class="form-group">
      <label class="col-sm-3 control-label"><% __('Cloning Organism Host') |h %></label>
      <div class="col-sm-9">
        <input type="text" class="form-control" value="" id="CloningOrganism" name="CloningOrganism">
      </div>
    </div>
    <div class="form-group">
      <label class="col-sm-3 control-label"><% __('Strain') |h %> </label>
      <div class="col-sm-9">
        <input type="text" class="form-control" value="" id="Strain" name="Strain">
      </div>
    </div>
    <div class="form-group">
      <label class="col-sm-3 control-label"><% __('Backbone') |h %> </label>
      <div class="col-sm-9">
        <input type="text" class="form-control" value="" id="Backbone" name="Backbone">
      </div>
    </div>
    <div class="form-group">
      <label class="col-sm-3 control-label"><% __('Inherent Marker') |h %> </label>
      <div class="col-sm-9">
        <input type="text" class="form-control" value="" id="InherentMarker" name="InherentMarker">
      </div>
    </div>
    <div class="form-group">
      <label class="col-sm-3 control-label"><% __('Selection Marker') |h %> </label>
      <div class="col-sm-9">
        <input type="text" class="form-control" value="" id="SelectionMarker" name="SelectionMarker">
      </div>
    </div>
    <div class="form-group">
      <label class="col-sm-3 control-label"><% __('Host Antibiotic Resistant Marker') |h %> </label>
      <div class="col-sm-9">
        <input type="text" class="form-control" value="" id="PlantAntibioticResistantMarker" name="PlantAntibioticResistantMarker">
      </div>
    </div>
    <div class="form-group">
      <label class="col-sm-3 control-label"><% __('Bacterial Resistant Marker') |h %> </label>
      <div class="col-sm-9">
        <input type="text" class="form-control" value="" id="BacterialResistantMarker" name="BacterialResistantMarker">
      </div>
    </div>
    <div class="form-group">
      <label class="col-sm-3 control-label"><% __('Cassette Name') |h %> </label>
      <div class="col-sm-9">
        <input type="text" class="form-control" value="" id="CassetteName" name="CassetteName">
      </div>
    </div>
    <div class="form-group">
      <label class="col-sm-3 control-label"><% __('Gene') |h %> </label>
      <div class="col-sm-9">
        <input type="text" class="form-control" value="" id="Gene" name="Gene">
      </div>
    </div>
    <div class="form-group">
      <label class="col-sm-3 control-label"><% __('Promotors') |h %> </label>
      <div class="col-sm-9">
        <input type="text" class="form-control" value="" id="Promotors" name="Promotors">
      </div>
    </div>
    <div class="form-group">
      <label class="col-sm-3 control-label"><% __('Terminators') |h %> </label>
      <div class="col-sm-9">
        <input type="text" class="form-control" value="" id="Terminators" name="Terminators">
      </div>
    </div>
  <hr>
  <button style="float:right" class="btn btn-primary btn-lg" id="contact_form_submit"><% __('Add new vector') |h %></button>
  <input type="reset" value="<% __('Reset') |h %>" class="btn btn-primary btn-lg" style="float:right;background-color: white; color:black" />
  <br><br>

</form>
</div>

<br>

</div>

<script language="javascript" type="text/javascript">

function handleSubmit() {

  const form = document.getElementById('newVectorForm');
    const dataForm = new FormData(form);

    const value = Object.fromEntries(dataForm.entries());

    const data = {};
    dataForm.forEach((value, key) => (data[key] = value));
    console.log(data);
    jQuery.ajax({
        type: 'POST',
        data: {'data': JSON.stringify([data])},
        url: '/ajax/create_vector_construct',
        beforeSend: function(response){
          jQuery('#working_modal').modal('show');
        },
        success: function(response) {
          jQuery('#working_modal').modal('hide');
          if (response.error) {
            alert(response.error);
          } else {
            jQuery('#uniqueName').val('');
            alert(<% __('Saved!') |js %>);
          }
        },
        error: function(response) {
          alert( <% __('An Error occured while storing vectors.') |js %>);
        }
    });
}

</script>

</&>

<script language="javascript">
    function jqueryAutoUniqueName() {
        jQuery('#uniqueNameAutoCheck').on('change', function () {
            var checked = jQuery(this).prop('checked');
            jQuery('#uniqueName').prop('readonly', checked);
            if(checked){
                jQuery.get('/ajax/get_new_vector_uniquename',
                    function (value) {
                        jQuery("#uniqueName").val(value);
                });
            } else {
                jQuery("#uniqueName").val("");
            }
        });
    }
</script>
