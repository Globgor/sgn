<%args>


</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<& /page/page_title.mas, title=>$m->interp->apply_escapes( __('Accession Usage'), 'h' ) &>

<&| /page/info_section.mas, title => $m->interp->apply_escapes( __('Accession Usage for Trials'), 'h' ), collapsible=>1, collapsed=>1 &>

<table id="accession_usage_trials" width="100%" class="table table-hover table-striped">
<thead>
  <tr>
    <th><% __('Accession Name') |h %></th>
    <th><% __('Number of Trials') |h %></th>
    <th><% __('Total Number of Plots') |h %></th>
  </tr>
</thead>
</table>

</&>

<&| /page/info_section.mas, title => $m->interp->apply_escapes( __('Accession Usage as Female Parent'), 'h' ), collapsible=>1, collapsed=>1 &>

<table id="accession_usage_female" width="100%" class="table table-hover table-striped">
<thead>
  <tr>
    <th><% __('Accession Name') |h %></th>
    <th><% __('Number of Progenies') |h %></th>
  </tr>
</thead>
</table>
<a href="/search/download_parents_and_numbers_of_progenies?parent_type=female_parent" class="btn btn-sm btn-default"><% __('Download') |h %></a>

</&>

<&| /page/info_section.mas, title => $m->interp->apply_escapes( __('Accession Usage as Male Parent'), 'h' ), collapsible=>1, collapsed=>1 &>

<table id="accession_usage_male" width="100%" class="table table-hover table-striped">
<thead>
  <tr>
    <th><% __('Accession Name') |h %></th>
    <th><% __('Number of Progenies') |h %></th>
  </tr>
</thead>
</table>
<a href="/search/download_parents_and_numbers_of_progenies?parent_type=male_parent" class="btn btn-sm btn-default"><% __('Download') |h %></a>

</&>

<&| /page/info_section.mas, title => $m->interp->apply_escapes( __('Accession Phenotype Performance'), 'h' ), collapsible=>1, collapsed=>0 &>

<div class="well">
    <div class="panel panel-default">
        <div class="panel-body">

            <table id="accession_usage_phenotypes" class='table table-bordered table-hover'>
                <thead>
                    <tr>
                        <th><% __('Accession') |h %></th>
                        <th><% __('Observation Variable') |h %></th>
                        <th><% __('Mean') |h %></th>
                        <th><% __('Min') |h %></th>
                        <th><% __('Max') |h %></th>
                        <th><% __('Std Dev') |h %></th>
                        <th>CV</th>
                        <th><% __('Count') |h %></th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

</&>

<script>

jQuery(document).ready(function(){

  jQuery('#accession_usage_trials').DataTable({

     'ordering' : false,
     'ajax':'ajax/accession_usage_trials'
  });


  jQuery('#accession_usage_female').DataTable({

     'ordering' : false,
     'ajax':'ajax/accession_usage_female'
  });


  jQuery('#accession_usage_male').DataTable({

     'ordering' : false,
     'ajax':'ajax/accession_usage_male'
  });

  var stock_table = jQuery('#accession_usage_phenotypes').DataTable({
      'destroy' : true,
      'searching' : false,
      'ordering'  : false,
      'processing': true,
      'serverSide': true,
      'lengthMenu': [10,20,50,100,1000,5000],
      'ajax': { 'url':  '/ajax/accession_usage_phenotypes?display=plots_accession' }
  });

});

</script>
