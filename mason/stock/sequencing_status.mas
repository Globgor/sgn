
<%args>
$stock_id
</%args>

<& /util/import_javascript.mas,
  entries => ["sequenced_accessions"]
&>

<div class="modal fade" id="edit_sequencing_info_dialog" role="dialog">
    <div class="modal-dialog" role="modal">
        <div class="form-search">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><div aria-hidden="true">&times;</div></button>
                    <h5 class="modal-title"><% __('Enter sequencing info for accession:') |h %></h5>
                </div> <!-- modal-header -->
                <form id="sequencing_info_form" class="form-horizontal">
                    <div class="modal-body">
                        <div class="row">
                            <label class="col-sm-3 control-label"><% __('Organization:') |h %> </label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" alt="<% __('Organization') |h %>" placeholder="<% __('Sequencing organization') |h %>" name="organization" id="organization" size="30" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label"><% __('Year:') |h %> </label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="<% __('Sequencing year') |h %>" name="sequencing_year" id="sequencing_year" size="6" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label"><% __('Website:') |h %> </label>
                            <div class="col-sm-9">
                                <div class="input-group">
                                    <span class="input-group-addon" id="https-prefix">https:&sol;&sol;</span>
                                    <input type="text" class="form-control" placeholder="<% __('Website') |h %>" aria-label="https-prefix" aria-describedby="https-prefix" name="website"  id="website" size="10" />
                                </div>
                            </div> <!-- input-group -->
                            <br />
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label"><% __('Contact email:') |h %> </label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="<% __('Contact email') |h %>" name="contact_email"  id="contact_email" size="10" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label"><% __('Genbank accession:') |h %> </label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="<% __('Genbank Accession') |h %>" name="genbank_accession"  id="genbank_accession" size="10" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label"><% __('Funding agency:') |h %> </label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="<% __('Funding organization') |h %>" name="funded_by"  id="funded_by" size="10" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label"><% __('Funding agency project id:') |h %> </label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="<% __('Funding organization project ID') |h %>"  name="funder_project_id" id="funder_project_id" size="10" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label"><% __('JBrowse link:') |h %> </label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="<% __('Jbrowse link') |h %>" name="jbrowse_link" id="jbrowse_link" size="20" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label"><% __('BLAST link') |h %></label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="<% __('BLAST link') |h %>" name="blast_link" id="blast_link" size="20" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label"><% __('FTP link') |h %></label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="<% __('FTP link') |h %>" name="ftp_link" id="ftp_link" size="20" /><br />
                            </div>
                        </div>
                        <div class="row">
                            <label class="col-sm-3 control-label"><% __('NCBI link') |h %></label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" placeholder="<% __('NCBI link') |h %>" name="ncbi_link" id="ncbi_link" size="20" /><br />
                            </div>
                        </div>                        
                        <div>
                            <input type="hidden" id="sequencing_status_stock_id"  name="sequencing_status_stock_id" value="<% $stock_id %>" />
                            <input type="hidden" id="stockprop_id"  name="stockprop_id" />
                        </div>
                    </div> <!-- modal-body -->
                    <div class="modal-footer">
                        <button type="submit"  class="btn btn-primary"><% __('Save changes') |h %></button>
                        <button id="dismiss_sequencing_info_dialog" type="button" class="btn btn-secondary" ><% __('Close') |h %></button>
                    </div> <!-- modal-footer -->
                </form> <!-- sequencing_info form -->
            </div> <!-- modal-content -->
        </div> <!-- form-search -->
    </div> <!-- modal-dialog -->
</div> <!-- modal -->

<table id="sequenced_stocks_table" class="display" style="width:100%">
    <thead>
        <tr>
            <th><% __('Accession') |h %></th>
            <th><% __('Year') |h %></th>
            <th><% __('Organization') |h %></th>
            <th><% __('Website') |h %></th>
            <th><% __('Analyze') |h %></th>
            <th><% __('Manage') |h %></th>
        </tr>
    </thead>
</table>

<div id="sequenced_stocks_div">
</div>

<script>
jQuery(window).ready( function() {
    var sequenced_stocks = window.jsMod['sequenced_accessions'].init("sequenced_stocks_div", <% $stock_id %>);
});
</script>


<br />
