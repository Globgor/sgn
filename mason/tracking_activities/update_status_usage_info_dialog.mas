<%args>

</%args>

<div class="modal fade" id="update_status_usage_info_dialog" name="update_status_usage_info_dialog" tabindex="-1" role="dialog" aria-labelledby="updateStatusUsageInfoDialog">
    <div class="modal-dialog modal-lg " role="document">
        <div class="modal-content">
            <div class="well well-lg">
                <div class="panel panel-default">
                    <div class="panel-body">
                        <div class="modal-header" style="text-align: center">
                            <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                            <h4 class="modal-title" id="updateStatusUsageInfoDialog"><% __('Update Status as Completed/Terminated and Undo Options') |h %></h4>
                        </div>
                        <div class="modal-body">
                            <div class="container-fluid">
                                <p> <% __('Only curators can update status to completed/terminated or undo the update status.') |h %></p>
                                <hr class ="solid">
                                <h4>
                                    <% __('Updating status to completed/terminated vs. Deleting:') |h %>
                                </h4>
                                <p> <% __('Terminating a process/experiment is different from deleting a process/experiment.') |h %>
                                <li><% __('Deleting a process/experiment removes its identifier from the database. Marking a process/experiment as completed/terminated inactivates that process/experiment, but its related information is still kept in the database.') |h %></li>
                                <li><% __('You can delete a process/experiment only if there is no associated data') |h %></li>
                                <li><% __('You can still access the details page but the page is marked as "COMPLETED" or "TERMINATED". You can no longer add additional info to that page.') |h %></li>
                                <hr class ="solid">
                                <h4>
                                    <% __('Undo updating status:') |h %>
                                </h4>
                                <p><% __('Completed or Terminated status can be reversed by using UNDO option. Deleting a process/experiment cannot be undone') |h %></p>
                            </div>
                            <div class="modal-footer">
                                <button id="close_update_status_usage_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<style>

hr.solid { border-top: 3px solid #bbb; }

</style>

<script>

jQuery(document).ready(function(){

    jQuery("[name='update_status_usage_link']").click(function() {
        jQuery('#update_status_usage_info_dialog').modal("show");
    });

});

</script>
