<%args>
</%args>

<div id="brapi_home_study_detail_div">

    <h4><% __('Study Details') |h %></h4>
    <input name="brapi_home_studydbid" id="brapi_home_studydbid" class="form-control" type="text" placeholder="<% __('StudyDbId e.g. 137') |h %>" value="137"/>
    <button class="btn btn-primary" name="brapi_home_studydbid_submit" id="brapi_home_studydbid_submit"><% __('Get Details') |h %></button>
    <br/><br/>
    <div id="brapi_studies_detail_result_div">
    </div>

</div>

<script>

jQuery(document).ready(function() {
    jQuery("#brapi_home_studydbid_submit").click(function() {
        jQuery.ajax( {
          'url': jQuery('#brapi_home_url_select').val()+'/brapi/v1/studies/'+jQuery('#brapi_home_studydbid').val(),
          'method': 'GET',
          'success': function(response) {
            console.log(response);
            brapi_create_table(response.result, 'brapi_studies_detail_result_div', undefined);

          },
          error: function(response) {
            alert(<% __('An error occurred') |js %>);
          }
        });
    });
});

</script>