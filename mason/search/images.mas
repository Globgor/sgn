
<%args>
</%args>

<style>
#images_search_results {
    width: 100% !important;
}
</style>

<& /util/import_javascript.mas, classes => [ 'jquery', 'thickbox', 'jquery.dataTables' ] &>

<& /page/page_title.mas, title => $m->interp->apply_escapes( __("Image Search"), 'h' ) &>

<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Image Search Criteria"), 'h' ),  collapsible => 1, collapsed=>0, subtitle => $m->interp->apply_escapes( __("All images may not have names, descriptions, or tags associated with them."), 'h' )&>

    <div id="image_search_form" class="well well-sm">
        <div class="form-horizontal" >
            <div class="form-group">
                <label class="col-sm-6 control-label"><% __('Image descriptors (name, description, or filename):') |h %> </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_description_filename_composite" name="image_description_filename_composite" placeholder="<% __('e.g. MyImageName') |h %>" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label"><% __('Submitter:') |h %> </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_submitter" name="image_submitter" placeholder="e.g. JaneDoe" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label"><% __('Image tag:') |h %> </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_tag" name="image_tag" placeholder="<% __('e.g. ImageTagName') |h %>" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label"><% __('Associated stock:') |h %> </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_stock_uniquename" name="image_stock_uniquename" placeholder="<% __('e.g. FieldPlot100') |h %>" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label"><% __('Related stock:') |h %> </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_related_stock" name="image_related_stock" placeholder="<% __('e.g. Accession/Plot/TissueSample') |h %>" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label"><% __('Associated project:') |h %> </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_project_name" name="image_project_name" placeholder="<% __('e.g. DroneProject 01/01/2019') |h %>" />
                </div>
            </div>
        </div>

        <center>
        <button class="btn btn-primary" id="image_search_submit" ><% __('Search') |h %></button>
        </center>
    </div>
</&>

<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Image Search Results"), 'h' ),  collapsible => 1, collapsed=>0 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table id="images_search_results" class="table table-hover table-striped">
                <thead>
                  <tr>
                    <th><% __('Image Thumbnail') |h %></th>
                    <th><% __('Filename') |h %></th>
                    <th><% __('Description') |h %></th>
                    <th><% __('Submitter') |h %></th>
                    <th><% __('Associations') |h %></th>
                    <th><% __('Related Accession') |h %></th>
                    <th><% __('Tags') |h %></th>
                </tr>
                </thead>
                </table>
            </div>
        </div>
    </div>
</&>

<script>

var images_table;

jQuery(document).ready(function () {

    _load_image_search_results();

    jQuery("#image_submitter").autocomplete({
        source: '/ajax/people/autocomplete'
    });

    jQuery("#image_stock_uniquename").autocomplete({
        source: '/ajax/stock/stock_autocomplete'
    });

    jQuery("#image_related_stock").autocomplete({
        source: '/ajax/stock/stock_autocomplete'
    });

    jQuery("#image_project_name").autocomplete({
        source: '/ajax/trials/trial_autocomplete'
    });

    jQuery('#image_search_submit').click( function() {
        _load_image_search_results();
    });

    jQuery('#image_search_form').keypress( function( e ) {
        var code = e.keyCode || e.which;
        if( code == 13 ) {
            jQuery('#image_search_submit').click();
        }
    });

    jQuery('#images_search_results').on( 'draw.dt', function () {
        jQuery('a.image_search_group').colorbox({photo: true, onComplete: function () {
            var titleWidth = jQuery('#cboxTitle').outerWidth(true);
            var paddedWidth = titleWidth + 500;
            jQuery.colorbox.resize({width: paddedWidth + 'px'});
        }});
    });

});

function _load_image_search_results() {
    images_table = jQuery('#images_search_results').DataTable({
        'destroy' : true,
        'searching' : false,
        'ordering'  : false,
        'processing': true,
        'serverSide': true,
        'scrollX': true,
        'lengthMenu': [10,20,50,100,1000,5000],
        'ajax': { 'url':  '/ajax/search/images',
            'type': 'POST',
            'data': function(d) {
              d.image_description_filename_composite = jQuery('#image_description_filename_composite').val();
              d.image_person = jQuery('#image_submitter').val();
              d.image_tag = jQuery('#image_tag').val();
              d.image_stock_uniquename = jQuery('#image_stock_uniquename').val();
              d.image_related_stock = jQuery('#image_related_stock').val();
              d.image_project_name = jQuery('#image_project_name').val();
            }
        }
    });
}

</script>
