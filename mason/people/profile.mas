
<%args>
$is_users_profile => undef
$user_roles => undef
$site_name
$sp_person_id
$username
$first_name
$last_name
$populations_list => undef
$loci_editor_privileges => undef
$loci_annotations => undef
$user_status => undef
$allow_trait_edits => 0
$allow_treatment_edits => 0
</%args>


<& /page/page_title.mas, title=>"$site_name" &>

<div class="container-fluid">

    <div align="center"><b><% $first_name %> <% $last_name %></b></div>
    <br/>


% if ($is_users_profile) {

    <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('General Tools'), 'h' ), collapsible=>0, collapsed=>0 &>
        <div class="well">
            <a href="/solpeople/personal-info.pl?action=edit&sp_person_id=<% $sp_person_id %>"><% __('View or update personal (contact and research) information') |h %></a><br />
            <a href="/user/update"><% __('Update account information') |h %></a><br />
            <a href="/forum/topics.pl"><% __('Post to SGN forum') |h %></a><br />
	    <a href="/about/audit"><% __('View audit tables') |h %></a><br />
        </div>
    </&>

%   if (exists($user_roles->{'curator'}) || exists($user_roles->{'sequencer'}) ) {

    <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Sequencer Tools'), 'h' ), collapsible=>0, collapsed=>0, subtitle=>$m->interp->apply_escapes( __('For Curators and Sequencers'), 'h' ) &>
        <div class="well">
            <a href="/solpeople/attribute_bacs.pl"><% __('Attribute a BAC to your chromosome sequencing project') |h %></a><br />
            <a href="/maps/physical/clone_il_view.pl"><% __('View/update BAC IL mapping information (list view)') |h %></a><br />
            <a href="/maps/physical/clone_reg.pl"><% __('View/update all BAC registry info (list view)') |h %></a></br>
            <a href="/sequencing/tpf.pl"><% __('View TPF Files') |h %></a><br />
            <a href="/sequencing/agp.pl"><% __('View AGP Files') |h %></a><br />
        </div>

%       if (exists($user_roles->{'curator'})) {

            <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('AGP and TPF File Upload'), 'h' ), collapsible=>1, collapsed=>1, subtitle=>$m->interp->apply_escapes( __('For Curators'), 'h' ) &>

                <div class="well">
                    <div style="margin-top: 1em">
                        <center><h4><% __('Upload Accessioned Golden Path (AGP) File') |h %></h4></center>
                        <hr>

                        <form class="form-horizontal" action="/sequencing/agp.pl" method="post" enctype="multipart/form-data">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-6 control-label"><% __('For Chromosome #:') |h %> </label>
                                        <div class="col-sm-6">
                                            <input class="form-control" id="chrnuminput_agp" name="chr" type="text" size="2" maxlength="2" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-2 control-label"><% __('File:') |h %> </label>
                                        <div class="col-sm-10">
                                            <input type="hidden" name="filetype" value="agp" />
                                            <input id="agpinput" type="file" name="agp_file" value="Upload AGP file" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>

                        <center><h4><% __('Upload Tiling Path Format (TPF) File') |h %></h4></center>
                        <hr>

                        <form class="form-horizontal" action="/sequencing/tpf.pl" method="post" enctype="multipart/form-data">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-6 control-label"><% __('For Chromosome #:') |h %> </label>
                                        <div class="col-sm-6">
                                            <input class="form-control" id="chrnuminput_tpf" name="chr" type="text" size="2" maxlength="2" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group form-group-sm">
                                        <label class="col-sm-2 control-label"><% __('File:') |h %> </label>
                                        <div class="col-sm-10">
                                            <input type="hidden" name="filetype" value="tpf" />
                                            <input id="tpfinput" type="file" name="tpfinput" value="Upload TPF file" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>

                    </div>

                </div>
            </&>

%       }

    </&>
%   }

%   if (exists($user_roles->{'curator'}) || exists($user_roles->{'sequencer'}) || exists($user_roles->{'submitter'})) {

    <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('QTL Data Submission'), 'h' ), collapsible=>0, collapsed=>0, subtitle=>$m->interp->apply_escapes( __('For Submitters and up'), 'h' ) &>
        <div class="well">
            <a href="/phenome/qtl_form.pl"><% __('Upload and analyse your QTL data') |h %></a><br/>
        </div>
    </&>

    <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Populations'), 'h' ), collapsible=>0, collapsed=>0, subtitle=>$m->interp->apply_escapes( __('For Submitters and up'), 'h' ) &>
        <div class="well">
            <% $populations_list %>
        </div>
    </&>

    <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Job Submissions'), 'h' ), collapsible=>0, collapsed=>0, subtitle=>$m->interp->apply_escapes( __('For Submitters and up'), 'h' ) &>
        <div class="well">
            <& /jobs/log.mas, sp_person_id => $sp_person_id &>
        </div>
    </&>

%   }

%   if (exists($user_roles->{'curator'}) ) {

    <div class="row">
        <div class="col-sm-6">
            <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Curator Tools'), 'h' ), collapsible=>0, collapsed=>0, subtitle=>$m->interp->apply_escapes( __('For Curators'), 'h' ) &>
                <div class="well">
                    <a href="/solpeople/admin/crash_test.pl"><% __('Test website error handling') |h %></a><br />
                    <a href="/solpeople/admin/stats.pl"><% __('View user stats') |h %></a><br />
                    <a href="/user/admin/quick_create_account"><% __('Create new user account') |h %></a><br />
                    <a href="/solpeople/admin/create_organization.pl"><% __('Create new organization') |h %></a><br>
%       if ($allow_trait_edits) {
                    <a href="/traits/design"><% __('Design new traits') |h %></a><br>
%       }
%       if ($allow_treatment_edits) {
                    <a href="/treatments/design"><% __('Design new treatments') |h %></a>
%       }
                </div>
            </&>
        </div>
        <div class="col-sm-6">
            <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Literature Mining'), 'h' ), collapsible=>0, collapsed=>0, subtitle=>$m->interp->apply_escapes( __('For Curators'), 'h' ) &>
                <div class="well">
                    <a href= "/search/pub_search.pl"><% __('Search the SGN publication database') |h %> </a><br />
                    <a href= "/search/pub_search.pl?w9b3_assigned_to=<% $sp_person_id %>"><% __('See your assigned publications') |h %></a><br />
                    <a href= "/search/pub_search.pl?w9b3_status=pending"><% __('See publications pending curation') |h %></a><br />
                    <a href= "/chado/fetch_pubmed.pl"><% __('Load new publications from PubMed') |h %></a><br />
                </div>
            </&>
        </div>
    </div>

%   }

%   if (exists($user_roles->{'curator'}) || exists($user_roles->{'sequencer'}) || exists($user_roles->{'submitter'})) {

    <div class="row">
        <div class="col-sm-6">
            <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Loci Editor'), 'h' ), collapsible=>0, collapsed=>0, subtitle=>$m->interp->apply_escapes( __('For Submitters and up'), 'h' ) &>
                <div class="well">
                    <% $loci_editor_privileges %>
                </div>
            </&>
        </div>
        <div class="col-sm-6">
            <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Annotated Loci'), 'h' ), collapsible=>0, collapsed=>0, subtitle=>$m->interp->apply_escapes( __('For Submitters and up'), 'h' ) &>
                <div class="well">
                    <% $loci_annotations %>
                </div>
            </&>
        </div>
    </div>
%   }

<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('User Status'), 'h' ), collapsible=>0, collapsed=>0 &>
    <div class="well">
        <% $user_status %>
    </div>
</&>

% }

</div>
