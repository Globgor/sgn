<%args>
  $organism
</%args>
<& /page/page_title.mas, title => '<i>'.$organism->species.'</i> Genome Data' &>

<&| /page/info_section.mas,
      title       => $m->interp->apply_escapes( __('Sequence datasets'), 'h' ),
      collapsible => 1,
 &>
  <& /genomes/default/genome_builds.mas, %ARGS &>
</&>


<&| /page/info_section.mas,
      title       => $m->interp->apply_escapes( __('Browsable annotations'), 'h' ),
      collapsible => 1,
      hide_if_empty => 1,
 &>

  <& /gbrowse/list_sources.mas, organism => $organism &>

</&>

<&| /page/info_section.mas,
      title       => $m->interp->apply_escapes( __('Annotation datasets'), 'h' ),
      collapsible => 1,
      hide_if_empty => 1,
 &>

  <& /genomes/default/annotation_sets.mas, %ARGS &>

</&>
