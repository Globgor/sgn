<%args>
  $organism
</%args>
<& /page/page_title.mas, title => '<i>'.$organism->species.'</i> Genome Data' &>

<div class="page_introduction">

   <& /util/sentence.mas, text => __x('The potato genome has been sequenced by the {link}Potato Genome Sequence Consortium{end_link} (PGSC), an international group of scientists from 14 countries.'), link => '<a
   href="http://potatogenome.net">', end_link => '</a>' &> <& /util/sentence.mas, text => __x('The sequence was published in {link}{publication}{end_link} in July 2011.'), link => '<a
   href="http://www.ncbi.nlm.nih.gov/pubmed/21743474">', publication => 'Nature', end_link => '</a>' &> <& /util/sentence.mas, text => __x('Many potato lines are tetraploid; however, the sequenced accession was a homozygous diploid line (double haploid) {i}{species}{end_i}.'), i => '<i>', species => 'Solanum    tuberosum phureja', end_i => '</i>' &> <& /util/sentence.mas, text => __x('Below is a mirror of the files provided on {link}{address}{end_link}.'), link => '<a href="http://potatogenome.net">', address => 'http://potatogenome.net', end_link => '</a>' &>

</div>

<&| /page/info_section.mas,
      title       => $m->interp->apply_escapes( __('Sequence datasets'), 'h' ),
      collapsible => 1,
 &>
  <& /genomes/default/genome_builds.mas, %ARGS &>
</&>


<&| /page/info_section.mas,
      title       => $m->interp->apply_escapes( __('Browsable annotations'), 'h' ),
      collapsible => 1,
      hide_if_empty => 1,
 &>

  <& /gbrowse/list_sources.mas, organism => $organism &>

</&>

<&| /page/info_section.mas,
      title       => $m->interp->apply_escapes( __('Annotation datasets'), 'h' ),
      collapsible => 1,
      hide_if_empty => 1,
 &>

  <& /genomes/default/annotation_sets.mas, %ARGS &>

</&>
