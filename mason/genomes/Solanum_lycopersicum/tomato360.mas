<& /page/page_title.mas, title=>$m->interp->apply_escapes( __("AGIS Tomato 360 Resequencing Project"), 'h' ) &>

<div class="page_introduction">
  <% __('Genomic analysis of 360 tomato accessions by the Agricultural Genomic Institute at Shenzhen.') |h %>
</div>


<&| /page/info_section.mas, title => $m->interp->apply_escapes( __('360 Tomato Genomes'), 'h' ) &>
  Genomic analyses provide insights into the history of tomato breeding <a href="http://www.nature.com/ng/journal/v46/n11/full/ng.3117.html">Lin et al. Nature Genetics, 2014</a><br />

  <& /util/sentence.mas, text => __x('See more info about the project on the {link}BTI web site{end_link}'), link => '<a href="http://bti.cornell.edu/news/new-genomics-study-mines-360-tomato-varieties-to-trace-history-find-room-for-improvement/">', end_link => '</a>' &>

<br />

  <% info_table_html(
                     __border   => 0,
                     __multicol => 2,
                     'Bulk Datasets (via FTP)' =>
                     '<a href="ftp://ftp.solgenomics.net/genomes/tomato_360/">VCF files</a>',
		     'Genome browser' => '<a href="/jbrowse_solgenomics/?data=data/json/tomato_variants_2.5">JBrowse</a>'
                    )
  %>
</&>




