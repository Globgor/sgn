
<%args>
</%args>

<%doc>

=head1 NAME

/mason/analyses/index.mas - show user-specific analyses in the system

=head1 DESCRIPTION

Displays a page with a table of all the analyses run by the currently logged in user.

=head1 AUTHOR

Lukas Mueller <lam87@cornell.edu>

=cut

</%doc>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ], entries => ['analyses' ] &>

<& /page/page_title.mas, title => $m->interp->apply_escapes( __("Your Analyses and Analysis Models"), 'h' ) &>

<button class='btn btn-primary' style='margin:3px;float:right' id='drone_imagery_calculate_statistics_link'><% __('Drone Imagery Statistics') |h %></button><button class='btn btn-primary' style='margin:3px;float:right' id='analysis_calculate_statistics_link'><% __('Single/Multi Trial GEBV Analysis') |h %></button><button class="btn btn-default" name="upload_new_analysis_button" style="margin:3px;float:right"><% __('Upload Analysis') |h %></button><br />
<hr>

<& /analyses/analysis_calculate_statistics.mas &>
<& /analyses/upload_analysis_dialogs.mas &>
<& /breeders_toolbox/drone_imagery/drone_imagery_analysis.mas &>
<& /analyses/store_new_analysis_values_and_model.mas &>

<div class="well">
<h3><% __('Your Analyses') |h %></h3>
<table class="table table-bordered table-hover" id="analyses_by_user_table">
  <thead>
  <tr>
    <th>
      <% __('Analysis Name') |h %>
    </th>
    <th>
      <% __('Description') |h %>
    </th>
    <th>
      <% __('Model Type') |h %>
    </th>
    <th>
      <% __('Protocol') |h %>
    </th>
    <th>
      <% __('Application') |h %>
    </th>
    <th>
      <% __('Language') |h %>
    </th>
  </tr>
  </thead>
  <tbody>
  </tbody>
</table>
</div>

<div class="well">
<h3><% __('Your Models') |h %></h3>
<table class="table table-bordered table-hover" id="models_by_user_table">
  <thead>
  <tr>
    <th>
      <% __('Model Name') |h %>
    </th>
    <th>
      <% __('Description') |h %>
    </th>
    <th>
      <% __('Model Type') |h %>
    </th>
    <th>
      <% __('Protocol') |h %>
    </th>
    <th>
      <% __('Application') |h %>
    </th>
    <th>
      <% __('Language') |h %>
    </th>
  </tr>
  </thead>
  <tbody>
  </tbody>
</table>
</div>

<script>
jQuery(document).ready(function(){
    jQuery('#analyses_by_user_table').DataTable({
        'ajax': { 'url': '/ajax/analyses/by_user' }
    });

    jQuery('#models_by_user_table').DataTable({
        'ajax': { 'url': '/ajax/analyses/models/by_user' }
    });
});
</script>