
<& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Data Download Options"), 'h' ) &>

<div>
<p><& /util/sentence.mas, text => __x('SGN provides various data files for download via anonymous FTP and anonymous rsync.') &>
<!-- FIXME: a list of kinds of things to available to download should
     go here.
<ul>
<li></li>
</ul>
-->
</p>

<p>
<& /util/sentence.mas, text => __x('For manually downloading a few files once in a while, anonymous FTP is particularly convenient.') &>  <& /util/sentence.mas, text => __x('From a web browser, SGN\'s ftp site can be reached at {link}{address}{end_link}.'), link => '<a
href="ftp://ftp.sgn.cornell.edu/">', address => 'ftp://ftp.sgn.cornell.edu/', end_link => '</a>' &>
<& /util/sentence.mas, text => __x('From other FTP clients, when prompted for a username enter {em}{username}{end_em} and when prompted for password enter your email address.'), em => '<em>', username => 'anonymous', end_em => '</em>' &>
</p>

<p> <& /util/sentence.mas, text => __x('For keeping a set of files up to date with the files we make available, {link}rsync{end_link} is a useful tool.'), link => '<a href="http://samba.anu.edu.au/rsync/">', end_link => '</a>' &>  <& /util/sentence.mas, text => __x('To retrieve files from our anonymous rsync server, use the URL {em}{address}{end_em}.'), em => '<em>', address => 'rsync://rsync.sgn.cornell.edu/public/', end_em => '</em>' &>  <& /util/sentence.mas, text => __x('For example, to retrieve all our map and marker data on a Unix/Linux shell use the command:') &></p>
<pre>\$ rsync -az rsync://rsync.sgn.cornell.edu/public/maps_and_markers/ .</pre>
</div>
