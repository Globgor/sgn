<%args>
$basepath
$documents_subdir
</%args>

<& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Publications"), 'h' ) &>

<%perl>

use File::Slurp qw | slurp |;

my $documents_folder = $basepath . $documents_subdir;

my $PUBLICATIONS=slurp("$documents_folder/SGNpublications.txt")||'';

print $PUBLICATIONS;

</%perl>
