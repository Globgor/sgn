              "http://ted.bti.cornell.edu/">', end_link2 => '</a>' &></dd>

              <dt><br /><strong>Potato</strong></dt>

              <dd><& /util/sentence.mas, text => __x('{link}Purchase potato clones{end_link} from {link2}Arizona Genome Initiative{end_link2}.'), link => '<a href=
              "http://www.genome.arizona.edu/orders/">', end_link => '</a>', link2 => '<a href=
              "http://www.genome.arizona.edu/">', end_link2 => '</a>' &></dd>

              <dt><br /><strong>Pepper</strong></dt>

              <dd>For pepper clones, contact <a href=
