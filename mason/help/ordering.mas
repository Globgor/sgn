     <tr>
        <td>
          <h4><% __('Ordering Clones') |h %></h4>

          <div class="boxcontent">
            <dl>
              <dt><strong>Tomato</strong></dt>

              <dd><& /util/sentence.mas, text => __x('{link}Purchase tomato EST or BAC clones{end_link} from {link2}TED BTI{end_link2} at Cornell University.'), link => '<a href=
