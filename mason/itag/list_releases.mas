<%args>
$itag_releases
</%args>

<& /page/page_title.mas, title => $m->interp->apply_escapes( __('ITAG Releases Available for Bulk Download'), 'h' ) &>

% if ( @$itag_releases ) {

<ul>
%   for my $rel ( @$itag_releases ) {

  <li><a href="/itag/release/<% $rel->release_number %>/list_files"><% $rel->release_name %></a></li>

%   }
</ul>

% } else {

<span class="ghosted"><% __('temporarily unavailable') |h %></span>

% }
