<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jqueryui', 'jquery.iframe-post-form', 'CXGN.BreedersToolbox.UploadPhenotype', 'CXGN.BreederSearch' ] &>

<div class="modal fade" id="upload_fieldbook_phenotypes_dialog" name="upload_fieldbook_phenotypes_dialog" tabindex="-1" role="dialog" aria-labelledby="addFieldbookPhenotypeDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="addFieldbookPhenotypeDialog"><% __('Upload Fieldbook File') |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_fieldbook_phenotype_file_form" name="upload_fieldbook_phenotype_file_form">
                <div class="well well-sm">
                    <h5><% __('Upload Exported Fieldbook Phenotype File in Database Format for Plots or Plants') |h %></h5>
                </div>
            <&| /page/explanation.mas, title=>$m->interp->apply_escapes( __('Template Information'), 'h' ) &>
                <p>
                <b><% __('File format information') |h %></b>
                <br>
                <a id="phenotype_fieldbook_upload_info"><% __('Spreadsheet Format') |h %></a>
                </p>
            </&>
                <div class="form-group">
                    <label class="col-sm-6 control-label"><% __('Data Level:') |h %> </label>
                    <div class="col-sm-6" >
                        <select class="form-control" id="upload_fieldbook_phenotype_data_level" name="upload_fieldbook_phenotype_data_level">
                            <option value="plots"><% __('Plots') |h %></option>
                            <option value="plants"><% __('Plants') |h %></option>
                            <option value="subplots"><% __('Subplots') |h %></option>
                            <option value="tissue_samples"><% __('Tissue Samples') |h %></option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-6 control-label"><% __('Fieldbook File:') |h %> </label>
                    <div class="col-sm-6" >
                        <input type="file" id="upload_fieldbook_phenotype_file_input" name="upload_fieldbook_phenotype_file_input" encoding="multipart/form-data" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-6 control-label"><% __('Optional: Images ZipFile (.zip):') |h %> </label>
                    <div class="col-sm-6" >
                        <input type="file" id="upload_fieldbook_phenotype_images_zipfile" name="upload_fieldbook_phenotype_images_zipfile" encoding="multipart/form-data" />
                    </div>
                </div>

                <div id="upload_phenotype_fieldbook_verify_status"></div>
            </form><br/>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
        <button type="button" class="btn btn-info" name="upload_fieldbook_phenotype_submit_verify" id="upload_fieldbook_phenotype_submit_verify"><% __('Verify') |h %></button>
	<button disabled type="button" class="btn btn-primary" name="upload_fieldbook_phenotype_submit_store" id="upload_fieldbook_phenotype_submit_store" title="<% __('First Verify Your File') |h %>"><% __('Store') |h %></button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="upload_fieldbook_file_info_dialog" name="upload_fieldbook_file_info_dialog" tabindex="-1" role="dialog" aria-labelledby="transcriptomicsUploadInfoDialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="transcriptomicsUploadInfoDialog"><% __('Template Information') |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

            <h3><% __('Fieldbook files can be uploaded in .xlsx or .csv format') |h %></h3>
            <h4><% __('When exporting a Phenotype File from Fieldbook, the file should already be in this format. Please check to make sure your file was exported correctly') |h %></h4>

            <ul>

                <li><strong>plot_id</strong> or <strong>plant_id</strong> or <strong>subplot_id</strong> or <strong>tissue_sample_id</strong>: This should be one of these stock IDs that already exist in the database.</li>
                <li><strong>trait</strong>: A trait that exists in the database.</li>
                <li><strong>value</strong>: Corresponding value for the observed trait.</li>
                <li><strong>observationTimeStamp</strong>: Timestamp of the observation.</li>
                <li><strong>collector</strong>: Observation collector's name.</li>
            </ul>
            <table class="table table-hover table-bordered table-condensed" >
                <thead></thead>
                <tbody>
                    <tr>
                        <td>plot_id</td>
                        <td>trait</td>
                        <td>value</td>
                        <td>observationTimeStamp</td>
                        <td>collector</td>
                    </tr>
                </tbody>
            </table>

        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
      </div>
    </div>
  </div>
</div>

<script defer="defer">

jQuery(document).ready(function() {

    jQuery('#upload_fieldbook_phenotypes_link').click( function() {
	jQuery('#upload_fieldbook_phenotypes_dialog').modal("show");
    });

    jQuery('#phenotype_fieldbook_upload_info').click( function() {
        jQuery('#upload_fieldbook_file_info_dialog').modal("show");
    });

});

</script>
