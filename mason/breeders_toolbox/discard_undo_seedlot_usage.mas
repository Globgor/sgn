<%args>

</%args>


<div class="modal fade" id="discard_seedlot_usage_info_dialog" name="discard_seedlot_usage_info_dialog" tabindex="-1" role="dialog" aria-labelledby="discardSeedlotUsageInfoDialog">
    <div class="modal-dialog modal-lg " role="document">
        <div class="modal-content">
            <div class="well well-lg">
                <div class="panel panel-default">
                    <div class="panel-body">
                        <div class="modal-header" style="text-align: center">
                            <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                            <h4 class="modal-title" id="discardUsageInfoDialog"><% __('Marking Seedlots as DISCARDED and Undo Options') |h %></h4>
                        </div>
                        <div class="modal-body">
                            <div class="container-fluid">
                                <p> <% __('Only users with curator role can mark seedlots as "DISCARDED" or undo discarding seedlots.') |h %></p>
                                <hr class ="solid">
                                <h4>
                                    <% __('Discarding vs. Deleting Seedlots:') |h %>
                                </h4>
                                <p> <% __('Discarding a seedlot is different from deleting a seedlot.') |h %>
                                <li><% __('Deleting a seedlot permanently removes that seedlot and all associated transactions from database. Discarding a seedlot inactivates the seedlot, but information related to that seedlot is still kept in the database.') |h %></li>
                                <li><% __('Amount/Weight of discarded seedlot is labeled as "DISCARDED".') |h %></li>
                                <li><% __('Discarding a seedlot can be reversed with UNDO function, but deletion a seedlot cannot be undone.') |h %></li>
                                <li><% __('Discarded seedlots still can be viewed in seedlot details pages and are searchable. However, links for adding new transaction, editing details and transaction are removed.') |h %></li>
                                <li><% __('Discarded seedlots are excluded from dropdown list for adding new transactions.') |h %></li>
                                <hr class ="solid">
                                <h4>
                                    <% __('How to Mark Seedlot as DISCARDED:') |h %>
                                </h4>
                                <li><% __('Using a List: Several seedlots can be discarded at once by using a list with seedlots list type. The link can be found at the buttom of Manage Seedlots (Available Seedlots) page.') |h %></li>
                                <li><% __('Discarding single seedlot: The link can be found at the buttom of Seedlot Details page.') |h %></li>
                                <hr class ="solid">
                                <h4>
                                    <% __('UNDO Discarding seedlots:') |h %>
                                </h4>
                                <p><% __('Discarded seedlot can be reversed by using UNDO option at the buttom of Seedlot Details page') |h %> </p>
                            </div>
                            <div class="modal-footer">
                                <button id="close_discarded_seedlot_usage_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<style>

hr.solid { border-top: 3px solid #bbb; }

</style>

<script>

jQuery(document).ready(function(){

    jQuery("[name='discard_seedlot_usage_info']").click(function() {
        jQuery('#discard_seedlot_usage_info_dialog').modal("show");
    });

});

</script>
