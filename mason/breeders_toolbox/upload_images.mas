
<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jqueryui', 'jquery.iframe-post-form', 'CXGN.BreedersToolbox.UploadImages', 'CXGN.BreederSearch', 'CXGN.Trial', 'brapi.BrAPI' ] &>

<div class="modal fade" id="upload_images_dialog" name="upload_images_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadImagesDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="uploadImagesDialog"><% __('Upload Images') |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

            <&| /page/explanation.mas, title=>$m->interp->apply_escapes( __('Template Information'), 'h' ) &>
                <p>
                <b><% __('File format information') |h %></b>
                <br>
                <a id="upload_images_format_info"><% __('Image File Format') |h %></a>
                </p>
            </&>

            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_images_file_form" name="upload_images_file_form">
                <div class="form-group">
                    <label class="col-sm-3 control-label"><% __('File Format:') |h %> </label>
                    <div class="col-sm-9" >
                        <select class="form-control" id="upload_images_file_format" name="upload_images_file_format">
                            <option value="images"><% __('Images') |h %></option>
                            <option value="images_with_barcodes"><% __('Images with Barcodes') |h %></option>
                            <option value="images_with_associated_phenotypes"><% __('Images with Associated Phenotypes') |h %></option>
                        </select>
                    </div>
                </div>
                <div id="upload_images_with_associated_phenotypes_div" style="display:none">
                    <div class="form-group">
                        <label class="col-sm-3 control-label"><% __('Phenotype Spreadsheet:') |h %> </label>
                        <div class="col-sm-9" >
                            <input type="file" id="upload_associated_phenotypes_file_input" name="upload_images_file_input" encoding="multipart/form-data" accept=".xls, .xlsx"/>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label"><% __('Images (.zip):') |h %> </label>
                        <div class="col-sm-9" >
                            <input type="file" id="upload_images_zip_file_input" name="upload_images_zip_file_input" encoding="multipart/form-data" accept=".zip"/>
                        </div>
                    </div>
                </div>
                <div id="upload_images_div">
                    <div class="form-group">
                        <label class="col-sm-3 control-label"><% __('Image Files:') |h %> </label>
                        <div class="col-sm-9" >
                            <input type="file" id="upload_images_file_input" name="upload_images_file_input" multiple="multiple" accept="image/*">
                        </div>
                    </div>
                    <br>
                    <div id="preview" class="form-group justify-content-sm-center"></div>
                </div>
                <div id="upload_images_collection_div">
                    <div class="form-group">
                        <label class="col-sm-3 control-label"><% __('Add to Collection:') |h %> </label>
                        <div class="col-sm-9" >
                            <select class="form-control" id="upload_images_collection_mode">
                                <option value="none"><% __('Do not add to a collection') |h %></option>
                                <option value="existing"><% __('Add to an existing collection') |h %></option>
                                <option value="new"><% __('Create a new collection') |h %></option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group" id="upload_images_collection_existing_div" style="display:none">
                        <label class="col-sm-3 control-label"><% __('Collection:') |h %> </label>
                        <div class="col-sm-9" >
                            <select class="form-control" id="upload_images_collection_id"></select>
                        </div>
                    </div>
                    <div id="upload_images_collection_new_div" style="display:none">
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% __('Collection Name:') |h %> </label>
                            <div class="col-sm-9" >
                                <input class="form-control" style="width:100%;" type="text" id="upload_images_collection_name" placeholder="<% __('e.g. Field Photos 2026') |h %>" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% __('Description:') |h %> </label>
                            <div class="col-sm-9" >
                                <input class="form-control" style="width:100%;" type="text" id="upload_images_collection_description" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-group" id="upload_images_status"></div>

                </div>
            </form><br/>

        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
            <button type="button" class="btn btn-info" name="upload_images_submit_verify" id="upload_images_submit_verify"><% __('Verify') |h %></button>
            <button disabled type="button" class="btn btn-primary" name="upload_images_submit_store" id="upload_images_submit_store" title="<% __('First Verify Your File') |h %>"><% __('Store') |h %></button>
        </div>

    </div>
  </div>
</div>

<div class="modal fade" id="upload_images_info_dialog" name="upload_images_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadImagesInfoDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="uploadImagesInfoDialog"><% __('Template Information') |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

            <h4><% __('Images Alone:') |h %></h4>
            <ul>
                <li><% __('Select multiple images directly for upload.') |h %></li>
                <li>If the images being uploaded were taken using Fieldbook, they have EXIF data that contains the observationUnitName, traitname, and timestamp. They can be uploaded without needing to change the file name.</li>
                <li>If images were NOT taken using Fieldbook, image file names should consist of the observationUnitName, traitname, number, and timestamp, all joined by underscores (the default naming system used by Fieldbook App).</li>
            </ul>
            <br/>
            <h4><% __('Images with Barcodes:') |h %></h4>
            <ul>
                <li><% __('Upload multiple selected images that contain a barcode with a stock ID.') |h %></li>
                <li><% __('There should only be one barcode in each image, and the associated stock must already exist in the database.') |h %></li>
            </ul>
            <br/>
            <h4><% __('Images with Associated Phenotypes:') |h %></h4>
            <ul>
                <li><% __('The "Associated Images" format is useful for uploading a zipfile of images in association with phenotype values.') |h %></li>
                <li><% __('The phenotype values should be included in a .xls or .xlsx spreadsheet with the following columns:') |h %></li>
                <br/><table class="table table-hover table-bordered table-condensed table-responsive" >
                    <thead></thead>
                    <tbody>
                        <tr>
                            <td>observationUnitName</td>
                            <td>observationVariableName</td>
                            <td>value</td>
                            <td>timestamp</td>
                            <td>image_name</td>
                            <td>person</td>
                        </tr>
                    </tbody>
                </table>
                <li>The values in the <b>image_name</b> column should should match the image filenames in the zipfile.</li>
            </ul>

        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
      </div>
    </div>
  </div>
</div>


<script defer="defer">

jQuery(document).ready(function() {

    jQuery('#upload_images_link').click( function() {
        jQuery('#upload_images_dialog').modal("show");
    });

    jQuery("#upload_images_format_info").click( function () {
        jQuery("#upload_images_info_dialog" ).modal("show");
    });

    jQuery('#upload_images_file_format').change(function(){
        jQuery('#upload_images_status').html('');
        // images uploaded with associated phenotypes are stored by the
        // phenotype upload, which does not return their ids, so they cannot
        // be added to a collection here
        if (jQuery(this).val() == 'images_with_associated_phenotypes') {
            jQuery('#upload_images_with_associated_phenotypes_div').show();
            jQuery('#upload_images_div').hide();
            jQuery('#upload_images_collection_div').hide();
        }
        else {
            jQuery('#upload_images_div').show();
            jQuery('#upload_images_collection_div').show();
            jQuery('#upload_images_with_associated_phenotypes_div').hide();
        }
    });

    jQuery('#upload_images_collection_mode').change(function(){
        var mode = jQuery(this).val();
        jQuery('#upload_images_collection_existing_div').toggle(mode == 'existing');
        jQuery('#upload_images_collection_new_div').toggle(mode == 'new');
        if (mode == 'existing') {
            load_upload_images_collections();
        }
    });

});

// fill the existing collection dropdown with the image collections the user can add to
function load_upload_images_collections() {
    var select = jQuery('#upload_images_collection_id');
    select.html('<option value="">Loading collections...</option>');

    jQuery.ajax({
        url: '/ajax/collection/list',
        data: { collection_type: 'image' },
        success: function(response) {
            select.empty();
            if (response.error) {
                select.append(jQuery('<option>').val('').text(response.error));
                return;
            }
            var collections = (response.collections || []).filter(function(c) { return c.user_can_modify; });
            if (!collections.length) {
                select.append(jQuery('<option>').val('').text('No image collections available'));
                return;
            }
            select.append(jQuery('<option>').val('').text('Select a collection'));
            collections.forEach(function(c) {
                select.append(jQuery('<option>').val(c.collection_id).text(c.name));
            });
        },
        error: function() {
            select.html('<option value="">Could not load collections</option>');
        }
    });
}

</script>
