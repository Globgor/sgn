
<%args>
$user_id => undef
</%args>

<& /util/import_css.mas, paths => [
    'leaflet.css',
    'leaflet.extra-markers.min.css',
    'esri-leaflet-geocoder.css'
] &>

<& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Manage Locations"), 'h' ) &>

<div class="container-fluid">

<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Location Table'), 'h' ),  collapsible=>1, collapsed=>0, subtitle=>'[<a id="upload_locations_link">Upload New Locations</a>]' &>

<& /breeders_toolbox/location_table.mas, user_id=>$user_id &>

</&>

<&| /page/info_section.mas, title => $m->interp->apply_escapes( __('Copy Locations to a List'), 'h' ), collapsible=>1, collapsed=>0, subtitle=>'<i>Copy the location names in the table to a new or exisiting list</i>'&>
<br>
<div style="text-align:right" id="locations_to_list_menu"></div>
<div id="location_names" style="display: none;"></div>
</&>

<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Location Map'), 'h' ),  collapsible=>1, collapsed=>0 &>

<& /breeders_toolbox/location_map.mas, user_id=>$user_id &>

</&>

<& /breeders_toolbox/location_edit.mas &>

</div>
