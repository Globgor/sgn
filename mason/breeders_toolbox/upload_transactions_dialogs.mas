<%args>

</%args>


<div class="modal fade" id="upload_transactions_dialog" name="upload_transactions_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadTransactionsDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="reset" class="close" id="upload_transactions_dismiss_button_1" name="upload_transactions_dismiss_button" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadTransactionsDialog"><% __('Upload Transactions') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /util/workflow.mas, id=> "transactions_upload_workflow" &>
                        <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Intro"), 'h' ) &>
                            <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Upload Seedlot Transactions"), 'h' ) &>
                            <center><% __('You can upload 4 different types of seedlot transactions. All of the transactions in each file have to be the same type.') |h %></center>
                            <ul>
                                <li><% __('Transferring seeds from existing seedlot to another existing seedlot.') |h %></li>
                                <li><% __('Transferring seeds from existing seedlot to a new seedlot. A new seedlot is created beforing adding new transaction.') |h %></li>
                                <li><% __('Removing seeds from existing seedlot to unspecified seedlot name or plot name') |h %></li>
                                <li><b>Note:</b>To transfer seeds from existing seedlot to a previously stored plot, Please use <b>Upload Seedlots Planted in Trial</b> link in the Experimental Design section on the Trial Detail page.</li>
                                <li><% __('Add additional seeds from accession or cross to existing seedlot') |h %></li>
                            </ul>
                            <br/><br/>
                            <center>
                                <button id="next_step_intro_button" class="btn btn-primary" onclick="Workflow.complete(this);"><% __('Go to Next Step') |h %></button>
                            </center>
                        </&>
                        <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Upload Seedlot Transactions"), 'h' ) &>
                            <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Select a transaction type and upload your file"), 'h' ) &>
                            <br/>
                            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_transactions_form" name="upload_transactions_form">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% __('Transaction Type:') |h %> </label>
                                    <div class="col-sm-9">
                                        <select class="form-control" id="transaction_type_option">
                                            <option value=""><% __('Select a transaction type that you want to upload') |h %></option>
                                            <option value="seedlots_to_seedlots"><% __('From existing seedlots to other existing seedlots') |h %></option>
                                            <option value="seedlots_to_new_seedlots"><% __('From existing seedlots to new seedlots') |h %></option>
                                            <option value="seedlots_to_unspecified_names"><% __('From existing seedlots to unpecified seedlots/plots') |h %></option>
                                            <option value="sources_to_existing_seedlots"><% __('From accessions or crosses to existing seedlots') |h %></option>
                                        </select>
                                    </div>
                                </div>
                                <div id="seedlots_to_seedlots_section" style="display:none">
                                    <br/>
                                    <hr class ="solid">
                                    <center>
                                        <h4><% __('You want to transfer seeds from existing seedlots to other existing seedlots') |h %></h4>
                                    </center>
                                    <div class="well well-sm">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <&| /page/explanation.mas, title=>$m->interp->apply_escapes( __('Template information'), 'h' ) &>
                                                    <p>
                                                        <b><% __('File format information') |h %></b>
                                                        <br>
                                                        <a id="seedlots_to_seedlots_format"><% __('Spreadsheet format') |h %></a>
                                                    </p>
                                                </&>
                                            </div>
                                            <div class="col-sm-8">
                                                <br/>
                                                <div class="panel panel-default">
                                                    <div class="panel-body">
                                                        <div class="form-group">
                                                            <label class="col-sm-6 control-label"><% __('Select a File:') |h %> </label>
                                                            <div class="col-sm-6">
                                                                <input type="file" name="seedlots_to_seedlots_file" id="seedlots_to_seedlots_file" encoding="multipart/form-data" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div id="seedlots_to_new_seedlots_section" style="display:none">
                                    <br/>
                                    <hr class ="solid">
                                    <center>
                                        <h4>Please provide basic information about the <b>new seedlots</b> and upload your file</h4>
                                    </center>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label"><% __('Breeding Program:') |h %> </label>
                                            <div class="col-sm-8" >
                                                <div id="new_seedlot_breeding_program_div"></div>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label"><% __('Location of seedlot storage:') |h %> </label>
                                            <div class="col-sm-8" >
                                                <input class="form-control" name="new_seedlot_location" id="new_seedlot_location" placeholder="<% __('Required') |h %>">
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label"><% __('Organization Name:') |h %> </label>
                                            <div class="col-sm-8" >
                                                <input class="form-control" name="new_seedlot_organization_name" id="new_seedlot_organization_name" placeholder="<% __('Optional') |h %>">
                                            </div>
                                        </div>
                                    <div class="well well-sm">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <&| /page/explanation.mas, title=>$m->interp->apply_escapes( __('Template information'), 'h' ) &>
                                                    <p>
                                                        <b><% __('File format information') |h %></b>
                                                        <br>
                                                        <a id="seedlots_to_new_seedlots_format"><% __('Spreadsheet format') |h %></a>
                                                    </p>
                                                </&>
                                            </div>
                                            <div class="col-sm-8">
                                                <br/>
                                                <div class="panel panel-default">
                                                    <div class="panel-body">
                                                        <div class="form-group">
                                                            <label class="col-sm-6 control-label"><% __('Select a File:') |h %> </label>
                                                            <div class="col-sm-6">
                                                                <input type="file" name="seedlots_to_new_seedlots_file" id="seedlots_to_new_seedlots_file" encoding="multipart/form-data" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div id="seedlots_to_plots_section" style="display:none">
                                    <br/>
                                    <hr class ="solid">
                                    <center>
                                        <h4><% __('You want to use seeds from existing seedlots for plots') |h %></h4>
                                    </center>
                                    <div class="well well-sm">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <&| /page/explanation.mas, title=>$m->interp->apply_escapes( __('Template information'), 'h' ) &>
                                                    <p>
                                                        <b><% __('File format information') |h %></b>
                                                        <br>
                                                        <a id="seedlots_to_plots_format"><% __('Spreadsheet format') |h %></a>
                                                    </p>
                                                </&>
                                            </div>
                                            <div class="col-sm-8">
                                                <br/>
                                                <div class="panel panel-default">
                                                    <div class="panel-body">
                                                        <div class="form-group">
                                                            <label class="col-sm-6 control-label"><% __('Select a File:') |h %> </label>
                                                            <div class="col-sm-6">
                                                                <input type="file" name="seedlots_to_plots_file" id="seedlots_to_plots_file" encoding="multipart/form-data" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div id="seedlots_to_unspecified_names_section" style="display:none">
                                    <br/>
                                    <hr class ="solid">
                                    <center>
                                        <h4><% __('You want to remove seeds from existing seedlots to unspefified seedlots/plots') |h %></h4>
                                    </center>
                                    <div class="well well-sm">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <&| /page/explanation.mas, title=>$m->interp->apply_escapes( __('Template information'), 'h' ) &>
                                                    <p>
                                                        <b><% __('File format information') |h %></b>
                                                        <br>
                                                        <a id="seedlots_to_unspecified_names_format"><% __('Spreadsheet format') |h %></a>
                                                    </p>
                                                </&>
                                            </div>
                                            <div class="col-sm-8">
                                                <br/>
                                                <div class="panel panel-default">
                                                    <div class="panel-body">
                                                        <div class="form-group">
                                                            <label class="col-sm-6 control-label"><% __('Select a File:') |h %> </label>
                                                            <div class="col-sm-6">
                                                                <input type="file" name="seedlots_to_unspecified_names_file" id="seedlots_to_unspecified_names_file" encoding="multipart/form-data" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div id="sources_to_existing_seedlots_section" style="display:none">
                                    <br/>
                                    <hr class ="solid">
                                    <center>
                                        <h4><% __('You want to add more seeds from accessions/crosses to existing seedlots') |h %></h4>
                                    </center>
                                    <div class="well well-sm">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <&| /page/explanation.mas, title=>$m->interp->apply_escapes( __('Template information'), 'h' ) &>
                                                    <p>
                                                        <b><% __('File format information') |h %></b>
                                                        <br>
                                                        <a id="sources_to_existing_seedlots_format"><% __('Spreadsheet format') |h %></a>
                                                    </p>
                                                </&>
                                            </div>
                                            <div class="col-sm-8">
                                                <br/>
                                                <div class="panel panel-default">
                                                    <div class="panel-body">
                                                        <div class="form-group">
                                                            <label class="col-sm-6 control-label"><% __('Select a File:') |h %> </label>
                                                            <div class="col-sm-6">
                                                                <input type="file" name="sources_to_existing_seedlots_file" id="sources_to_existing_seedlots_file" encoding="multipart/form-data" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                            <div id="submit_transactions_button_section" style="display:none">
                                <center>
                                    <button type="button" onclick="Workflow.complete(this, false);" class="btn btn-primary" name="upload_transactions_submit" id="upload_transactions_submit"><% __('Upload File') |h %></button>
                                </center>
                            </div>
                        </&>
                        <&| /util/workflow.mas:complete, title=> $m->interp->apply_escapes( __("Complete"), 'h' ) &>
                            <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Finished! Your transactions are now in the database"), 'h' ) &>
                            <p>
                                <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                <% __('The transactions file was uploaded successfully') |h %>
                            </p>
                        </&>
                    </&><!-- End of workflow -->
                </div>
            </div>
            <div class="modal-footer">
                <button id="upload_transactions_dismiss_button_2" name="upload_transactions_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_transactions_error_display" name="upload_transactions_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadTransactionsErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadTransactionsErrorDialog"><% __('Upload Transactions File Error') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="seedlots_to_seedlots_info_dialog" name="seedlots_to_seedlots_info_dialog" tabindex="-1" role="dialog" aria-labelledby="seedlotsToseedlotsInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="seedlotsToseedlotsInfoDialog"><% __('Upload Template Information For Existing Seedlot to Existing Seedlot Transactions') |h %>  </h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b><% __('Header:') |h %></b>
                    <br>
                    <% __('The first row (header) must contain the following:') |h %>
                    <br />
                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>from_seedlot_name</td>
                                <td>to_seedlot_name</td>
                                <td>amount</td>
                                <td>weight_gram</td>
                                <td>operator_name</td>
                                <td>transaction_description</td>
                            </tr>
                        </tbody>
                    </table>
                    <b><% __('Required fields:') |h %></b>
                    <ul>
                        <li><b>from_seedlot_name:</b> Must exist in the database. Seeds were taken from this seedlot.</li>
                        <li><b>to_seedlot_name:</b> Must exist in the database. Seeds were added to this seedlot.</li>
                        <li>
                            <b>amount:</b> Number of seeds being transaferred. Can be provided in conjunction with weight_gram. Must provide a value for amount or weight_gram or both.
                            <br/><b><% __('AND/OR') |h %></b><br/>
                            <b>weight_gram:</b> Weight in grams of seedlot being transferred. Can be provided in conjunction with amount. Must provide a value for amount or weight_gram or both.
                        </li>
                        <li><b>operator_name:</b> Name of the person who oversaw the transaction process. Can be any name.</li>
                    </ul>
                    <b><% __('Optional fields:') |h %></b>
                    <ul>
                        <li><b>transaction_description:</b> Information about why this transaction is processed.</li>
                    </ul>
                </div>
                <& /help/file_upload_type.mas, type => "Seedlot Transactions", optional_column => 1 &>
            </div>
            <div class="modal-footer">
                <button id="close_seedlots_to_seedlots_info_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="seedlots_to_new_seedlots_info_dialog" name="seedlots_to_new_seedlots_info_dialog" tabindex="-1" role="dialog" aria-labelledby="seedlotsToNewSeedlotsInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="seedlotsToNewSeedlotsInfoDialog"><% __('Upload Template Information For Existing Seedlot to New Seedlot Transactions') |h %>  </h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b><% __('Header:') |h %></b>
                    <br>
                    <% __('The first row (header) must contain the following:') |h %>
                    <br />
                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>from_seedlot_name</td>
                                <td>amount</td>
                                <td>weight_gram</td>
                                <td>operator_name</td>
                                <td>transaction_description</td>
                                <td>to_new_seedlot_name</td>
                                <td>new_seedlot_box_name</td>
                                <td>new_seedlot_description</td>
                                <td>new_seedlot_quality</td>
                            </tr>
                        </tbody>
                    </table>
                    <b><% __('Required fields:') |h %></b>
                    <ul>
                        <li><b>from_seedlot_name:</b> Must exist in the database. Seeds were taken from this seedlot.</li>
                        <li>
                            <b>amount:</b> Number of seeds being transferred. Can be provided in conjunction with weight_gram. Must provide a value for amount or weight_gram or both.
                            <br/><b><% __('AND/OR') |h %></b><br/>
                            <b>weight_gram:</b> Weight in grams of seedlot being transferred. Can be provided in conjunction with amount. Must provide a value for amount or weight_gram or both.
                        </li>
                        <li><b>operator_name:</b> Name of the person who oversaw the transaction process. Can be any name.</li>
                        <li><b>to_new_seedlot_name:</b> Must NOT exist in the database. New seedlot will be created using amount/weight of seeeds from existing seedlot.</li>
                        <li><b>new_seedlot_box_name:</b> Box name that this new seedlot is stored. Can be any name.</li>
                    </ul>
                    <b><% __('Optional fields:') |h %></b>
                    <ul>
                        <li><b>transaction_description:</b> Information about why this transaction is processed.</li>
                        <li><b>new_seedlot_description:</b> Information about this new seedlot.</li>
                        <li><b>new_seedlot_quality:</b> Status or condition of the seedlot, for example "ok", "moldy", "insect damage" etc.</li>
                    </ul>
                </div>
                <& /help/file_upload_type.mas, type => "Seedlot Transactions", optional_column => 1 &>
            </div>
            <div class="modal-footer">
                <button id="close_seedlots_to_new_seedlots_info_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="seedlots_to_plots_info_dialog" name="seedlots_to_plots_info_dialog" tabindex="-1" role="dialog" aria-labelledby="seedlotsToPlotsInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="seedlotsToPlotsInfoDialog"><% __('Upload Template Information For Existing Seedlot to Plot Transactions') |h %>  </h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b><% __('Transactions may be uploaded in an Excel file (.xls or .xlsx)') |h %></b>
                    <b><% __('Header:') |h %></b>
                    <br>
                    <% __('The first row (header) must contain the following:') |h %>
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>from_seedlot_name</td>
                                <td>to_plot_name</td>
                                <td>amount</td>
                                <td>weight_gram</td>
                                <td>operator_name</td>
                                <td>transaction_description</td>
                            </tr>
                        </tbody>
                    </table>
                    <b><% __('Required fields:') |h %></b>
                    <ul>
                        <li><b>from_seedlot_name:</b> Must exist in the database. Seeds were taken from this seedlot.</li>
                        <li><b>to_plot_name:</b> Must exist in the database. Seeds were used for this plot. You can also record seedlot used for each plot during uploading existing trial on the Manage Trials page</li>
                        <li>
                            <b>amount:</b> Number of seeds being transaferred. Can be provided in conjunction with weight_gram. Must provide a value for amount or weight_gram or both.
                            <br/><b><% __('AND/OR') |h %></b><br/>
                            <b>weight_gram:</b> Weight in grams of seedlot being transferred. Can be provided in conjunction with amount. Must provide a value for amount or weight_gram or both.
                        </li>
                        <li><b>operator_name:</b> Name of the person who oversaw the transaction process. Can be any name.</li>
                    </ul>
                    <b><% __('Optional fields:') |h %></b>
                    <ul>
                        <li><b>transaction_description:</b> Information about why this transaction is processed.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_seedlots_to_plots_info_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="seedlots_to_unspecified_names_info_dialog" name="seedlots_to_unspecified_names_info_dialog" tabindex="-1" role="dialog" aria-labelledby="seedlotsToUnspecifiedNamesInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
