                <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="seedlotsToUnspecifiedNamesInfoDialog"><% __('Upload Template Information For Existing Seedlot to Unspecified Seedlots/Plots Transactions') |h %>  </h4>
