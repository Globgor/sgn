<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Tutorials'), 'h' ) &>
<ul>
  <li>The SGN Breeders Toolbox <a href="http://www.extension.org/pages/61208">webinar</a> by Joyce Van Eck</li>
  <li>Plant Breeding and Genomics at the <a href="http://www.extension.org/plant_breeding_genomics">eXtension</a> site</li>
  <li>Tomato Genome Browser <a href="http://www.extension.org/article/32485">Webinar</a> presented at the 2010 Tomato Disease Workshop by <a href="mailto:merk.9@osu.edu">Heather Merk</a></li>
  <li>Designing a CAPS Marker From a SNP Using The <a href="http://www.extension.org/article/32361">SGN CAPS Designer</a> by <a href="mailto:merk.9@osu.edu">Heather Merk</a></li>
 <li>A voiceover Powerpoint <a href="http://www.extension.org/pages/60317/sgn-marker-search-tool-tutorial-for-plant-breeders">tutorial for the "Markers" tool </a> by <a href="mailto:merk.9@osu.edu">Heather Merk</a></li>
</ul>
</&>

<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('SGN tools'), 'h' ) &>
<ul>
  <li><& /util/sentence.mas, text => __x('Browse the SGN {link}Markers database{end_link}'), link => '<a href="/search/direct_search.pl?search=markers/">', end_link => '</a>' &></li>
  <li><& /util/sentence.mas, text => __x('Browse available controlled vocabularies using the SGN {link}Ontology browser{end_link}'), link => '<a href="/tools/onto/">', end_link => '</a>' &></li>
  <li><& /util/sentence.mas, text => __x('Develop CAPS markers using the {link}CAPS Designer{end_link}'), link => '<a href="/tools/caps_designer/caps_input.pl">', end_link => '</a>' &></li>
  <li><& /util/sentence.mas, text => __x('Check intron locations in transript data using the {link}Intron Finder{end_link}'), link => '<a href="/tools/intron_detection/find_introns.pl">', end_link => '</a>' &></li>
  <li><& /util/sentence.mas, text => __x('{link}QTL data submssion{end_link} and on-the-fly QTL analysis {link2}for Solanaceae traits{end_link2}'), link => '<a href="/phenome/qtl_form.pl">', end_link => '</a>', link2 => '<a href="/search/direct_search.pl?search=qtl/">', end_link2 => '</a>' &></li>
  <li><& /util/sentence.mas, text => __x('SGN gene and phenotype {link}submission guide{end_link}'), link => '<a href="/phenome/">', end_link => '</a>' &> </li>
</ul>
</&>

<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Tools in development'), 'h' ) &>
<ul><li><& /util/sentence.mas, text => __x('SNP discovery tool. This will be part of the {link}SolCAP{end_link} project.'), link => '<a href="https://www.msu.edu/~douchesd/solcapwebpage.htm">', end_link => '</a>' &></li></ul>
</&>

<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Links'), 'h' ) &>
<ul>
<li><b>Potato</b>
 <ul>
  <li><a href="/organism/Solanum_tuberosum/genome"><% __('Potato genome') |h %></a></li>
  <li><a href="https://spreadsheets.google.com/spreadsheet/ccc?key=0AglmOi1fE8ZYdEtWaUV3S1FzUjNFVmt4X29fNU9HLXc&hl=en_US">Potato marker list</a> (work in progress by David Douches)</li>
 </ul>
</li>
<li><b>Tomato</b>
 <ul>
  <li><a href="/organism/Solanum_lycopersicum/genome"><% __('Tomato genome') |h %></a></li>
  <li><a href="https://spreadsheets.google.com/spreadsheet/ccc?key=0AglmOi1fE8ZYdE9RU0dlS2h4S29RMk1ZQXk4aUJBOGc&hl=en_US">Tomato resistance genes </a> (by Douglas Maxwell).</li>
 </ul>
</li>
<li><& /util/sentence.mas, text => __x('{link}TomatoMap.Net{end_link} - a site for Tomato Genetics at Ohio State University.'), link => '<a href="http://www.tomatomap.net/">', end_link => '</a>' &></li>
<li><& /util/sentence.mas, text => __x('{link}SolCAP{end_link} - the official SolCAP website at Michigan State University.'), link => '<a href="http://solcap.msu.edu/">', end_link => '</a>' &></li>
<li><& /util/sentence.mas, text => __x('{link}Tomato Analyzer{end_link} - software for scoring fruit shape and other shapes.'), link => '<a href="http://www.oardc.ohio-state.edu/vanderknaap/tomato_analyzer.htm">', end_link => '</a>' &></li>
<li><& /util/sentence.mas, text => __x('{link}Submitting data to SGN{end_link} - instruction for data submissions to SGN.'), link => '<a href="/help/index.pl#submit">', end_link => '</a>' &></li>
</ul>
</&>


