<ul>
      <p>
      <li><font size="2" color="green"> <% __('Upload QC assay') |h %></font> </li>
      <li><font size="2" color="green"><% __('Only CSV file format is supported') |h %> </font></li>
  </ul>
</div>
  <br/><br/><br/><br/>
  <center>
        <button class="btn btn-primary" name="upload_genotyping_data_link"><% __('Upload Genotyping Data (VCF or Intertek Format)') |h %></button>
        <button class="btn btn-primary" name="upload_genotyping_data_qc_link"><% __('Run Genotype Quality Control') |h %></button>
    </center>
     
    
<& /breeders_toolbox/genotyping_trials/upload_genotyping_data_dialogs.mas, facilities => $facilities &>
<& /breeders_toolbox/genotyping_trials/upload_genotyping_data_qc_dialogs.mas, facilities => $facilities &>

