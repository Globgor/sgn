<%args>
$program_id
</%args>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <td>
                <a href="/breeders/accessions"><p><% __('Go To Manage Accessions') |h %></p></a>
            </td>
            <td>
                <a href="/breeders/seedlots"><p><% __('Go To Manage Seedlots') |h %></p></a>
            </td>
        </div>
    </div>
    <&| /page/info_section.mas, id=>"program_accessions", title=>$m->interp->apply_escapes( __("Accessions"), 'h' ), collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_accessions.mas, program_id => $program_id &>
    </&>
    <&| /page/info_section.mas, id=>"program_crosses", title=>$m->interp->apply_escapes( __("Crosses"), 'h' ), collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_crosses.mas, program_id => $program_id &>
    </&>
    <&| /page/info_section.mas, id=>"program_seedlots", title=>$m->interp->apply_escapes( __("Seedlots"), 'h' ), collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_seedlots.mas, program_id => $program_id &>
    </&>
    <&| /page/info_section.mas, id=>"program_propagation_identifiers", title=>$m->interp->apply_escapes( __("Propagation Identifiers"), 'h' ), collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_propagation_identifiers.mas, program_id => $program_id &>
    </&>
</div>
