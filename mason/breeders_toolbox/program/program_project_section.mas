<%args>
$program_id
</%args>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <td>
                <a href="/breeders/trials"><p><% __('Go To Manage Trials') |h %></p></a>
            </td>
            <td>
                <a href="/breeders/genotyping"><p><% __('Go To Manage Genotyping Plates') |h %></p></a>
            </td>
            <td>
                <a href="/breeders/crosses"><p><% __('Go To Manage Crosses') |h %></p></a>
            </td>
        </div>
    </div>
    <&| /page/info_section.mas, id=>"program_trials", title => $m->interp->apply_escapes( __("Field Trials"), 'h' ), is_subsection => 1, collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/trials.mas, program_id => $program_id &>
    </&>
    <&| /page/info_section.mas, id=>"program_genotyping_plates", title => $m->interp->apply_escapes( __("Genotyping Plates"), 'h' ), is_subsection => 1, collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_genotyping_plates.mas, program_id => $program_id &>
    </&>
    <&| /page/info_section.mas, id=>"program_crossing_experiments", title => $m->interp->apply_escapes( __("Crossing Experiments"), 'h' ), is_subsection => 1, collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_crossing_experiments.mas, program_id => $program_id &>
    </&>
</div>
