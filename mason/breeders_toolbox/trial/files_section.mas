<%args>
$trial_id
$trial_stock_type => undef
$for_analysis_page => undef
</%args>

<div class="well well-sm">

    <div class="panel panel-default">
        <div class="panel-body">
            <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Data Collection Files"), 'h' ), is_subsection => 1, collapsible=>1, collapsed=>0, &>
                <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Phenotyping Spreadsheets"), 'h' ), empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-default" style="margin:3px" name="create_spreadsheet_link">Create Spreadsheet</button>' &>
                </&>
%  if (!$for_analysis_page) {
                <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Android Field Book Layout"), 'h' ), empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-default" style="margin:3px" name="create_fieldbook_link">Create Field Book</button>' &>
                </&>
                <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Data Collector Spreadsheet"), 'h' ), empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=> '<button class="btn btn-sm btn-default" style="margin:3px" id="create_DataCollector_link">Create DataCollector Spreadsheet</button>' &>
                </&>
%  }
            </&><!-- closes create new phenotyping file section -->
        </div>
    </div>
    <div class="panel panel-default">
        <div class="panel-body">
            <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Upload Phenotyping Files"), 'h' ), is_subsection => 1, collapsible=>1, collapsed=>0, &>
                <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Phenotyping Spreadsheets"), 'h' ), empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_spreadsheet_phenotypes_link">Upload</button>'&>
                </&>
%  if (!$for_analysis_page) {
                <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Android Field Book Exported"), 'h' ), empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_fieldbook_phenotypes_link">Upload</button>'&>
                </&>
                <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Data Collector Spreadsheet"), 'h' ), empty_message=>'', is_subsection => 1, collapsible=>0, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_datacollector_phenotypes_link">Upload</button>'&>
                </&>
%  }
            </&><!-- closes upload new phenotype file section -->
        </div>
    </div>
    <div class="panel panel-default">
        <div class="panel-body">
            <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Uploaded Phenotyping Files"), 'h' ), is_subsection => 1, collapsible=>1, collapsed=>0 &>

                <table class="table table-bordered" id="trial_phenotype_files_datatables" alt="">
                </table>

            </&><!-- closes uploaded file section -->
        </div>
    </div>
    <div class="panel panel-default">
        <div class="panel-body">
            <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Uploaded Additional Files"), 'h' ), is_subsection => 1, collapsible=>1, collapsed=>0, subtitle=>'<button class="btn btn-sm btn-primary" style="margin:3px" id="trial_upload_additional_files_link">Upload Additional Files</button>' &>

            <& /breeders_toolbox/trial/upload_additional_file.mas, trial_id => $trial_id &>

            </&><!-- closes uploaded additional file section -->
        </div>
    </div>
    <div class="panel panel-default">
        <div class="panel-body">
            <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("File Collections"), 'h' ), subtitle=>$m->interp->apply_escapes( __("Collections that contain at least one file from this trial"), 'h' ), is_subsection => 1, collapsible=>1, collapsed=>0 &>

                <div id="trial_file_collections_loading" class="text-muted" style="padding:5px;">
                    <span class="glyphicon glyphicon-refresh"></span> <% __('Loading collections') |h %>&hellip;
                </div>
                <div id="trial_file_collections_empty" class="text-muted" style="display:none; padding:5px;">
                    No collections contain files from this trial yet. Files can be added to a
                    collection from the <a href="/collections/files">file collections page</a>.
                </div>
                <table class="table table-hover table-condensed" id="trial_file_collections_table" style="width:100%; display:none;">
                    <thead>
                        <tr>
                            <th><% __('Collection') |h %></th>
                            <th><% __('Description') |h %></th>
                            <th><% __('Owner') |h %></th>
                            <th><% __('Trial Files') |h %></th>
                            <th><% __('Created') |h %></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

            </&><!-- closes file collections section -->
        </div>
    </div>

</div><!-- closes well -->

<script>
jQuery(document).ready(function() {
    jQuery('#trial_upload_files_onswitch').one("click", function(){

        jQuery('#trial_phenotype_files_datatables').DataTable({
            'ajax': { 'url': '/ajax/breeders/trial/<% $trial_id %>/phenotype_metadata' },
            columns: [
                { title: <% __('Filename') |js %>, "data": null, "render": function ( data, type, row ) { return row[4]; } },
                { title: <% __('Date Uploaded') |js %>, "data": null, "render": function ( data, type, row ) { return row[1]; } },
                { title: <% __('Uploaded By') |js %>, "data": null, "render": function ( data, type, row ) { return '<a href="/solpeople/profile/'+row[2]+'">'+row[3]+'</a>'; } },
                { title: <% __('File Type') |js %>, "data": null, "render": function ( data, type, row ) { return row[6]; } },
                { title: <% __('Options') |js %>, "data": null, "render": function ( data, type, row ) { return '<a href="/breeders/phenotyping/view/'+row[0]+'">View</a> | <a href="/breeders/phenotyping/download/'+row[0]+'">Download</a>'; } },
            ]
        });

        load_trial_file_collections();
    });
});

function load_trial_file_collections() {
    function esc(s) {
        return jQuery('<div>').text(s == null ? '' : s).html();
    }

    jQuery.ajax({
        method: 'GET',
        url: '/ajax/collection/for_trial',
        data: { trial_id: <% $trial_id %>, collection_type: 'file' },
        success: function (response) {
            // reset the previous state, since this also reloads the table
            // after a file is added to a collection
            jQuery('#trial_file_collections_loading').hide();
            jQuery('#trial_file_collections_empty').hide();
            jQuery('#trial_file_collections_table').hide();

            if (response && response.error) {
                jQuery('#trial_file_collections_empty').text(response.error).show();
                return;
            }

            var collections = (response && response.collections) || [];
            if (!collections.length) {
                jQuery('#trial_file_collections_empty').show();
                return;
            }

            var $tb = jQuery('#trial_file_collections_table tbody').empty();
            collections.forEach(function (c) {
                $tb.append(
                    '<tr>' +
                      '<td><a href="/collection/' + esc(c.collection_id) + '">' + esc(c.name) + '</a></td>' +
                      '<td>' + esc(c.description) + '</td>' +
                      '<td>' + esc(c.username) + '</td>' +
                      '<td>' + esc(c.n_trial_files) + '</td>' +
                      '<td>' + esc(c.create_date) + '</td>' +
                    '</tr>'
                );
            });
            jQuery('#trial_file_collections_table').show();
        },
        error: function () {
            jQuery('#trial_file_collections_loading').hide();
            jQuery('#trial_file_collections_empty').text(<% __('Could not load collections.') |js %>).show();
        }
    });
}
</script>
