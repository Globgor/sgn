<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jqueryui', 'jquery.iframe-post-form', 'CXGN.BreedersToolbox.UploadPhenotype', 'CXGN.BreederSearch', 'CXGN.Trial' ] &>

<div class="modal fade" id="upload_treatment_spreadsheet_dialog" name="upload_treatment_spreadsheet_dialog" tabindex="-1" role="dialog" aria-labelledby="addSpreadsheetTreatmentDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="addSpreadsheetTreatmentDialog"><% __('Upload Treatment Spreadsheet') |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

            <&| /page/explanation.mas, title=>$m->interp->apply_escapes( __('Template Information'), 'h' ) &>
                <p>
                <b><% __('File format information') |h %></b>
                <br>
                <a id="treatment_upload_spreadsheet_format_info"><% __('Spreadsheet Format') |h %></a>
                </p>
            </&>

            <form class="form-horizontal" role="form" method="POST" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_spreadsheet_treatment_file_form" name="upload_spreadsheet_treatment_file_form">
                <div class="form-group">
                    <label class="col-sm-6 control-label"><% __('Spreadsheet Format:') |h %> </label>
                    <div class="col-sm-6" >
                        <select class="form-control" id="upload_spreadsheet_treatment_file_format" name="upload_spreadsheet_treatment_file_format">
                            <option value="detailed"><% __('Detailed') |h %></option>
                            <option value="simple"><% __('Simple') |h %></option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-6 control-label"><% __('Timestamps Included:') |h %> </label>
                    <div class="col-sm-6" >
                        <input type="checkbox" id="upload_spreadsheet_treatment_timestamp_checkbox" name="upload_spreadsheet_treatment_timestamp_checkbox" />
                    </div>
                </div>
                <div id="upload_spreadsheet_treatment_data_level_div">
                    <div class="form-group">
                        <label class="col-sm-6 control-label"><% __('Data Level:') |h %> </label>
                        <div class="col-sm-6" >
                            <select class="form-control" id="upload_spreadsheet_treatment_data_level" name="upload_spreadsheet_treatment_data_level">
                                <option value="plots"><% __('Plots') |h %></option>
                                <option value="plants"><% __('Plants') |h %></option>
                                <option value="subplots"><% __('Subplots') |h %></option>
                                <option value="tissue_samples"><% __('Tissue Samples') |h %></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-6 control-label"><% __('Treatment Spreadsheet:') |h %> </label>
                    <div class="col-sm-6" >
                        <input type="file" id="upload_spreadsheet_treatment_file_input" name="upload_spreadsheet_treatment_file_input" encoding="multipart/form-data" />
                    </div>
                </div>

                <div id="upload_treatment_spreadsheet_verify_status"></div>
                </div>

                <div id="upload_treatment_spreadsheet_info" style="display: none">
                    <& /help/file_upload_type.mas, type => "Simple treatment spreadsheets" &>
                </div>

            </form><br/>

        </div>

        <div class="modal-footer">
	    <button type="button" class="btn btn-default" name="reset_dialog" id="treatment_reset_dialog"><% __('Reset form') |h %></button>
            <button type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
            <button type="button" class="btn btn-info" name="upload_spreadsheet_treatment_submit_verify" id="upload_spreadsheet_treatment_submit_verify"><% __('Verify') |h %></button>
            <button disabled type="button" class="btn btn-primary" name="upload_spreadsheet_treatment_submit_store" id="upload_spreadsheet_treatment_submit_store" title="<% __('First Verify Your File') |h %>"><% __('Store') |h %></button>
        </div>

    </div>
  </div>
</div>

<div class="modal fade" id="treatment_upload_spreadsheet_info_dialog" name="treatment_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="treatmentUploadInfoDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="treatmentUploadInfoDialog"><% __('Template Information') |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

            <h4><% __('Treatment spreadsheet must be uploaded in .xls or .xlsx excel file format') |h %></h4>
            <p><% __('(tab-delimited text formats are NOT supported)') |h %></p>

            <hr>
            <button class="btn btn-primary" name="create_spreadsheet_link"><% __('Create Treatment Spreadsheet for Trial') |h %></button>
            <hr>

            <h4><% __('Required Data:') |h %></h4>
            <ul>
                <li><% __('Please click the above button to generate the required treatment spreadsheet. Note that treatment lists can be made just like trait lists.') |h %></li>
            </ul>

            <h4><% __('Notes:') |h %></h4>
            <ul>
                <li>For  a hypothetical term <i>"light intensity"</i>, <i>"treatment name|treatment id"</i><br> should be written as <i>"light intensity|EXPERIMENT_TREATMENT:00000XX"</i>.</li>
                <li><% __('Two or more treatments can be uploaded at the same time.') |h %></li>
            </ul>

            <h4><% __('Simple and Detailed Spreadsheet Format:') |h %></h4>
            <ul>
                <li>The "Simple" format requires only a column called 'observationunit_name' followed by your treatment columns.  Other acceptable headers for the first column include: 'plot_name', 'subplot_name', 'plant_name', 'observationUnitName', 'plotName', 'sublotName', 'plantName'</li>
                <li><% __('The "Detailed" format includes a special header as well as additional columns for design information.') |h %></li>
            </ul>

            <h4><% __('Timestamps:') |h %></h4>
            <ul>
                <li><% __('To include timestamp information for your measurements, click the checkbox "Includes Timestamps".') |h %></li>
                <li>For timestamps, values should be recorded as <i>"Value,Timestamp"</i>.<br/>For no timestamps, values should be recorded as <i>"Value"</i>.</li>
                <li>Timestamp format must be YYYY-MM-DD HH:MM:SS-0000 or YYYY-MM-DD HH:MM:SS+0000</li><br/>
                <li><% __('Example with timestamps:') |h %> <br/><br/>
                <table class="table table-hover table-bordered">
                    <thead>
                        <tr>
                            <th>light intensity|EXPERIMENT_TREATMENT:00000XX</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>20,2016-04-28 16:30:40-0500</td>
                        </tr>
                    </tbody>
                </table>
                </li>
                <li><% __('Example without timestamps:') |h %> <br/><br/>
                <table class="table table-hover table-bordered">
                    <thead>
                        <tr>
                            <th>light intensity|EXPERIMENT_TREATMENT:00000XX</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>20</td>
                        </tr>
                    </tbody>
                </table>
                </li>
            </ul>

        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
      </div>
    </div>
  </div>
</div>

<script defer="defer">
jQuery(document).ready(function () {

    jQuery("#treatment_upload_spreadsheet_format_info").click( function () {
        jQuery("#treatment_upload_spreadsheet_info_dialog" ).modal("show");
    });
});
</script>
