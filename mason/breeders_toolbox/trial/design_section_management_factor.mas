<%args>
$trial_id
$trial_name
$has_subplot_entries
$has_plant_entries
$has_tissue_sample_entries
$design_name
</%args>

<div class="well well-sm">

    <&| /page/info_section.mas, id => "trial_accessions", title=>$m->interp->apply_escapes( __("Accessions Planted"), 'h' ), is_subsection => 1, collapsible=>1, collapsed=>1 &>
        <& /breeders_toolbox/trial/trial_accessions.mas, trial_id => $trial_id &>
    </&>
    <&| /page/info_section.mas, id => "trial_controls", title=>$m->interp->apply_escapes( __("Controls"), 'h' ),  is_subsection => 1, collapsible=>1, collapsed=>1 &>
        <& /breeders_toolbox/trial/trial_controls.mas, trial_id => $trial_id &>
    </&>

    <&| /page/info_section.mas, id => "trial_plots", title=>$m->interp->apply_escapes( __("Plots"), 'h' ),  is_subsection => 1, collapsible=>1, collapsed=>1 &>
        <& /breeders_toolbox/trial/trial_plots.mas, trial_id => $trial_id &>
    </&>

% if ($has_subplot_entries) {
    <&| /page/info_section.mas, id => "trial_subplots", title=>$m->interp->apply_escapes( __("Subplots"), 'h' ),  is_subsection => 1, collapsible=>1, collapsed=>1 &>
        <& /breeders_toolbox/trial/trial_subplots.mas, trial_id => $trial_id &>
    </&>
% }
% if ($has_plant_entries) {
    <&| /page/info_section.mas, id => "trial_plants", title=>$m->interp->apply_escapes( __("Plant Entries"), 'h' ), is_subsection => 1, collapsible=> 1, collapsed=>1 &>
        <& /breeders_toolbox/trial/trial_plants.mas, trial_id => $trial_id &>
    </&>
% }
% if ($has_tissue_sample_entries) {
    <&| /page/info_section.mas, id => "trial_tissue_samples", title=>$m->interp->apply_escapes( __("Tissue Sample Entries"), 'h' ), is_subsection => 1, collapsible=> 1, collapsed=>1 &>
        <& /breeders_toolbox/trial/trial_tissue_samples.mas, trial_id => $trial_id &>
    </&>
% }
</div><!-- closes well -->
