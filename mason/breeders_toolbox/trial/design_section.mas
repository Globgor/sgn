<%args>
$trial_id
$trial_name
$has_subplot_entries
$has_plant_entries
$has_tissue_sample_entries
$trial_stock_type => undef
$management_factor_types => undef
$user_can_modify => undef
$curator => undef
</%args>

<style>

</style>

<div class="well well-sm">

    <& /breeders_toolbox/trial/design.mas, trial_id => $trial_id &>
% my $stock_label = '';
% if ($trial_stock_type eq 'family_name') {
%     $stock_label = 'Family Names';
% } elsif ($trial_stock_type eq 'cross') {
%     $stock_label = 'Cross Unique IDs';
% } else {
%     $stock_label = 'Accessions' ;

% }

  <&| /page/info_section.mas, id => "management_regime", title=> $m->interp->apply_escapes( __('Management Regime'), 'h' ), subtitle => '<div class="col-sm-4"><div id="management_factors">How this trial was managed</div></div>',is_subsection => 1, collapsible=>1, collapsed=>1 &>

      <& /breeders_toolbox/trial/design_section_management_regime.mas, trial_id => $trial_id,management_factor_types => $management_factor_types, user_can_modify => $user_can_modify &>

  </&>

  <& /breeders_toolbox/trial/trial_stocks_count.mas, trial_id => $trial_id &>
  <&| /page/info_section.mas, id => "trial_stocks", title=> $stock_label, subtitle => '<div class="col-sm-4"><div id="stocks_counts"></div></div>',is_subsection => 1, collapsible=>1, collapsed=>1 &>

      <& /breeders_toolbox/trial/trial_stocks.mas, trial_id => $trial_id &>

  </&>


    <&| /page/info_section.mas, id => "trial_seedlots", title=>$m->interp->apply_escapes( __("Seedlots"), 'h' ), subtitle => '<div class="col-sm-4"><div id="seedlots_counts"></div></div>', is_subsection => 1, collapsible=>1, collapsed=>1 &>
        <& /breeders_toolbox/trial/trial_seedlots.mas, trial_id => $trial_id &>
        <& /breeders_toolbox/trial/trial_seedlots_count.mas, trial_id => $trial_id &>
    </&>


    <&| /page/info_section.mas, id => "trial_controls", title=>$m->interp->apply_escapes( __("Controls"), 'h' ), subtitle => '<div class="col-sm-4"><div id="controls_counts"></div></div>', is_subsection => 1, collapsible=>1, collapsed=>1 &>
        <& /breeders_toolbox/trial/trial_controls.mas, trial_id => $trial_id &>
        <& /breeders_toolbox/trial/trial_controls_count.mas, trial_id => $trial_id &>
    </&>


    <&| /page/info_section.mas, id => "trial_plots", title=>$m->interp->apply_escapes( __("Plots"), 'h' ), subtitle => '<div class="col-sm-4"><div id="plots_counts"></div></div>', is_subsection => 1, collapsible=>1, collapsed=>1 &>
        <& /breeders_toolbox/trial/trial_plots.mas, trial_id => $trial_id &>
        <& /breeders_toolbox/trial/trial_plots_count.mas, trial_id => $trial_id &>
    </&>

    <&| /page/info_section.mas, id => "trial_subplots", title=>$m->interp->apply_escapes( __("Subplots"), 'h' ),  is_subsection => 1, collapsible=>1, collapsed=>1 &>

        <div id="subplot_entries_section">

% if (!$has_subplot_entries && !$has_plant_entries) {
            <button class="btn btn-default" id="create_subplot_entries_button"><% __('Add subplot entries') |h %></button>
            <button class="btn btn-default" id="upload_subplot_entries_button">Upload subplot entries using subplot_name</button>
            <button class="btn btn-default" id="upload_subplot_entries_with_index_number_button"><% __('Upload subplot entries using subplot index number') |h %></button>
            <button class="btn btn-default" id="trial_upload_subplots_with_num_subplots_button"><% __('Upload subplot entries using number of subplots per plot') |h %></button>
% } elsif ($has_plant_entries && !$has_subplot_entries) {
            <p><% __('Subplots cannot be added to trials that already contain plant entries.') |h %></p>
% } else {
            <& /breeders_toolbox/trial/trial_subplots.mas, trial_id => $trial_id, curator => $curator &>     
% if ($curator) {
            <br>
            <button class="btn btn-default" id="create_subplot_entries_button"><% __('Add subplot entries') |h %></button>
            <button class="btn btn-default" id="upload_subplot_entries_button">Upload subplot entries using subplot_name</button>
            <button class="btn btn-default" id="upload_subplot_entries_with_index_number_button"><% __('Upload subplot entries using subplot index number') |h %></button>
            <button class="btn btn-default" id="trial_upload_subplots_with_num_subplots_button"><% __('Upload subplot entries using number of subplots per plot') |h %></button>
% }
% }

        </div>

    </&>

    <&| /page/info_section.mas, id => "trial_plants", title=>$m->interp->apply_escapes( __("Plant Entries"), 'h' ), is_subsection => 1, collapsible=> 1, collapsed=>1 &>

        <div id="plant_entries_section">

% if (!$has_plant_entries && !$has_subplot_entries) {
           <p><strong><% __('Add Plants to Plots:') |h %></strong></p>
           <button class="btn btn-default" id="create_plant_entries_button"><% __('Add plant entries') |h %></button>
           <button class="btn btn-default" id="upload_plant_entries_button">Upload plant entries using plant_name</button>
           <button class="btn btn-default" id="upload_plant_entries_with_index_number_button"><% __('Upload plant entries using plant index number') |h %></button>
           <button class="btn btn-default" id="trial_upload_plants_with_num_plants_button"><% __('Upload plant entries using number of plants per plot') |h %></button>

% } elsif ($has_subplot_entries && !$has_plant_entries) {

           <br />
           <p><strong><% __('Add Plants to Subplots:') |h %></strong></p>
           <button class="btn btn-default" id="create_plant_entries_subplots_button"><% __('Add plant entries') |h %></button>
           <button class="btn btn-default" id="upload_plant_entries_subplots_button">Upload plant entries using plant_name</button>
           <button class="btn btn-default" id="upload_plant_entries_with_index_number_subplots_button"><% __('Upload plant entries using plant index number') |h %></button>
           <button class="btn btn-default" id="trial_upload_plants_with_num_plants_subplots_button"><% __('Upload plant entries using number of plants per subplot') |h %></button>
% } else { # if this executes, there's definitely no plants
            <& /breeders_toolbox/trial/trial_plants.mas, trial_id => $trial_id, curator => $curator &>
%       if ($curator && $has_subplot_entries) {
            <p><strong><% __('Add Plants to Subplots:') |h %></strong></p>
           <button class="btn btn-default" id="create_plant_entries_subplots_button"><% __('Add plant entries') |h %></button>
           <button class="btn btn-default" id="upload_plant_entries_subplots_button">Upload plant entries using plant_name</button>
           <button class="btn btn-default" id="upload_plant_entries_with_index_number_subplots_button"><% __('Upload plant entries using plant index number') |h %></button>
           <button class="btn btn-default" id="trial_upload_plants_with_num_plants_subplots_button"><% __('Upload plant entries using number of plants per subplot') |h %></button>
%       }
%       if ($curator && !$has_subplot_entries) {
            <p><strong><% __('Add Plants to Plots:') |h %></strong></p>
           <button class="btn btn-default" id="create_plant_entries_button"><% __('Add plant entries') |h %></button>
           <button class="btn btn-default" id="upload_plant_entries_button">Upload plant entries using plant_name</button>
           <button class="btn btn-default" id="upload_plant_entries_with_index_number_button"><% __('Upload plant entries using plant index number') |h %></button>
           <button class="btn btn-default" id="trial_upload_plants_with_num_plants_button"><% __('Upload plant entries using number of plants per plot') |h %></button>
%       }
% }

        </div><!--closes plant_entries_section -->

    </&>

    <&| /page/info_section.mas, id => "trial_tissue_samples", title=>$m->interp->apply_escapes( __("Tissue Sample Entries"), 'h' ), is_subsection => 1, collapsible=> 1, collapsed=>1 &>

        <div id="tissue_sample_entries_section">

% if (!$has_tissue_sample_entries) {
           <button class="btn btn-default" id="create_tissue_sample_entries_button"><% __('Add tissue sample entries') |h %></button>
           <& /breeders_toolbox/trial/add_tissue_sample_per_plant.mas, trial_id => $trial_id, trial_name => $trial_name, trial_has_plants => $has_plant_entries &>
% } else {
		   <button class="btn btn-default" id="create_tissue_sample_entries_button"><% __('Add tissue sample entries') |h %></button>
           <& /breeders_toolbox/trial/add_tissue_sample_per_plant.mas, trial_id => $trial_id, trial_name => $trial_name, trial_has_plants => $has_plant_entries &>
           <& /breeders_toolbox/trial/trial_tissue_samples.mas, trial_id => $trial_id &>
% }

        </div><!--closes tissue_sample_entries_section -->

    </&>

    <&| /page/info_section.mas, id => "summary_of_stock_entries", title=>$m->interp->apply_escapes( __("Summary of Stock Entries"), 'h' ),  is_subsection => 1, collapsible=>1, collapsed=>1 &>
        <div id="summary_entries_section">
            <& /breeders_toolbox/trial/summary_stock_entries.mas, trial_id => $trial_id, trial_stock_type => $trial_stock_type &>
        </div>
    </&>

    <&| /page/info_section.mas, id => "trial_treatments", title=>$m->interp->apply_escapes( __("Treatments"), 'h' ),  is_subsection => 1, collapsible=>1, collapsed=>1 &>
        <& /breeders_toolbox/trial/trial_treatments.mas, trial_id => $trial_id, user_can_modify => $user_can_modify &>
    </&>

    <&| /page/info_section.mas, id=>"trial_entry_numbers", title=>$m->interp->apply_escapes( __("Entry Numbers"), 'h' ), is_subsection=>1, collapsible=>1, collapsed=>1 &>
        <& /breeders_toolbox/trial/trial_entry_numbers.mas, trial_id => $trial_id, trial_name => $trial_name &>
    </&>



</div><!-- closes well -->
