<%args>
    $tool => undef
</%args>

<& /util/import_javascript.mas, classes => [ 'bootstrap_min.js', 'jquery' ] &>

<& /page/page_title.mas, title => $m->interp->apply_escapes( __('Seedlot Maintenance'), 'h' ) &>

<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("About Seedlot Maintenance"), 'h' ),  collapsible => 1, collapsed => 1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <p><& /util/sentence.mas, text => __x('Seedlot Maintenance allows you to record and document certain actions and/or observations taken for the proper maintenance of your Seedlots. The actions and observations are timestamped so you can clearly track the maintenance and state of your Seedlots over time.') &></p>
                <p><& /util/sentence.mas, text => __x('To record a new maintenance event for a particular Seedlot, use the {strong}Record Maintenance{end_strong} button below to enter the event information directly on the website. You can also bulk upload maintenance events for one or more Seedlots using the {strong}Upload Maintenance{end_strong} button.'), strong => '<strong>', end_strong => '</strong>' &></p>
                <p><& /util/sentence.mas, text => __x('You can view the maintenance events for a single Seedlot on the Seedlot detail page by going to the {link}{strong}Manage > Seedlots{end_strong}{end_link} page, searching for the Seedlot, and clicking its name in the results table. You can also filter through all of the stored maintenance events using the search below. The events can then be downloaded from the table displaying the results or downloaded in bulk from the {link2}{strong}Manage > Download{end_strong}{end_link2} page using a list of Seedlots.'), link => '<a href=\'/breeders/seedlots\'>', end_link => '</a>', link2 => '<a href=\'/breeders/download\'>', end_link2 => '</a>', strong => '<strong>', end_strong => '</strong>' &></p>
            </div>
        </div>
    </div>
</&>

<!-- Additional crop-specific seedlot maintenance tools -->
<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Seedlot Maintenance Tools"), 'h' ),  collapsible => 1, collapsed => !$tool &>
    <& /breeders_toolbox/seedlot_maintenance/tools.mas, collapsed => !$tool &>
</&>

<%perl>
    my $seedlot_subtitle = '';
    if ( !$c->user() ) {
        $seedlot_subtitle = "Login to add Seedlot maintenance events";
    }
    elsif ( $c->user()->check_roles("curator") || $c->user()->check_roles("submitter") ) {
        $seedlot_subtitle = '<button class="btn btn-sm btn-primary" style="margin:3px" id="record_events">Record Maintenace</button> <button class="btn btn-sm btn-primary" style="margin:3px" id="upload_events">Upload Maintenance</button>'
    }
</%perl>
<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Seedlot Maintenance Events"), 'h' ),  collapsible => 1, collapsed => !!$tool, subtitle => $seedlot_subtitle &>
    
    <& /breeders_toolbox/seedlot_maintenance/table.mas &>

</&>


<!-- Upload Workflow Dialog -->
<& /breeders_toolbox/seedlot_maintenance/upload_dialog.mas &>


<script type="text/javascript">

    jQuery(document).ready(function() {
        jQuery('#record_events').click(function() {
            window.location = '/breeders/seedlot/maintenance/record';
        });
        jQuery('#upload_events').click(function() {
            jQuery('#upload_maintenance_event_upload_modal').modal("show");
        });
    });

</script>