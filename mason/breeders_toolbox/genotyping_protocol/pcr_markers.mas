<%args>
$protocol_id
</%args>

<table id="pcr_protocol_markers_table" class="table table-hover table-bordered">
    <thead>
        <tr>
            <th><% __('Marker Name') |h %></th>
            <th><% __('Product Sizes') |h %></th>
            <th><% __('Forword Primer') |h %></th>
            <th><% __('Reverse Primer') |h %></th>
            <th><% __('Annealing Temperature') |h %></th>
            <th><% __('Sequence Motif') |h %></th>
            <th><% __('Sequence Source') |h %></th>
            <th><% __('Linkage Group') |h %></th>
        </tr>
    </thead>
    </tbody>
</table>

<script>

jQuery(document).ready(function(){

    var pcr_genotyping_protocol_table = jQuery('#pcr_protocol_markers_table').DataTable({
        'autoWidth': false,
        'ajax': {'url': '/ajax/genotyping_protocol/pcr_markers',
                 'data': function(d) {
                    d.protocol_id = <% $protocol_id %>;
                }
        },
    });

});


</script>
