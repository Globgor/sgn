<%args>
$protocol_id
$protocol_name
$protocol_description
$marker_names => []
$header_information_lines => []
$reference_genome_name
$species_name
$create_date
$sample_observation_unit_type_name
$marker_type
$assay_type
</%args>

<div class="row">
    <div class="col-sm-12">

        <table class="table table-hover table-bordered" >

            <tr>
                <td><b><% __('Genotyping Protocol Name') |h %></b></td>
                <td>
                    <% $protocol_name %>
                </td>
            </tr>

            <tr>
                <td><b><% __('Protocol Description') |h %> </b></td>
                <td>
                    <% $protocol_description %>
                </td>
            </tr>

            <tr><td><b><% __('Assay Type') |h %></b></td>
                <td>
                    <% $assay_type %>
                </td>
            </tr>

            <tr>
                <td><b><% __('Marker Type') |h %></b></td>
                <td>
                    <% $marker_type %>
                </td>
            </tr>

            <tr>
                <td><b><% __('Number of Markers') |h %></b></td>
                <td>
%                   print scalar(@$marker_names);
                </td>
            </tr>

            <tr>
                <td><b><% __('Header Information Description') |h %></b></td>
                <td>
% my @trimmed;
% my $header_line_count = 0;
% foreach (@$header_information_lines){
%    if ($header_line_count < 10) {
%        $_ =~ tr/<>//d;
%        push @trimmed, $_;
%    }
%    else {
%        push @trimmed, "### ----- SHOWING FIRST 10 LINES ONLY ----- ###";
%        last;
%    }
%    $header_line_count++;
% }
% my $description = join '<br/>', @trimmed;
% $description = $description ? $description : 'NA';
% print "$description";
                </td>
            </tr>

            <tr><td><b><% __('Reference Genome') |h %></b></td>
                <td>
                    <% $reference_genome_name %>
                </td>
            </tr>

            <tr><td><b><% __('Species Name') |h %></b></td>
                <td>
                    <% $species_name %>
                </td>
            </tr>

            <tr><td><b><% __('Sample Unit') |h %></b></td>
                <td>
                    <% $sample_observation_unit_type_name %>
                </td>
            </tr>

            <tr><td><b><% __('Create Date') |h %></b></td>
                <td>
                    <% $create_date %>
                </td>
            </tr>

        </table>

    </div>
</div>
