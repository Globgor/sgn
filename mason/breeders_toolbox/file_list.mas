
<%doc>
</%doc>

<%args>
$files => []
$allow_delete => 0
</%args>

% if (scalar(@$files)>0) {
<table class="table table-bordered files_datatables" alt="">
<thead>
  <tr><th><% __('Filename') |h %></th><th><% __('Date Uploaded') |h %></th><th><% __('Options') |h %></th></tr>
</thead>
<tbody>
% foreach my $f (@$files) { 
  <tr>
    <td><% $f->{basename} %></td>
    <td><% $f->{create_date} %></td>
    <td>
% if ($allow_delete){
    <button class="btn btn-default btn-sm" name="delete_pheno_file_link" data-file_id="<% $f->{file_id} %>" ><% __('Delete') |h %></button> | 
% }
    <a href="/breeders/phenotyping/view/<% $f->{file_id} %>"><% __('View') |h %></a> | <a href="/breeders/phenotyping/download/<% $f->{file_id} %>"><% __('Download') |h %></a></td>
  </tr>
% }
</tbody>
</table>
% }

<script>

jQuery(document).ready(function() {

    jQuery('.files_datatables').DataTable();

});

</script>
