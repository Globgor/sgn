<%args>
$id_extension => ''
</%args>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <div class="well well-sm">
                <form class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-6 control-label"><% __('Number of Rows:') |h %> </label>
                                <div class="col-sm-6">
                                    <input class="form-control" id="drone_imagery_plot_polygons_num_rows<% $id_extension %>" name="drone_imagery_plot_polygons_num_rows<% $id_extension %>" type="number" placeholder="<% __('Number of rows in image section') |h %>" />
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group form-group-sm">
                                <label class="col-sm-6 control-label"><% __('Number of Columns:') |h %> </label>
                                <div class="col-sm-6">
                                    <input class="form-control" id="drone_imagery_plot_polygons_num_cols<% $id_extension %>" name="drone_imagery_plot_polygons_num_cols<% $id_extension %>" type="number" placeholder="<% __('Number of columns in image section') |h %>"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body">

            <div class="row">
                <div class="col-sm-12">
                    <h4> <% __('Either click the four corners of the area of interest:') |h %> </h4>

                    <button class="btn btn-sm btn-info" id="drone_imagery_plot_polygons_top_left_click<% $id_extension %>"><% __('Click Top Left Corner') |h %></button>
                    <button class="btn btn-sm btn-info" id="drone_imagery_plot_polygons_top_right_click<% $id_extension %>"><% __('Click Top Right Corner') |h %></button>
                    <button class="btn btn-sm btn-info" id="drone_imagery_plot_polygons_bottom_left_click<% $id_extension %>"><% __('Click Bottom Left Corner') |h %></button>
                    <button class="btn btn-sm btn-info" id="drone_imagery_plot_polygons_bottom_right_click<% $id_extension %>"><% __('Click Bottom Right Corner') |h %></button>
                </div>
            </div>
            <hr>
        
            <&| /page/info_section.mas, title => $m->interp->apply_escapes( __('Template Parameters'), 'h' ), collapsible=>1, collapsed => 1, subtitle=> $m->interp->apply_escapes( __('View and edit template parameters. These parameters can be filled using the above button clicks'), 'h' ) &>
                <div class="well well-sm">
                    <form class="form-horizontal">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label"><% __('Left-most Column Top Margin:') |h %> </label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_left_column_top_offset<% $id_extension %>" name="drone_imagery_plot_polygons_left_column_top_offset<% $id_extension %>" type="number" value="0"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label"><% __('Left-most Column Bottom Margin:') |h %> </label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_left_column_bottom_offset<% $id_extension %>" name="drone_imagery_plot_polygons_left_column_bottom_offset<% $id_extension %>" type="number" value="0"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label"><% __('Top-most Row Left Margin:') |h %> </label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_top_row_left_offset<% $id_extension %>" name="drone_imagery_plot_polygons_top_row_left_offset<% $id_extension %>" type="number" placeholder="<% __('Left offset of image section') |h %>" value="0" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label"><% __('Top-most Row Right Margin:') |h %> </label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_top_row_right_offset<% $id_extension %>" name="drone_imagery_plot_polygons_top_row_right_offset<% $id_extension %>" type="number" placeholder="<% __('Left offset of image section') |h %>" value="0" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label"><% __('Bottom-most Row Left Margin:') |h %> </label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_bottom_row_left_offset<% $id_extension %>" name="drone_imagery_plot_polygons_bottom_row_left_offset<% $id_extension %>" type="number" placeholder="<% __('Left offset of image section') |h %>" value="0" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label"><% __('Right-most Column Bottom Margin:') |h %> </label>
                                    <div class="col-sm-6">
                                        <input class="form-control" id="drone_imagery_plot_polygons_right_col_bottom_offset<% $id_extension %>" name="drone_imagery_plot_polygons_right_col_bottom_offset<% $id_extension %>" type="number" placeholder="<% __('Right-most column bottom offset') |h %>" value="0" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </&>

            <br/>
            <button class="btn btn-sm btn-primary" id="drone_imagery_plot_polygons_rectangles_apply<% $id_extension %>"><% __('Draw Plot Polygon Template (Does not save. Apply multiple templates if needed.)') |h %></button>

        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body">

            <div class="row">
                <div class="col-sm-12">
                    <h4> <% __('Or paste a previously used template:') |h %> </h4>
                </div>
            </div>

            <&| /page/info_section.mas, title => $m->interp->apply_escapes( __('Previously Used Plot Polygon Templates'), 'h' ), collapsible=>1, collapsed => 1, subtitle=> $m->interp->apply_escapes( __('View and use previous plot polygon templates used on this field trial'), 'h' ) &>
                <div class="well well-sm">
                    <form class="form-horizontal">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-6 control-label"><% __('Previously Used Plot Polygon Templates For This Field Trial:') |h %> </label>
                                    <div class="col-sm-6">
                                        <div id="plot_polygons_previously_saved_plot_polygon_templates<% $id_extension %>">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                    <button class="btn btn-primary" id="plot_polygons_use_previously_saved_template<% $id_extension %>"><% __('Draw Plot Polygon Template (Does not save)') |h %></button>
                </div>
            </&>
        </div>
    </div>

    <div id="drone_imagery_plot_polygons_active_templates<% $id_extension %>"></div>

</div>
