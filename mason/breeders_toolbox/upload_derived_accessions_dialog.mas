<%args>

</%args>

<div class="modal fade" id="upload_derived_accessions_dialog" name="upload_derived_accessions_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadDerivedAccessionsDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadDerivedAccessionsDialog"><% __('Upload Derived Accessions') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /page/explanation.mas, title=>$m->interp->apply_escapes( __('Template Information'), 'h' ) &>
                        <p>
                            <b><% __('File format information') |h %></b>
                            <br>
                            <a id="derived_accession_upload_spreadsheet_format_info"><% __('Spreadsheet Format') |h %></a>
                        </p>
                    </&>
                    <form method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_derived_accessions_form" name="upload_derived_accessions_form">
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% __('Upload File:') |h %> </label>
                            <div class="col-sm-9" >
                                <input type="file" name="derived_accessions_file" id="derived_accessions_file" encoding="multipart/form-data" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
                <button type="button" class="btn btn-primary" name="upload_derived_accessions_submit" id="upload_derived_accessions_submit"><% __('Upload') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="derived_accessions_saved_dialog_message" name="derived_accessions_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="derivedAccessionsSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="derivedAccessionsSavedDialog"><% __('Success') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% __('The derived accessions were saved successfully.') |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_derived_accessions_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% __('Close & Reload') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_derived_accessions_error_display" name="upload_derived_accessions_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadDerivedAccessionsErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadDerivedAccessionsErrorDialog"><% __('Upload Derived Accessions Error') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="derived_accession_upload_spreadsheet_info_dialog" name="derived_accession_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadDerivedAccessionsInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadDerivedAccessionsInfoDialog"><% __('Upload Template Information For Derived Accessions') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b><% __('Header:') |h %></b>
                    <br>
                    <% __('The first row (header) should contain the following:') |h %>
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>source_name</td>
                                <td>derived_accession_name</td>
                                <td>description</td>
                            </tr>
                        </tbody>
                    </table>

                    <b><% __('Required fields:') |h %></b>
                    <ul>
                        <li>source_name (must be in the database. Stock type can be accession, plant or tissue sample)</li>
                        <li>derived_accession_name (must NOT exist in the database)</li>
                        <li>description</li>
                    </ul>
                </div>
                <& /help/file_upload_type.mas, type => "Derived Accessions", optional_column => 0 &>
            </div>
            <div class="modal-footer">
                <button id="close_derived_accession_info_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
            </div>
        </div>
    </div>
</div>
