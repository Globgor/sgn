
<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<h4><% __('Sampling Trials') |h %></h4>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <table id="tissue_sample_sampling_trial_search_results" class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th><% __('Trial name') |h %></th>
                        <th><% __('Description') |h %></th>
                        <th><% __('Breeding program') |h %></th>
                        <th><% __('Folder') |h %></th>
                        <th><% __('Year') |h %></th>
                        <th><% __('Location') |h %></th>
                        <th><% __('Sampling Facility') |h %></th>
                        <th><% __('Sample Type') |h %></th>
                        <th><% __('Download') |h %></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function () {

   var geno_trial_table = jQuery('#tissue_sample_sampling_trial_search_results').DataTable( {
       'ajax': '/ajax/tissue_samples/sampling_trials',
   });

});

</script>
