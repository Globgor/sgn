
<%args>
$cross_id
$cross_name => ''
$breeding_program => undef
$progeny_count => undef
$trial_id => undef
$trial_name => undef
$user_id => undef
$identifier_prefix => ''
</%args>

<& /util/import_javascript.mas, classes => ["jquery", "jqueryui", "thickbox", "CXGN.Phenome.Tools", "CXGN.Page.FormattingHelpers", "jquery.cookie", "CXGN.List", "CXGN.BreederSearch", "CXGN.BreedersToolbox.CrossDetailPage" ] &>

% use utf8;
% $cross_name ||= "Untitled cross";
% my $basename = $cross_name."P";
% my $cross_properties = $c->config->{cross_properties};
% my @cross_props = split ',',$cross_properties;
% my $odk_crossing_data_service_name = $c->config->{odk_crossing_data_service_name};
% my $cross_additional_info_header_string = $c->config->{cross_additional_info_header};
% my @cross_additional_info_header = split ',',$cross_additional_info_header_string;
% my $cross_additional_info_string = $c->config->{cross_additional_info};
% my @cross_additional_info = split ',',$cross_additional_info_string;

<& /page/page_title.mas, title => "Details for cross '$cross_name'" &>

<&| /page/info_section.mas, title => $m->interp->apply_escapes( __("Cross information"), 'h' ) &>

    <div class="panel panel-default">
        <div class="panel-body">
            <div class="row">
                <div class="col-sm-6">
                    <& /page/form.mas,
                        object_type=>'cross',
                        object_id=> $cross_id,
                        form_name=> 'stock_form',
                        server_side_script => '/phenome/stock/stock_ajax_form.pl',
                        form_div_name=>'stock_details',
                        js_object_name=> 'stockForm',
                        page_url => "/cross/$cross_id" ,
                        alternate_new_button => '',
                        alternate_ghosted_new_button => '',
                        alternate_delete_button => '',
                        alternate_ghosted_delete_button => ''
                    &>
                </div>
                <div class="col-sm-6">
                    <br /><br />
                    <& /util/barcode.mas, identifier => "$identifier_prefix"."$cross_id", text=> "$identifier_prefix stock $cross_id ($cross_name)", format=>"stock_qrcode"  &>
                    <br /><br />
                </div>
            </div>
        </div>
    </div>

</&>

<div id="cross_name" style="visibility:hidden">
<% $cross_name %>
</div>

<div id="cross_id" style="visibility:hidden">
<% $cross_id %>
</div>


<& /util/import_javascript.mas, classes => ['jquery','jquery.dataTables'] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<&| /page/info_section.mas, title => $m->interp->apply_escapes( __('Member of'), 'h' ), collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "membership_table" class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th><% __('Crossing Experiment') |h %></th>
                                <th><% __('Description') |h %></th>
                                <th><% __('Family Name') |h %></th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, title => $m->interp->apply_escapes( __('Parents'), 'h' ), collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "parent_information" class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th><% __('Cross Combination') |h %></th>
                                <th><% __('Cross Type') |h %></th>
                                <th><% __('Female Accession') |h %></th>
                                <th><% __('Female Ploidy') |h %></th>
                                <th><% __('Male Accession') |h %></th>
                                <th><% __('Male Ploidy') |h %></th>
                                <th><% __('Female Plot') |h %></th>
                                <th><% __('Male Plot') |h %></th>
                                <th><% __('Female Plant') |h %></th>
                                <th><% __('Male Plant') |h %></th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

% my $edit_additional_info_link = "[Edit]";
% if ($user_id) { $edit_additional_info_link = '<a id="edit_additional_info_link">[Edit]</a>'; }

<div id="edit_additional_info_dialog">
    <select id="additional_info_select">
% foreach my $info(@cross_additional_info){
        <option value="<%$info%>"><%$info%></option>
%}
    </select>
    <input id="additional_info_value" />
    <button id="edit_additional_info_submit" ><% __('Save') |h %></button>
</div>


<&| /page/info_section.mas, title => $m->interp->apply_escapes( __('Additional Parent Info'), 'h' ), collapsible => 1, collapsed => 0, subtitle => $edit_additional_info_link &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "cross_additional_info" class="table table-hover table-striped">
                        <thead>
                            <tr>
% foreach my $additional_info(@cross_additional_info_header){
                                <th><%$additional_info%></th>
%}
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

% my $edit_link = "[Edit]";
% if ($user_id) { $edit_link = '<a id="edit_properties_link">[Edit]</a>'; }

<&| /page/info_section.mas, title => $m->interp->apply_escapes( __('Field Crossing Data'), 'h' ), collapsible => 1, collapsed => 0, subtitle => $edit_link &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                <table id = "cross_properties" class="table table-hover table-striped">
                    <thead>
                        <tr>
% foreach my $cross_prop(@cross_props){
                        <th><%$cross_prop%></th>
%}
                        </tr>
                    </thead>
                </table>
                </div>
            </div>
        </div>
    </div>
 </&>

<div id="edit_properties_dialog">

    <select id="properties_select">
% foreach my $cross_prop(@cross_props){
        <option value="<%$cross_prop%>"><%$cross_prop%></option>
%}
    </select>

    <input id="property_value" />

    <button id="property_submit" ><% __('Save') |h %></button>

    <p><& /util/sentence.mas, text => __x('{bold}WARNING!{end_bold} Changing the parameters can have unpredictable results in downstream analyses if they are inconsistent with other data.'), bold => '<b>', end_bold => '</b>' &></p>

</div>

<&| /page/info_section.mas, title => $m->interp->apply_escapes( __('Cross Transactions'), 'h' ), collapsible => 1, collapsed => 0, subtitle => $m->interp->apply_escapes( __('View crossing activities of this cross'), 'h' )&>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "cross_transactions" class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th><% __('Transaction ID') |h %></th>
                                <th><% __('Operator') |h %></th>
                                <th><% __('Timestamp') |h %></th>
                                <th><% __('Number of Flowers') |h %></th>
                                <th><% __('Number of Fruits') |h %></th>
                                <th><% __('Number of Seeds') |h %></th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

% if ($odk_crossing_data_service_name eq 'ONA') {
    <&| /page/info_section.mas, id=>'tissue_culture_summary_section', title => $m->interp->apply_escapes( __('Tissue culture IDs of this Cross'), 'h' ), collapsible=>1, collapsed=>1, subtitle => $m->interp->apply_escapes( __('View tissue culture IDs in each step (e.g., embryo IDs, subculture IDs, rooting IDs, weaning1 IDs)'), 'h' )&>
        <div class="well well-sm">
            <div class="panel panel-default">
                <div class="panel-body">
                    <div style="overflow:scroll">
                        <table id="tissue_culture_summary_table" class="table table-hover table-striped">
                            <thead>
                                <tr>
                                    <th><% __('Embryo IDs') |h %></th>
                                    <th><% __('Subculture IDs') |h %></th>
                                    <th><% __('Rooting IDs') |h %></th>
                                    <th><% __('Weaning1 IDs') |h %></th>
                                    <th><% __('Weaning2 IDs') |h %></th>
                                    <th><% __('Screenhouse IDs') |h %></th>
                                    <th><% __('Hardening IDs') |h %></th>
                                    <th><% __('Openfield IDs') |h %></th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>
% }

<& /breeders_toolbox/seedlots_section.mas, stock_id=>$cross_id, stock_type=>'cross', stock_uniquename=>$cross_name &>

% my $add_progeny_link = "[add progeny]";
% if ($user_id) { $add_progeny_link= '<a id="add_more_progeny_link">[add progeny]</a>'; }

<&|  /page/info_section.mas, title => $m->interp->apply_escapes( __("Progeny"), 'h' ), collapsible => 1, collapsed => 0, subtitle => $add_progeny_link   &>

    <div id="progeny_information_div">
        <% __('[loading...]') |h %>
    </div>

    <div id="add_more_progeny_dialog">
        <table>
            <tr><td><% __('Basename') |h %></td><td><input type="input" id="basename" name="basename" value="<% $basename %>" /></td></tr>
            <tr><td><% __('Start number') |h %></td><td><input type="input" id="start_number" name="start_number" size="5" value="<% $progeny_count + 1 %>" /></td></tr>
            <tr><td><% __('How many?') |h %></td><td><input type="input" id="progeny_count" name="progeny_count" size="5" /></td></tr>
        </table>
    </div>


</&>

<&|  /page/info_section.mas, title => $m->interp->apply_escapes( __("Delete cross"), 'h' ), collapsible => 1, collapsed => 0, subtitle => '<font color="red">Deletion cannot be undone</font>'  &>

<button id="delete_cross_button" class="btn btn-default"><% __('Delete') |h %></button>

</&>

<script>

jQuery(document).ready( function() {
    jQuery('#delete_cross_button').click( function() {
        var response = confirm(<% __('Really delete this cross? This action cannot be undone.') |js %>);
        if (response) {
            jQuery.ajax( {
                url: '/ajax/cross/delete',
                data: { 'cross_id' : <% $cross_id %>},
                method: 'POST',
                error: function(r) { alert(<% __('An error occurred.') |js %>); },
                success: function(r) {
                    if (r.error) {
                        alert(r.error);
                    } else {
                        alert(<% __('Deletion was successful.') |js %>);
                    }
                }
            });
        }
    });
});

</script>
