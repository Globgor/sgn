<%args>
$family_id
$family_type
</%args>

<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<div style="overflow:scroll">
    <table class="table table-hover table-bordered" id="family_parent_information">
        <thead>
            <tr>
% if ($family_type eq 'same_parents') {
                        <th><% __('Female Parent') |h %></th>
                        <th><% __('Female Stock Type') |h %></th>
                        <th><% __('Female Ploidy') |h %></th>
                        <th><% __('Male Parent') |h %></th>
                        <th><% __('Male Stock Type') |h %></th>
                        <th><% __('Male Ploidy') |h %></th>
% } elsif ($family_type eq 'reciprocal_parents') {
                        <th><% __('Parent 1') |h %></th>
                        <th><% __('Parent 1 Stock Type') |h %></th>
                        <th><% __('Parent 1 Ploidy') |h %></th>
                        <th><% __('Parent 2') |h %></th>
                        <th><% __('Parent 2 Stock Type') |h %></th>
                        <th><% __('Parent 2 Ploidy') |h %></th>
%}
            </tr>
        </thead>
    </table>
</div>

<script>

jQuery(document).ready(function(){
    const family_id = "<%$family_id%>";
    const family_parent_table = jQuery('#family_parent_information').DataTable({
        'ajax': '/ajax/family/parent_info/'+family_id,
        'paging' : false,
        'searching' : false,
        'destroy' : true,
        "bLengthChange" : false,
        'bInfo' : false,
        'autoWidth': false,
    });

});

</script>
