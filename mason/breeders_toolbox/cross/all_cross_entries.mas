<%args>

</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<a href="/search/download_cross_entries" class="btn btn-sm btn-default"><% __('Download All Cross Entries') |h %></a>
</br>
</br>
<div style="overflow:scroll">
    <table class="table table-hover table-bordered" id="all_cross_entries_table">
    </table>
</div>


<script>

jQuery(document).ready(function(){

    jQuery('#all_cross_entries_section_onswitch').click(function(){
        jQuery('#all_cross_entries_table').DataTable({
            'destroy': true,
            'ajax':'/ajax/search/all_cross_entries',
            columns: [
                { title: <% __('Cross Unique ID') |js %>, "data": null, "render": function ( data, type, row ) { return "<a href='/cross/"+row.cross_id+"'>"+row.cross_name+"</a>"; } },
                { title: <% __('Cross Type') |js %>, "data": "cross_type" },
                { title: <% __('Female Parent') |js %>, "data": null, "render": function ( data, type, row ) { return "<a href='/stock/"+row.female_id+"/view'>"+row.female_name+"</a>"; } },
                { title: <% __('Female Ploidy') |js %>, "data": "female_ploidy" },
                { title: <% __('Female Genome Structure') |js %>, "data": "female_genome_structure" },
                { title: <% __('Male Parent') |js %>, "data": null, "render": function ( data, type, row ) {
                    if (row.male_parent_id === null){
                        return 'NA';
                    } else {
                        return "<a href='/stock/"+row.male_id+"/view'>"+row.male_name+"</a>";
                    }
                }},
                { title: <% __('Male Ploidy') |js %>, "data": "male_ploidy" },
                { title: <% __('Male Genome Structure') |js %>, "data": "male_genome_structure" },
                { title: <% __('Pollination Date') |js %>, "data": "pollination_date" },
                { title: <% __('Number of Seeds') |js %>, "data": "number_of_seeds" },
                { title: <% __('Number of Progenies') |js %>, "data": "progeny_count" },
                { title: <% __('Crossing Experiment') |js %>, "data": null, "render": function ( data, type, row ) { return "<a href='/breeders/trial/"+row.project_id+"'>"+row.project_name+"</a>"; } },
                { title: <% __('Description') |js %>, "data": "project_description" },
                { title: <% __('Location') |js %>, "data": "project_location" },
            ],
        });
    });

});

</script>
