<%args>

$breeding_program_name
$breeding_program_id
$locations_by_program_json

</%args>

<div class="modal fade" id="upload_cross_seedlot_dialog" name="upload_cross_seedlot_dialog" tabindex="-1" role="dialog" aria-labelledby="seedlot_upload_dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="seedlot_upload_dialog"><% __('Upload Seedlots') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /util/workflow.mas, id=> "upload_seedlot_main_workflow" &>
                        <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Intro"), 'h' ) &>
                            <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("What are seedlots?"), 'h' ) &>
                            <ul>
                                <li><% __('A seedlot is a collection of seeds harvested from a cross, accession, plot or plant.') |h %></li>
                                <li><% __('Seedlots can have a specific location, box, weight(g), and count.') |h %></li>
                                <li><% __('Seedlots can belong to breeding programs and organizations.') |h %></li>
                            </ul>
                            <br/><br/>
                            <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this);"><% __('Go to Next Step') |h %></button>
                            </center>
                    </&>
                    <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("File format"), 'h' ) &>
                        <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Make sure your file matches the correct file format"), 'h' ) &>
                            <br/><br/>
                            <center>
                                <div id="upload_crosses_seedlots_template_section" style="display:none">
                                    <button class="btn btn-info" id ="guided_help_crosses_seedlots_upload_format_button" name ="guided_help_crosses_seedlots_upload_format_button"><% __('Information about file format for uploading seed lots harvested') |h %></button><br/><br/>
                                </div>
                                    <button class="btn btn-primary" onclick="Workflow.complete(this);"><% __('Once you think your file matches, go to Next Step') |h %></button>
                            </center>
                    </&>
                    <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Upload seedlots"), 'h' ) &>
                        <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Provide basic information about the seedlots and upload your file"), 'h' ) &>
                        <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_cross_seedlot_form" name="upload_cross_seedlot_form">
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Breeding Program:') |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" name="upload_seedlot_breeding_program_name" id="upload_seedlot_breeding_program_name" disabled value="<% $breeding_program_name %>">
                                    <input name="upload_seedlot_breeding_program_id" id="upload_seedlot_breeding_program_id" type="hidden" value="<% $breeding_program_id %>">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Location of seedlot storage:') |h %> </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" name="upload_seedlot_location" id="upload_seedlot_location"></select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Organization Name:') |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" name="upload_seedlot_organization_name" id="upload_seedlot_organization_name" placeholder="<% __('Optional') |h %>">
                                </div>
                            </div>
                            <div id="upload_seedlots_harvested_section" style="display:none">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% __('Upload File (.xls or .xlsx):') |h %> </label>
                                    <div class="col-sm-9" >
                                        <input type="file" name="seedlot_harvested_uploaded_file" id="seedlot_harvested_uploaded_file" encoding="multipart/form-data" />
                                    </div>
                                </div>
                            </div>
                            <div id="upload_seedlot_breeding_program_id" style="visibility:hidden">
                                <% $breeding_program_id %>
                            </div>
                        </form>
                        <center>
                            <button type="button" class="btn btn-lg btn-primary" onclick="Workflow.complete(this, false);" id ="upload_cross_seedlot_button" name="upload_cross_seedlot_button" ><% __('Upload Seedlots') |h %></button><br/><br/>
                        </center>
                    </&>
                    <&| /util/workflow.mas:complete, title=> $m->interp->apply_escapes( __("Complete"), 'h' ) &>
                        <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Finished! Your seedlots are now in the database"), 'h' ) &>
                            <p>
                                <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                <% __('The seedlot file was uploaded successfully') |h %>
                            </p>
                            <ul>
                                <li><% __('You may want to proceed to the seedlot detail page(s) for the seedlot(s) you just created.') |h %></li>
                                <li><% __('You can print barcodes for the seedlots.') |h %></li>
                            </ul>
                            <br/>
                            <center>
                                <button class="btn btn-primary" name="upload_seedlot_success_complete_button"><% __('The seedlots were saved to the database with no errors! Congrats Click Here') |h %></button><br/><br/>
                            </center>
                        </&>
                    </&>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_seedlot_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="crosses_seedlots_upload_spreadsheet_info_dialog" name="crosses_seedlots_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadSeedlotHarvestedInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadSeedlotHarvestedInfoDialog"><% __('Upload Template Information For Seedlots From Crosses') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b><% __('Seedlots may be uploaded in an Excel file (.xls or .xlsx)') |h %></b>
                    <br />
                    <b><% __('Header:') |h %></b>
                    <br>
                        <% __('The first row (header) must contain the following:') |h %>
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>seedlot_name</td>
                                <td>cross_unique_id</td>
                                <td>operator_name</td>
                                <td>amount</td>
                                <td>weight(g)</td>
                                <td>description</td>
                                <td>box_name</td>
                            </tr>
                        </tbody>
                    </table>
                    <b><% __('Required fields:') |h %></b>
                    <ul>
                        <li>seedlot_name (must be unique)</li>
                        <li>cross_unique_id (must exist in the database. a cross_unique_id can represent a cross between accessions e.g. AxB, but a cross can also represent a cross between specific plots in the field if you have this information)</li>
                        <li>operator_name (the name of the person who oversaw the inventory process. can be any name.)</li>
                        <li>amount (number of seeds in seedlot. can be provided in conjunction with weight(g). must provide a value for amount or weight(g) or both.)
                            <br/><b>AND/OR</b><br/>
                            weight(g) (weight in grams of seedlot. can be provided in conjunction with amount. must provide a value for amount or weight(g) or both.)
                        </li>
                        <li>box_name (the box name that the seed is located in. can be any name.)</li>
                    </ul>

                    <b><% __('Optional fields:') |h %></b>
                    <ul>
                        <li>description (additional information about each seedlot)</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_seedlot_harvested_info_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_cross_seedlot_error_display" name="upload_cross_seedlot_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadCrossSeedlotErrorDialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="uploadCrossSeedlotErrorDialog"><% __('Upload Seedlot File Error') |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
	  <table>
    	  <tbody></tbody>
  	  </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
      </div>
    </div>
  </div>
</div>


<script>
jQuery(document).ready(function(){

    var locations_array = <% $locations_by_program_json %>;

    jQuery('#upload_seedlots_from_crosses').click( function() {
        jQuery('#upload_cross_seedlot_dialog').modal('show');

        var html = '<select id = "upload_seedlot_location" >';
        for (var i=0; i<locations_array.length; i++) {
            html += `<option value="${locations_array[i]}">${locations_array[i]}</option>`;
        }
        html = html + "</select>";

        jQuery('#upload_seedlot_location').html(html);

    });

    jQuery('#upload_crosses_seedlots_template_section').show();

    jQuery('#upload_seedlots_harvested_section').show();

    jQuery('#guided_help_crosses_seedlots_upload_format_button').click( function () {
        jQuery('#crosses_seedlots_upload_spreadsheet_info_dialog').modal("show");
    });

    jQuery('#upload_cross_seedlot_button').click(function () {
        upload_crosses_seedlots();
    });

    function upload_crosses_seedlots() {
        var uploadSeedlotsHarvestedFile = jQuery("#seedlot_harvested_uploaded_file").val();
        var location = jQuery("#upload_seedlot_location").val();
        var breeding_program = jQuery("#upload_seedlot_breeding_program_id").val();
        jQuery('#upload_cross_seedlot_form').attr("action", "/ajax/breeders/seedlot-upload");
        if (breeding_program === '') {
            alert(<% __('Please choose a breeding program') |js %>);
            return;
        }
        if (location === '') {
            alert(<% __('Please give a location') |js %>);
            return;
        }
        if (uploadSeedlotsHarvestedFile == '') {
            alert(<% __('Please select a file') |js %>);
            return;
        }
        jQuery("#upload_cross_seedlot_form").submit();
    }

    jQuery('#upload_cross_seedlot_form').iframePostForm({
        json: true,
        post: function () {
        var uploadSeedlotsHarvestedFile = jQuery("#seedlot_harvested_uploaded_file").val();
            jQuery('#working_modal').modal("show");
            if (uploadSeedlotsHarvestedFile == '') {
                jQuery('#working_modal').modal("hide");
                alert(<% __('No file selected') |js %>);
            }
        },
        complete: function(response) {
            jQuery("#working_modal").modal("hide");
            if (response.error_string) {
                jQuery('#upload_cross_seedlot_error_display').modal("show");
                jQuery('#upload_cross_seedlot_error_display tbody').html('');
                jQuery('#upload_cross_seedlot_error_display tbody').append(response.error_string);
                return;
            }
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                Workflow.focus("#upload_seedlot_main_workflow", -1); //Go to success page
                Workflow.check_complete("#upload_seedlot_main_workflow");

            }
        }
    });

    jQuery(document).on('click', '[name="upload_seedlot_success_complete_button"]', function(){
        alert(<% __('Seedlots were saved in the database') |js %>);
        jQuery('#upload_seedlot_dialog').modal('hide');
        //location.reload();
    });

});


</script>
