<%doc>Accession Tracker</%doc>

<& /util/import_javascript.mas, classes => ['jquery', 'CXGN.BreedersToolbox.HTMLSelect'], entries => ['decision_meeting'] &>

<div class="well">
  <&| /page/info_section.mas,
     title=>$m->interp->apply_escapes( __('Accession — Decision Tracker'), 'h' ),
     is_subsection=>1, collapsible=>1, collapsed=>0,
     subtitle=>$m->interp->apply_escapes( __('Track decisions per accession. Use the per-column filters below the header.'), 'h' )
  &>
    <div class="panel panel-default">
      <div class="panel-body">
        <div class="form-inline" style="margin-bottom:10px;">
          <!-- Breeding Program checkbox dropdown placeholder -->
          <div id="bp_filter_placeholder" class="btn-group" style="margin-left:12px;">
            <!-- JS will inject checkbox dropdown here -->
          </div>
        </div>
        <div class="table-responsive">
          <table id="decision_table" class="table table-striped table-bordered" width="100%">
            <thead>
              <tr>
                <th><% __('Accession') |h %></th>
                <th>Breeding Program</th>
                <th><% __('Stage') |h %></th>
                <th><% __('Year') |h %></th>
                <th><% __('Decision') |h %></th>
                <th><% __('New Stage') |h %></th>
                <th><% __('Female Parent') |h %></th>
                <th><% __('Male Parent') |h %></th>
                <th><% __('Notes') |h %></th>
              </tr>
            </thead>
          </table>
        </div>

      </div>
    </div>
  </&>

  <&| /page/info_section.mas,
       title=>$m->interp->apply_escapes( __('Data Summary and Graphics'), 'h' ),
       is_subsection=>1, collapsible=>1, collapsed=>0,
       subtitle=>""
    &>
    <div class="panel panel-default">
      <div class="panel-body">
        <div class="form-inline" style="margin-bottom:10px;">
          <label for="dataset_select" class="control-label" style="margin-right:8px;"><% __('Select a Dataset:') |h %></label>
          <span id="dataset_select" style="display:inline-block; min-width:240px;"></span>
        </div>
        <div class="panel-body">
          <div class="table-responsive">
            <table id="summary_table" class="table table-striped table-bordered" width="100%">
              <thead>
                <tr>
                  <th><% __('Accession') |h %></th>
                  <th><% __('Trait') |h %></th>
                  <th><% __('Min') |h %></th>
                  <th><% __('Max') |h %></th>
                  <th><% __('Average') |h %></th>
                  <th><% __('Std') |h %></th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </&>

</div>
