<%doc>Decision Meeting</%doc>

<div class="well">

  <&| /page/info_section.mas,
       title=>$m->interp->apply_escapes( __('Meeting Tracker'), 'h' ),
       is_subsection=>1, collapsible=>1, collapsed=>0,
       subtitle=>$m->interp->apply_escapes( __('View Meetings Record'), 'h' )
  &>
    <div class="panel panel-default">
      <div class="panel-body">
        <div class="table-responsive">
          <table id="meeting_table" class="table table-striped table-bordered" width="100%">
            <thead>
              <tr>
                <th><% __('Select') |h %></th>
                <th><% __('Meeting') |h %></th>
                <th><% __('Programs') |h %></th>
                <th><% __('Date') |h %></th>
                <th><% __('Location') |h %></th>
                <th><% __('Attendees') |h %></th>
                <th><% __('Download') |h %></th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>
  </&>
</div>