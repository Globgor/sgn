
<%args>
$trial_id
$genotyping_facility

</%args>

<div class="modal fade" id="submit_plate_dialog" name="submit_plate_dialog" tabindex="-1" role="dialog" aria-labelledby="SendPlateToFacilityDialog">
    <div class="modal-dialog " role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="SendPlateToFacilityDialog"><% __('Submit genotyping plates to facility') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="submit_plate_form" name="submit_plate_form">

                        <&| /util/workflow.mas, id=> "plates_to_facilities_workflow" &>
                            <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Plate info"), 'h' ) &>
                                                        <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Plate information"), 'h' ) &>
                      <div class="form-group">
                        <label class="col-sm-3 control-label"><% __('Plate ID:') |h %> </label>
                        <div class="col-sm-9" id="plate_id">
                        </div>
                      </div>
                      <div class="form-group">
                        <label class="col-sm-3 control-label"><% __('Genotyping Plate:') |h %> </label>
                        <div class="col-sm-9" id="plate_name">
                        </div>
                      </div>
                      <div class="form-group">
                        <label class="col-sm-3 control-label"><% __('Plate format:') |h %> </label>
                        <div class="col-sm-9" id="plate_format">
                        </div>
                      </div>
<!--                       <div class="form-group">
                        <label class="col-sm-3 control-label">Number of samples: </label>
                        <div class="col-sm-9" id="number_samples">
                        </div>
                      </div> -->
                        <div style="text-align: center">
                            <button class="btn btn-primary" id="facility_info_link" onclick="Workflow.complete(this); return false;"><% __('Go to Next Step') |h %></button>
                        </div>
                    </&>
                    <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Facility"), 'h' ) &>
                    <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Facility information"), 'h' ) &>

                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% __('Genotyping Facility:') |h %> </label>
                            <div class="col-sm-9" id="genotyping_facility">
                            </div>
                        </div>
                        <div class="form-group">
                        <label class="col-sm-3 control-label"><% __('Organism name:') |h %> </label>
                        <div class="col-sm-9">
                            <select class="form-control" id="organism_name">
                            </select>
                        </div>
                      </div>
                      <div class="form-group">
                        <label class="col-sm-3 control-label"><% __('Facility Service ID:') |h %> </label>
                        <div class="col-sm-9">
                            <select class="form-control" id="service_id_select" multiple>
                            </select>
                        </div>
                      </div>
                      <div class="form-group">
                        <label class="col-sm-3 control-label"><% __('Client ID:') |h %> </label>
                        <div class="col-sm-9">
                            <input class="form-control" id="client_id" name="client_id"></input>
                        </div>
                      </div>
                      <div class="form-group">
                        <label class="col-sm-3 control-label"><% __('Sample type:') |h %> </label>
                        <div class="col-sm-9" id="sample_type">
                        </div>
                      </div>
                      <div class="form-group" id="required_services">
                        <label class="col-sm-4 control-label"><% __('Required Service Info:') |h %> </label>
                      </div>
                      <div style="text-align: center">
                            <button class="btn btn-primary" id="review_order_link" onclick="Workflow.complete(this); return false;"><% __('Go to Next Step') |h %></button>
                      </div>
                      <br/><br/>
                       </&>
                       <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Review"), 'h' ) &>
                        <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Review order"), 'h' ) &>

                        <div class="panel panel-default">
                            <div class="panel-body">
                                <& /breeders_toolbox/genotyping_trials/layout_as_list.mas, trial_id => $trial_id, genotyping_plate_format => '96' &>
                            </div>
                        </div>
                        <div style="text-align: center">
                            <button class="btn btn-primary" onclick="Workflow.complete(this); return false;"><% __('Go to Next Step') |h %></button>
                        </div>
                    </&>
                    <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Confirm"), 'h' ) &>
                        <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Submit your genotyping plate"), 'h' ) &>

                        <div class="form-group">
                            <label class="col-sm-12"><% __('I want to automatically submit to the Genotyping Facility:') |h %> </label><label class="col-sm-12" id="facility_url_lbl"></label>
                            <div class="col-sm-12" align="center">
                                <select class="form-control" style="width: 200px" id="genotyping_trial_facility_submit_select">
                                    <option value="1" selected=""><% __('No') |h %></option>
                                    <option value="0"><% __('Yes') |h %></option>
                                </select>
                            </div>
                        </div>
                        <hr>
                        <div style="text-align: center">
                            <button type="button" class="btn btn-primary" onclick="Workflow.complete(this, false);" name="submit_plate_btn" id="submit_plate_btn" disabled><% __('Submit genotyping plate') |h %></button>
                        </div>
                    </&>
                    <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Finalize"), 'h' ) &>
                        <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Finalize your order"), 'h' ) &>
                        <p>Submission Id: <b><label id="submission_lbl"></label></b></p>
                        <p><& /util/sentence.mas, text => __x('Please click {link}HERE{end_link} to complete your order.'), link => '<a id="facility_href" target="_blank">', end_link => '</a>' &> </p><br><br>
                        <p><% __('After order has been complete click continue.') |h %></p>
                        <div style="text-align: center">
                            <button type="button" class="btn btn-primary" onclick="Workflow.complete(this, false);" name="continue_submission_btn" id="continue_submission_btn"><% __('Continue') |h %></button>
                        </div>
                    </&>
                    <&| /util/workflow.mas:complete, title=> $m->interp->apply_escapes( __("Complete"), 'h' ) &>
                        <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Complete!"), 'h' ) &>

                            <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                            <p><% __('Order complete.') |h %></p>
                            <!-- Facility Order Id: <b><label id="order_lbl"></label></b><br><br> -->
                            <li><% __('You may want to proceed to the genotyping plate detail page to check order status.') |h %></li>

                        <br/>
                    </&>

                    </&>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="submit_plate_dialog" type="button" class="btn btn-default" data-dismiss="modal" onclick="location.reload();"><% __('Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal  fade" id="plate_to_facilities_dialog_message" name="plate_to_facilities_dialog_message" tabindex="-1" role="dialog" aria-labelledby="HmDialog">
    <div class="modal-dialog " role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="HmDialog"><b><% __('Submit genotyping plate') |h %></b></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <p3> <% __('Genotyping plates was submit successfully...') |h %></p3>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_message_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>

            </div>
        </div>
    </div>
</div>
