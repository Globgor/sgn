
<%args>
$genotyping_trial_ids
</%args>

<div class="modal fade" id="download_genotyping_trial_layouts_dialog" name="download_genotyping_trial_layouts_dialog" tabindex="-1" role="dialog" aria-labelledby="downloadGenotypingTrialLayoutsDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="downloadGenotypingTrialLayoutsDialog"><% __('Download Genotyping Plate Layouts') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                <a href="/breeders/trials/download/layout?format=csv&dataLevel=plate&genotyping_trial_id_list=<% $genotyping_trial_ids %>" class="btn btn-default"><% __('Download Breedbase Formatted File') |h %></a><br/><br/>
                <a href="/breeders/trials/download/layout?format=intertekxls&dataLevel=plate&genotyping_trial_id_list=<% $genotyping_trial_ids %>" class="btn btn-default"><% __('Download Intertek Formatted File') |h %></a><br/><br/>
                <a href="/breeders/trials/download/layout?format=dartseqcsv&dataLevel=plate&genotyping_trial_id_list=<% $genotyping_trial_ids %>" class="btn btn-default"><% __('Download DartSeq Formatted File') |h %></a>

            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-default" name="download_genotyping_trial_layouts_cancel_button" id="download_genotyping_trial_layouts_cancel_button" data-dismiss="modal"><% __('Close') |h %></button>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function() {

    jQuery('#folder_download_genotyping_plates_button').click( function () {
% if ($genotyping_trial_ids) {
        jQuery('#download_genotyping_trial_layouts_dialog').modal('show');
% } else {
        alert(<% __('There are no genotyping layouts in this folder!') |js %>);
% }
    });

});

</script>
