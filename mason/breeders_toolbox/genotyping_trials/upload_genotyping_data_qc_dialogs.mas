<%args>
$facilities
</%args>

<& /util/import_javascript.mas, classes => [ 'CXGN.BreedersToolbox.GenotypingTrial' ] &>

<div class="modal fade" id="upload_genotypes_qc_dialog" name="upload_genotypes_qc_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadGenotypesQCDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadGenotypesQCDialog"><% __('Upload Genotypes QC') |h %></h4>
            </div>
            <div class="modal-body">
                <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_genotypes_qc_form" name="upload_genotypes_qc_form" action="/ajax/genotype_qc/upload">

                    <div class="container-fluid">

                        <&| /util/workflow.mas, id=> "upload_genotypes_qc_workflow" &>
                            <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Intro"), 'h' ) &>
                                <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("This workflow will guide you through genotype QC"), 'h' ) &>

                                <ul>
                                    <li><% __('Genotype QC does not save your genotypes in the database, it only scans them against genotyping protocols already saved in the database.') |h %></li>
                                    <li><% __('To actually store data into the database, please use "Upload Genotyping Data".') |h %></li>
                                    <li><% __('The marker names should be exactly the marker names that you want to compare against and not any other ID') |h %></li>
                                </ul>

                                <br/><br/>
                                <div style="text-align: center">
                                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;"><% __('Go to Next Step') |h %></button>
                                </div>
                            </&>

                            <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Genotype Protocol"), 'h' ) &>
                                <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Select the genotyping protocol you want to compare against"), 'h' ) &>

                                <ul>
                                    <li><% __('Select a genotyping protocol in the database against which you want to compare genotypes against.') |h %></li>
                                </ul>
                                <br/><br/>

                                <div id="genotype_qc_selected_protocol">
                                </div>

                                <br/><br/>
                                <div style="text-align: center">
                                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;"><% __('Go to Next Step') |h %></button>
                                </div>
                            </&>

                            <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Genotype Info"), 'h' ) &>
                                <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Provide genotype information"), 'h' ) &>
                                <br/><br/>

                                <div class="row">
                                    <div class="col-sm-4">
                                        <&| /page/explanation.mas, title=>$m->interp->apply_escapes( __('Template information'), 'h' ) &>
                                            <p>
                                                <b><% __('File format information') |h %></b>
                                                <br>
                                                <a id="upload_genotype_qc_spreadsheet_info_format"><% __('File format') |h %></a>
                                            </p>
                                        </&>
                                    </div>
                                    <div class="col-sm-8">
                                        <br/>
                                        <div class="panel panel-default">
                                            <div class="panel-body">
                                                <div class="form-group">
                                                    <label class="col-sm-6 control-label"><% __('Select File:') |h %> </label>
                                                    <div class="col-sm-6">
                                                        <input type="file" name="upload_genotype_qc_file_input" id="upload_genotype_qc_file_input" encoding="multipart/form-data" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <br/><br/>
                                <div style="text-align: center">
                                    <button class="btn btn-primary" id="genotype_qc_upload_submit_button"><% __('Submit') |h %></button>
                                </div>
                            </&>
                            <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Results"), 'h' ) &>
                                <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("A similarity matrix between the samples in your file and the saved genotypes for the protocol you selected"), 'h' ) &>

                                <div id="genotype_qc_result_div"></div>

                            </&>
                        </&>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_genotype_qc_spreadsheet_info_format_dialog" name="upload_genotype_qc_spreadsheet_info_format_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadGenotypeQCInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadGenotypeQCInfoDialog"><% __('Upload Genotype QC Template Information') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b><% __('This is for uploading genotype QC data.') |h %></b>
                    <br/>
                    <b><% __('Please use CSV formatted files') |h %></b>
                    <p>
                    <br />
                    <b><% __('Header:') |h %></b>
                    <br>

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>SampleName.LabID</td>
                                <td>Separate Column For Each Marker Name (e.g. S12_7926132)</td>
                            </tr>
                        </tbody>
                    </table>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_upload_genotyping_qc_spreadsheet_info_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
            </div>
        </div>
    </div>
</div>


<style>

.ui-autocomplete { z-index:2147483647; }

</style>

<script>
jQuery(document).ready(function(){

    jQuery('button[name=upload_genotyping_data_qc_link]').click(function(){
        jQuery('#upload_genotypes_qc_dialog').modal('show');
    });

    get_select_box('genotyping_protocol','genotype_qc_selected_protocol', {'empty':'1', 'id':'genotype_qc_protocol_id', 'name':'genotype_qc_protocol_id'});

    jQuery('#upload_genotype_qc_spreadsheet_info_format').click(function(){
        jQuery('#upload_genotype_qc_spreadsheet_info_format_dialog').modal('show');
    });

    jQuery('#genotype_qc_upload_submit_button').click(function () {
        submit_genotype_data_qc_upload()
    });

    function submit_genotype_data_qc_upload() {
        jQuery('#working_modal').modal('show');
        jQuery("#upload_genotypes_qc_form").submit();
    }

    jQuery('#upload_genotypes_qc_form').iframePostForm({
        json: true,
        post: function () {
        },
        complete: function (response) {
            //console.log(response);
            jQuery('#working_modal').modal('hide');
            if (response.success) {

                var html = '<table class="table table-hover"><thead><tr><th>Samples In File</th>';
                for(var i=0; i<response.protocol_stock_names.length; i++) {
                    html = html + '<th>'+response.protocol_stock_names[i]+'</th>';
                }
                html = html + '</tr></thead><tbody>';
                for(var j=0; j<response.users_stock_names.length; j++) {
                    html = html + '<tr><td>'+response.users_stock_names[j]+'</td>';
                    for(var k=0; k<response.protocol_stock_names.length; k++) {
                        var distance = response.distance_matrix[response.users_stock_names[j]][response.protocol_stock_names[k]];
                        html = html + '<td>'+distance+'</td>';
                    }
                    html = html + '</tr>';
                }
                html = html + '</tbody></table>';
                jQuery('#genotype_qc_result_div').html(html);

                Workflow.complete('#genotype_qc_upload_submit_button');
                Workflow.focus("#upload_genotypes_qc_workflow", 3);
            }
        }
    });

});
</script>
