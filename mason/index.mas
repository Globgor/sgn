<%args>
$schema
$phenotype_files => undef
$breeding_programs => undef
$locations => undef
$preferred_species => undef
$editable_stock_props => {}
</%args>

      <div style="border:0px solid;text-align:center;">
            <!-- span style="font-face:arial;font-size:48pt;color:darkgreen;font-weight:light;">BREE<b>DB</b>ASE</span -->
	    <img src="/img/Breedbase_HighRes.png" width="400" />
      </div>

      <div>
	<h3><% __('What is Breedbase?') |h %></h3>
	<% __('Breedbase is a comprehensive breeding management and analysis software. It can be used to design field layouts, collect phenotypic information using tablets, support the collection of genotyping samples in a field, store large amounts of high density genotypic information, and provide Genomic Selection related analyses and predictions. Breedbase supports the BrAPI standard.') |h %>
	<h3><% __('How can I use Breedbase?') |h %></h3>
	<& /util/sentence.mas, text => __x('Breedbase is a web application that only requires a browser. To get your Breedbase instance, contact the {link}Breedbase development team{end_link}.'), link => '<a href="/contact/form">', end_link => '</a>' &>
	<h3><% __('What crops are using Breedbase?') |h %></h3>
	<& /util/sentence.mas, text => __x('There are a number of instances running for diverse crops, including Cassava ({cassava}), sweet potato ({sweet_potato}), banana ({banana}), rice ({rice}), tomato and other Solanaceae ({solanaceae}) and many others.'), cassava => '<a href="https://cassavabase.org/">https://cassavabase.org</a>', sweet_potato => '<a href="https://sweetpotatobase.org/">https://sweetpotatobase.org</a>', banana => '<a href="https://musabase.org/">https://musabase.org</a>', rice => '<a href="https://ricebase.org/">https://ricebase.org</a>', solanaceae => '<a href="https://solgenomics.net">https://solgenomics.net/</a>' &>
      </div>

      <h3><% __('How can I learn more about Breedbase?') |h %></h3>

      <& /util/sentence.mas, text => __x('You can watch the Breedbase workshops on {link}Youtube{end_link}, covering topics such as ontologies, trial design, data collection using fieldbook, data analysis, and genomic selection.'), link => '<a href="https://www.youtube.com/channel/UC3jrvvzGKKEHzOriDBgnj0A">', end_link => '</a>' &> 
      
      
<div class="container-fluid">
  <div class="row">
    <div class="col-sm-6 col-md-6 col-lg-6">
    </div>
      
      <div class="col-sm-6 col-md-6 col-lg-6">
        
      </div>
      
  </div>
</div>

% if ($phenotype_files) {
     <& homepage/phenotype_uploads.mas, phenotype_files=>$phenotype_files &>
% }

