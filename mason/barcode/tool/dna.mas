
<h1><% __('Cassavabase DNA extraction tool') |h %></h1>

<table>
<tr><th><% __('ROW') |h %></th><th><% __('COLUMN') |h %></th></tr>
<tr><td>
% foreach my $row ('A'..'H') { 
<& /barcode/tool/generate.mas, code=>$row &>
%}
</td><td>
% foreach my $col (1..12) { 
  <& /barcode/tool/generate.mas, code=>$col &>
%}
</td></tr></table>
