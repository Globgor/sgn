
<%args>
@locations
@projects
@available_cvterms
</%args>

<%perl>
use DateTime;
my $dt = DateTime->from_epoch( epoch=>time );
my $date = join "/", ($dt->year, $dt->month, $dt->day);
</%perl>

<form class="form-horizontal" role="form" method="GET" action="/barcode/multitool">
  <div class="form-group form-group-sm">
    <label class="col-sm-2 control-label"><% __('Operator:') |h %> </label>
    <div class="col-sm-10">
      <input type="text" class="form-control" id="operator" name="operator" />
    </div>
  </div>
  <div class="form-group form-group-sm">
    <label class="col-sm-2 control-label"><% __('Date:') |h %> </label>
    <div class="col-sm-10">
      <input type="text" class="form-control" id="date" name="date" value="<% $date %>" placeholder="Format: YYYY/MM/DD" />
    </div>
  </div>
  <div class="form-group form-group-sm">
    <label class="col-sm-2 control-label"><% __('Location:') |h %> </label>
    <div class="col-sm-10">
      <& /page/html_select.mas, name=>'location', choices=>\@locations &>
      <br/>[<a href="/breeders/locations"><% __('Add New Location') |h %></a>]
    </div>
  </div>
  <div class="form-group form-group-sm">
    <label class="col-sm-2 control-label"><% __('Project:') |h %> </label>
    <div class="col-sm-10">
      <& /page/html_select.mas, name=>'project', choices=>\@projects &>
      <br/>[<a href="/breeders/trials"><% __('Add New Project') |h %></a>]
    </div>
  </div>
  <div class="form-group form-group-sm">
    <label class="col-sm-2 control-label"><% __('Trait(s):') |h %> </label>
    <div class="col-sm-10">
      <select multiple class="form-control" id="cvterms" name="cvterms">
<%perl>
foreach my $t (@available_cvterms) {
   if ($t =~ /\#/) { next; }
   my ($cvterm, $version, $priority, $values, $description) = split /\t/, $t;
   if ($priority) { 
     print qq { <option value="$cvterm">$description</option> };
   }
}
</%perl>
      </select>

    </div>
  </div>
  <button style="float:right" type="submit" class="btn btn-info btn-sm" type="submit" value="generate form"><% __('Generate Form') |h %></button>
</form>

<br/>

