

<%args>
$error => undef
$file => ''
$filetype => ''
</%args>

<& /page/page_title.mas, title=>$m->interp->apply_escapes( __('Download Trial Barcodes'), 'h' ) &>

% if (!$error) {
  <% __('Success! Please click the link below to download the barcode label file.') |h %><br />
  <br /><br />
  <a target="_blank" href="<% $file %>" >Download <% $filetype %> file</a>
% }
% elsif ($error){
    <b><% __('Download Barcode Error:') |h %></b> <%$error%>
% }
