<%args>
  $default_ref_base => ''
</%args>
% my $items = Load( $m->content );
% delete $ARGS{$_} for qw( default_ref_base c );

<&| /page/info_section.mas, title => $m->interp->apply_escapes( __('Data Sets'), 'h' ), %ARGS &>
<ul>

% foreach my $item (@$items) {
  <li>
%    if( my $r = $item->{ref} ) {
%       unless( $r =~ m!^/! || $r =~ m!^(ht|f)tp://! ) { $r = "$default_ref_base/$r" }
        <a href="<% $r %>"><% $item->{text} %></a>
%    } else {
        <span class="ghosted"><% $item->{text} %></span>
          <div style="margin-left: 2em; font-size: 90%"><& /util/sentence.mas, text => __x('(file temporarily unavailable, contact {link}{name}{end_link} for details)'), link => '<a href="mailto:jr286@cornell.edu">', name => 'Joss Rose', end_link => '</a>' &></div>

%    }
  </li>
% }
</ul>
</&>

<%once>
  use YAML::Any;
</%once>
