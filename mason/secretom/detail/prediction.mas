<%args>
  $static_dir
  $signalp_search_action
</%args>

<style>
.species_predictions {
  margin-bottom: 3em;

}
.species_predictions h3 {
  font-size: 100%;
}
.species_predictions td {
  text-align: center;
}

span.filename {
  font-family: monospace;
}
span.filesize {
  font-weight: bold;
}
span.filesize:before {
  content: '(';
}
span.filesize:after {
  content: ')';
}

</style>

<& /page/page_title.mas, title => $m->interp->apply_escapes( __('Computational prediction of secreted proteins'), 'h' ) &>

<& /secretom/secretary/nav.mas, curr_page => 'background' &>

<div class="page_introduction">
  <p>

  <& /util/sentence.mas, text => __x('A number of {link}computational tools{end_link} have been developed to predict the presence of SPs.'), link => '<a class="tools_popup" href="#">', end_link => '</a>' &> <& /util/sentence.mas, text => __x('These programs have been greatly refined in recent years and their accuracy has improved with the adoption of machine learning algorithms.') &> <& /util/sentence.mas, text => __x('However, while this is a valuable approach, as with all prediction-based tools, there is a consistent error rate and both false positive and negative predictions should be expected.') &> <& /util/sentence.mas, text => __x('One of our major goals is to identify the incorrect predictions and generate a database of computationally and functionally confirmed secreted plant proteins.') &> <& /util/sentence.mas, text => __x('It has been reported that one of the most effective predictors of SPs is {link}SignalP 3.0{end_link}.'), link => '<a
  href="http://www.cbs.dtu.dk/services/SignalP">', end_link => '</a>' &> 
  <& /util/sentence.mas, text => __x('We have used both SignalP and our recently developed predictor, {link}SecreTary{end_link}, to screen the predicted proteomes of several plant species to date.'), link => '<a href="/secretom/secretary">', end_link => '</a>' &> <& /util/sentence.mas, text => __x('See below for these prediction results.') &>
  </p>

</div>

<&| /page/info_section.mas, title => $m->interp->apply_escapes( __('New predictor: Secretary'), 'h' ) &>

  <p>
  <& /util/sentence.mas, text => __x('We have developed a new predictor, {link}SecreTary{end_link}, for more accurate computational prediction of plant proteins that traffic through the classical secretory pathway. {link}Try SecreTary{end_link},'), link => '<a href="/secretom/secretary">', end_link => '</a>' &>
  </p>

</&>

<&| /page/info_section.mas, title => $m->interp->apply_escapes( __('SecreTary, SignalP, TargetP results'), 'h' ) &>

  <table class="species_predictions">
  <tr>
    <td>
          <h3>Arabidopsis thaliana</h3>
          <img src="/img/secretom/arabidopsisthaliana.png" />
          <& .result_file, file => 'data/secretom/SecreTarySPTP_predictions/Tair10.STsptp.fa', dir => $static_dir &>
    </td>
     <td>
          <h3>Rice (Oryza sativa)</h3>
          <img src="/img/secretom/oryzasativa.png" />
          <& .result_file, file => 'data/secretom/SecreTarySPTP_predictions/TIGR6.1.STsptp.fa', dir => $static_dir &>
    </td>
    <td>
          <h3>Brachypodium distachyon</h3>
          <img src="/img/secretom/brachypodiumdistachyon.png" />
          <& .result_file, file => 'data/secretom/SecreTarySPTP_predictions/Brachy1.2.STsptp.fa', dir => $static_dir &>
    </td>
    <td>
          <h3>Tomato </h3>
          <img src="/img/secretom/solanumlycopersicum.png" />
          <& .result_file, file => 'data/secretom/SecreTarySPTP_predictions/ITAG2.STsptp.fa', dir => $static_dir &>
    </td>
  
 <td>
          <h3>Populus trichocarpa</h3>
          <img src="/img/secretom/Populus_trichocarpa_126x150.png" />
          <& .result_file, file => 'data/secretom/SecreTarySPTP_predictions/Poptri2.STsptp.fa', dir => $static_dir &>
    </td>


</tr>
  </table>

  <&| /page/info_section.mas, title => $m->interp->apply_escapes( __('Search SecreTary, SignalP, TargetP results for secreted proteins'), 'h' ), is_subsection => 1 &>


    <form method="GET" style="text-align: center; margin: 2em auto" action="<% $signalp_search_action %>">
      <label for="query_input"><% __('Search') |h %></label>
      <input type="text" size="30" name="q" id="query_input" value="" />
      <input type="hidden" name="file" value="" />
      <input type="submit" value="<% __('Search') |h %>" size="20" />
    </form>

    <p>
    Use text terms (e.g. "polygalacturonase", "glycosyl hydrolase
    family", "gh9"), or locus names (e.g. "At1G65610.1"). <& /util/sentence.mas, text => __x('This will provide you with a list of predicted proteins, grouped by species, with the annotation protein length, molecular weight, confidence scores for the presence of a secretory signal peptide and predicted localization.') &>
    </p>
    
  </&>
</&>

<& /util/import_javascript.mas, classes => 'jquery.colorbox' &>
<script>
  jQuery(".tools_popup").colorbox({width:"60%", inline:true, href:"#tools_popup"});
</script>
<div id="tools_popup">
<&| /page/info_section.mas, title => $m->interp->apply_escapes( __('Other computational tools for prediction of ER-targeting signal peptides'), 'h' ) &>
  <ul>
  <li><a href="http://www.cbs.dtu.dk/services/SignalP">SignalP</a></li>
  <li><a href="http://www.predisi.de">PrediSi</a></li>
  <li><a href="http://rpsp.bioinfo.pl/">Rapid Prediction of Signal Peptides (RPSP)</a></li>
  <li><a href="http://phobius.sbc.su.se/">Phobius</a></li>
  <li><a href="http://urgi.versailles.inra.fr/predotar/predotar.html">Predotar</a></li>
  </ul>
</&>
</div>



<%def .result_file>

<%args>
$file
$dir
</%args>
% $file .= '.gz';
% my $abs = file( $dir, $file );
% my $size = -s $abs;
% if( $size ) {
    <span class="filename"><% $abs->basename %></span>

    <div>
      <a href="/download/<% file($file)->as_foreign('Unix') %>"><% __('[Download]') |h %></a>
      <span class="filesize"><%  Number::Bytes::Human::format_bytes( $size ) %></span>
    </div>
% } else {
    <span class="ghosted"><% __('temporarily unavailable') |h %></span>
% }
</%def>

<%once>
use Path::Class;
use Number::Bytes::Human;
</%once>
