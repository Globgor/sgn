<p><& /util/sentence.mas, text => __x('{link}Workshops{end_link} on proteomics technologies and techniques are given at the {link2}Cornell Proteomics and Mass Spectrometry Core Facility{end_link2}. An example of the handouts from the workshop are available online. ({link3}pdf{end_link3})'), link => '<a href="training.pl">', end_link => '</a>', link2 => '<a href="http://www.brc.cornell.edu/brcinfo/index.php?f=2">', end_link2 => '</a>', link3 => '<a href="/documents/secretom/MSOct09WorkshopHandouts.pdf">', end_link3 => '</a>' &></p>
<p><& /util/sentence.mas, text => __x('The Plant Genome Research Program summer {link}interns{end_link} participate in various genomics-associated activities on campus, including the cell wall proteomics project. This included practical lab-based training of students and classroom lectures.'), link => '<a href="http://bti.cornell.edu/pgrp/pgrp.php?id=201">', end_link => '</a>' &></p>
