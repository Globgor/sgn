

<%args>

</%args>

<style>

.tier {
background-color:lightyellow;
padding:1px;
border:1px solid red;color:red;
}

</style>

<& /page/page_title.mas, title => "<a href=\"http://solcyc.solgenomics.net/\">SolCyc</a> Biochemical Pathways" &>

<div class="boxbgcolor1">
<p>
<& /util/sentence.mas, text => __x('SolCyc is a collection of Pathway Genome Databases (PGDBs) for {family} species generated using {link}Pathway Tools{end_link} software from {link2}SRI International{end_link2}, the same software that is used in {link3}AraCyc{end_link3} for {i}{arabidopsis}{end_i} and {link4}EcoCyc{end_link4} for {i}{ecoli}{end_i}.'), family => 'Solanaceae', link => '<a href="http://bioinformatics.ai.sri.com/ptools/">', end_link => '</a>', link2 => '<a href="http://www.sri.com">', end_link2 => '</a>', link3 => '<a href="http://www.arabidopsis.org/tools/aracyc/">', end_link3 => '</a>', i => '<i>', arabidopsis => 'Arabidopsis thaliana', end_i => '</i>', link4 => '<a href="http://www.ecocyc.org">', end_link4 => '</a>', ecoli => 'E. coli' &> 
</p>
<p>
<& /util/sentence.mas, text => __x('Currently, databases for tomato, potato, and pepper are available, generated from the respective genome annotations.') &> <& /util/sentence.mas, text => __x('Databases that have received significant curation are marked with a {span}{tier}{end_span}.'), span => '<span class="tier">', tier => 'TIER 1', end_span => '</span>' &> <& /util/sentence.mas, text => __x('The eggplant database is not longer supported or available.') &>
</p>


<h4><% __('Species-specific databases:') |h %></h4>
<ul>
  <li><a target="_blank" href="http://solcyc.solgenomics.net/organism-summary?object=LYCO"><b>Tomato</b> <i>Solanum lycopersicum</i> (LycoCyc)</a> </li>
  
  <li><a target="_blank" href="http://solcyc.solgenomics.net/POTATO/server.html"><a target="_blank" href="http://solcyc.solgenomics.net/organism-summary?object=POTATO"><b>Potato</b> <i>Solanum tuberosum</i> (PotatoCyc)</a></li>
  
  <li><a target="_blank" href="http://solcyc.solgenomics.net/organism-summary?object=CAP"><b>Pepper</b> <i>Capsicum annuum</i> (CapCyc)</a></li>
  
  <li><a target="_blank" href="http://solcyc.solgenomics.net/organism-summary?object=COFFEA"><b>Coffee</b> <i>Coffea arabica</i> (CoffeaCyc)</a></li>
  
  <li><a target="_blank" href="http://solcyc.solgenomics.net/organism-summary?object=PET"><b>Petunia</b> <i>Petunia hybrida</i> (PetCyc)</a></li>

  <li><a target="_blank" href="http://solcyc.solgenomics.net/organism-summary?object=TobaccoCyc"><b>Tobacco</b> <i>Nicotiana tabacum</i> (K326Cyc)</a> <span class="tier">TIER 1</span></li>
  
  <li><a target="_blank" href="http://solcyc.solgenomics.net/organism-summary?object=NATT"><i>Nicotiana attenuata</i> (NattCyc)</a> <span class="tier">TIER 1</span></li>

  <li><a target="_blank" href="http://solcyc.solgenomics.net/organism-summary?object=NISYL"><i>Nicotiana sylvestris</i> (NiSylCyc)</a> <span class="tier">TIER 1</span></li>

  <li><a target="_blank" href="http://solcyc.solgenomics.net/organism-summary?object=NITOM"><i>Nicotiana tomentosiformis</i> (NiTomCyc)</a></li>

 </ul>
<h4><% __('Multi-species databases:') |h %></h4>
<ul>
  <li><a target="_blank" href="http://solcyc.solgenomics.net/organism-summary?object="><b>Tobacco</b> Combined Nicotiana genus (NicotianaCyc)</a> <span class="tier">TIER 1</span></li>
  <li><a target="_blank" href="http://solcyc.solgenomics.net/organism-summary?object="><b>Solanaceae</b> Combined Solanaceae database (SolanaCyc)</a> <span class="tier">TIER 1</span></li>
</ul>

<p>
<% __('More databases will be generated in the future, and the annotation will be improved by adding more Solanaceae specific pathways.') |h %>
</p>
<p>
<& /util/sentence.mas, text => __x('Note the availability of the {link}Omics viewer{end_link}, which allows microarray, gene chip, proteomics, and metabolomic information to be overlaid over the pathway overview diagrams.'), link => '<a href="http://solcyc.solgenomics.net/expression.html">', end_link => '</a>' &>
</p>
</div>


<b><% __('Programmatic interfaces for Pathway Tools') |h %></b>:<br />
<& /util/sentence.mas, text => __x('We currently maintain a Perl interface and a Java interface for Pathway Tools: {link}JavaCyc{end_link} and {link2}PerlCyc{end_link2}.'), link => '<a href="ftp://ftp.solgenomics.net/programs/javacyc/javacyc.tar.gz">', end_link => '</a>', link2 => '<a href="ftp://ftp.solgenomics.net/programs/perlcyc/perlcyc.tar.gz">', end_link2 => '</a>' &> <& /util/sentence.mas, text => __x('More information is available on the {link}software downloads{end_link} page.'), link => '<a href="/downloads/">', end_link => '</a>' &>

};
