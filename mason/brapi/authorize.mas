<%args>
    $deny_url
    $authorize_url
    $user_name
    $client_id
    $database_name
</%args>

<& /page/page_title.mas, title=>$m->interp->apply_escapes( __("BrAPI Client Authorization"), 'h' ) &>

<!-- <div class="row">
    <div class="col-lg-12">
        <p>To tie Field Book to your account on Breedbase, open Field Book and go to Settings -> External Data Source and scan the below QR code</p>
    </div>
</div>
<div class="row">
    <img class="col-md-2 col-md-offset-5" src="/user/field-book/generate">
</div> -->

<div class="row center">
    <p><& /util/sentence.mas, text => __x('Hello {bold}{user_name}{end_bold}!'), bold => '<b>', end_bold => '</b>', user_name => $m->interp->apply_escapes( $user_name, 'h' ) &></p>
    <p><& /util/sentence.mas, text => __x('{bold}{client_id}{end_bold} would like to access {bold}{database_name}{end_bold} through your account. Use the buttons below to authorize or deny this request.'), bold => '<b>', end_bold => '</b>', client_id => $m->interp->apply_escapes( $client_id, 'h' ), database_name => $m->interp->apply_escapes( $database_name, 'h' ) &></p><br>
    <a class="btn btn-success" href="<% $authorize_url |h %>"><% __('Authorize Access') |h %></a>
    <a class="btn btn-danger" href="<% $deny_url |h %>"><% __('Deny Access') |h %></a>
</div>
