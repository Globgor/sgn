<%args>
$transformation_id
$has_associated_transformants
</%args>

% if ($has_associated_transformants) {
    <font color="red"><% __('This transformation ID has associated transformants. Cannot delete!') |h %></font>
% } else {
    <button id="delete_transformation_button" class="btn btn-primary"><% __('Delete') |h %></button>
% }

<script>

jQuery(document).ready(function(){

    const transformation_stock_id = "<%$transformation_id%>";

    jQuery('#delete_transformation_button').click(function() {
        deleteTransformationID(transformation_stock_id);
    })

});

</script>
