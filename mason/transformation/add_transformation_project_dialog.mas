<%args>
$programs
$locations
</%args>


<& /util/import_javascript.mas, classes => ['CXGN.TrialTreeFolders'] &>

<div class="modal fade" id="create_transformation_project_dialog" name="create_transformation_project_dialog" tabindex="-1" role="dialog" aria-labelledby="createTransformationProjectDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header">
                <button type="reset" class="close" id="add_transformation_project_dismiss_button_1" name="add_transformation_project_dismiss_button" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <center><h4 class="modal-title" id="createTransformationProjectDialog"><% __('Add New Transformation Project') |h %></h4></center>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <&| /util/workflow.mas, id=> "add_transformation_project_workflow" &>
                        <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Intro"), 'h' ) &>
                            <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("What are Transformation Projects?"), 'h' ) &>

                            <p><% __('You can use Transformation Projects to manage and organize your transformation experiemnts') |h %></p>
                            <ul>
                                <li><% __('Each transformation experiment is linked to a globally unique transformation ID.') |h %></li>
                                <li><% __('Transformation ID captures information about plant material and vector construct used in that experiment.') |h %></li>
                                <li><% __('You can use transformation details page to automatically add new transformant (accession) names to database by simply indicating the number of transformants generated.') |h %></li>
                                <li><% __('Each auto-generated transformant (accession) name has transformation ID as basename and an incremental serial number.') |h %> </li>
                            </ul>
                            <hr>
                            <center>
                                <button id="next_step_add_new_intro" class="btn btn-primary" onclick="Workflow.complete(this);"><% __('Go to Next Step') |h %></button>
                            </center>
                        </&>

                        <form class="form-horizontal" role="form" name="create_transformation_project_form" id="create_transformation_project_form">
                            <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Add a transformation project"), 'h' ) &>
                                <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Enter basic information about the transformation project"), 'h' ) &>
                                    <br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-lable"><% __('Project Name:') |h %> </label>
                                        <div class="col-sm-9">
                                            <input class="form-control" type="text" id="transformation_project_name" name="transformation_project_name"  />
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% __('Breeding Program:') |h %> </label>
                                        <div class="col-sm-9">
                                            <select class="form-control" id="transformation_project_program" name="transformation_project_program">
                                                <option value="">Select Breeding Program</option>
<%perl>
foreach my $program (@$programs) {
    if (@$program[3]) {
        print "<option selected=\"selected\" value='".@$program[0]."'>".@$program[1]."</option>";
    } else {
        print "<option value='".@$program[0]."'>".@$program[1]."</option>";
    }
}
</%perl>
                                            </select>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% __('Location:') |h %> </label>
                                        <div class="col-sm-9">
                                            <select class="form-control" id="transformation_project_location" name="transformation_project_location">
                                                <option value=""><% __('Select Location') |h %></option>
<%perl>
    foreach my $location_hashref (@$locations) {
        my $properties = $location_hashref->{'properties'};
        my $program = $properties->{'Program'};
        my $name = $properties->{'Name'};
        print "<option value=\"$name\" data-program=\"$program\">".$name."</option>";
    }
</%perl>
                                            </select>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% __('Year:') |h %></label>
                                        <div class="col-sm-9">
                                            <div id="transformation_project_year" name="transformation_project_year" ></div>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% __('Description:') |h %></label>
                                        <div class="col-sm-9">
                                            <textarea class="form-control" id="transformation_project_description" name="transformation_project_description" ></textarea>
                                        </div>
                                    </div>
                                <br/>
                                <br/>
                                <br/>
                                <center>
                                    <button type="button" class="btn btn-primary" onclick="Workflow.complete(this, false);" name="create_transformation_project_submit" id="create_transformation_project_submit"><% __('Submit') |h %></button>
                                </center>
                            </&>
                        </form>

                        <&| /util/workflow.mas:complete, title=> "Complete" &>
                            <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Finished! Your transformation project is now in the database"), 'h' ) &>
                            <ul>
                                <li><% __('Please click on \'Refresh\' button to view your newly created project on the manage page.') |h %></li>
                                <li><% __('You can use your transformation project page to create transformation IDs.') |h %></li>
                                <li><b><% __('If your transformation project is automatically linked to the tracking tool, please set up a naming format for the autogenerated names of your transformation project before using the tracking tool.') |h %></b></li>
                            </ul>
                            <br/>
                        </&>
                    </&><!-- End of workflow -->
                </div>
            </div>
            <div class="modal-footer">
                <button id="add_transformation_project_dismiss_button_2" name="add_transformation_project_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    var selectedProgram = jQuery('#transformation_project_program option:selected').text()

    filter_options(selectedProgram, 'program', 'transformation_project_location');

    jQuery('#transformation_project_program').change(function() {
        filter_options(jQuery('#transformation_project_program option:selected').text(), 'program', 'transformation_project_location');
    });

    jQuery("[name='add_transformation_project_dismiss_button']").click(function() {
        jQuery('#create_transformation_project_dialog').modal('hide');
        jQuery('#transformation_project_name').val('');
        jQuery('#transformation_project_program').val('');
        jQuery('#transformation_project_location').val('');
        jQuery('#transformation_project_year').val('');
        jQuery('#transformation_project_description').val('');
    });

    jQuery('#create_transformation_project_submit').click(function() {
        var transformation_project_name = jQuery("#transformation_project_name").val();
        if (!transformation_project_name) {
            alert(<% __('Project name is required') |js %>);
            return;
        }

        var selectedProgram = jQuery("#transformation_project_program").val();
        if (!selectedProgram) {
            alert(<% __('Breeding program is required') |js %>);
            return;
        }

        var transformation_project_location = jQuery("#transformation_project_location").val();
        if (!transformation_project_location) {
            alert (<% __('Location is required') |js %>);
            return;
        }

        var year = jQuery("#transformation_project_year_select").val();
        if (!year) {
            alert (<% __('Year is required') |js %>);
            return;
        }

        var project_description = jQuery('textarea#transformation_project_description').val();
        if (!project_description) {
            alert (<% __('Description is required') |js %>);
            return;
        }

        jQuery.ajax({
            url: '/ajax/transformation/add_transformation_project',
            dataType: "json",
            type: 'POST',
            data:{
                'project_name': transformation_project_name,
                'project_program_id': selectedProgram,
                'project_location': transformation_project_location,
                'year': year,
                'project_description': project_description,
            },
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            error: function(response) {
                alert("An error occurred!" + JSON.stringify(response));
                return;
            },
            parseerror: function(response) {
                alert("A parse error occurred!" + response);
                return;
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.error) {
                    alert(response.error);
                }
                if (response.success == 1) {
                    Workflow.focus("#add_transformation_project_workflow", -1); //Go to success page
                    Workflow.check_complete("#add_transformation_project_workflow");
                }
            },

        });

    });

});

</script>
