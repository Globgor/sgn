
<%args>

</%args>

<& /util/import_javascript.mas, classes => ['jquery', 'CXGN.BreedersToolbox.HTMLSelect'], entries => ['mixedmodels' ] &>

<script src="https://cdn.jsdelivr.net/npm/vega@3"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-lite@2"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-embed@3"></script>


<& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Mixed Model Analysis"), 'h' ) &>

<& /analyses/store_new_analysis_values_and_model.mas &>

<div id="mixedmodel_tool">
</div>


<style>
  .factor {
  z-index:4;
  border-style:solid;
  border-radius:8px;
  width:200px;
  height:100;
  border-color:#337ab7;
  background-color:#337ab7;
  color:white;
  margin:4px
  }
  .factor_panel {
  min-height:100px;
  height:auto;
  margin-top:0px;
  border-style:dotted;
  border-width:5px;
  color:grey;
  background-color:lightyellow;
  }
  .factor_interaction_panel {
  border-style:dotted;
  border-width:0px;
  margin-top:20px;
  height:auto;
  z-index:1;
  }
  .model_bg {
  margin-left:30px;
  margin-right:30px;
  background-color:#DDEEEE;
  min-height:80px;
  padding-top:10px;
  padding-left:10px;
  padding-bottom:10px;
  border-radius:8px;
  }
</style>

<div class="container">
  <div class="row">

    <!-- div style="margin:20px;margin-left:auto;margin-right:auto;padding:10px;border:1px;border-style:dotted;width:60%;text-align:center">
      Note: The Mixed Model Tool is in testing. Please provide feedback but do not use in production setting.
    </div -->

    <div class="col-md-12">


      <div class="container-fluid">

        <&| /util/workflow.mas, id=> "mixed_model_analysis_workflow" &>
          <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Choose Dataset"), 'h' ) &>
            <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Choose the dataset for your analysis"), 'h' ) &>


	      <% __('1. Choose a dataset') |h %>

	      <span style="width:240px" id="mixed_model_dataset_select">
	      </span>
	      <div>
		<div style="float:right">
		  <button class="btn btn-main" id="mixed_model_analysis_prepare_button" 	onclick="Workflow.complete(this);"><% __('Choose Dataset and continue') |h %></button>
		</div>
	      </div>
	      <br />
        <input type="checkbox" id="dataset_trait_outliers" />
        <label><% __('Use validated trials') |h %> &nbsp; </label>          
        <br>
	      <br />

</&>

<&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Choose Dependent Variable"), 'h' ) &>
  <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Choose the dependent variable for your analysis"), 'h' ) &>


    <div id="dependent_variable" style="margin-bottom:50px">
    </div>

    <div id="trait_histogram">
      <% __('[Histogram]') |h %>
    </div>

    <div>
      <div style="float:right">
	<button class="btn btn-main" id="mixed_model_analysis_fishished_choose_variable" 	onclick="Workflow.complete(this);"><% __('Next step') |h %></button>
      </div>
    </div>
</&>


<&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Build Model"), 'h' ) &>
  <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Build mixed model"), 'h' ) &>

    <div class="container form-check form-switch">
      <h4><% __('Choose engine') |h %></h4>
      <input class="form-check-input" type="radio" id="select_engine_lme4" name="select_engine" value="lme4" checked="1" > lme4</input> |
      <input class="form-check-input" type="radio" id="select_engine_sommer" name="select_engine" value="sommer"> sommer</input> |
      <input class="form-check-input" type="radio" id="select_engine_sommer" name="select_engine" value="spl2D"> <% __('sommer with spatial correction spl2D') |h %></input>
	<br /><br />
    </div>

    <div class="model_bg" >
      <div id="model_string" style="margin-top:10px;margin-bottom:10px;text-align:center;font-weight:bold">[model will appear here in lme4 format]</div>
      <!--  button id="store_model_formula" class="btn btn-default btn-sm">Save model</button -->
    </div>



    <hr />
    <div class="container">
      <div class="row">
        <div id="left-margin" class="col-md-2"></div>
	<div class="col-md-4">
	  <div class="panel panel-default" style="border-width:0px">
	    <div class="panel panel-header" style="border-width:0px"><% __('Available Factors') |h %></div>
	    <hr />
            <div id="factors" class="panel panel-body" style="border-style:dotted;border-width:0px;">
	      <% __('[ Choose dataset and dependent variable first ]') |h %>
            </div>
          </div>
	</div>
        <div class="col-md-4">
          <div  id="fixed_factors_panel" style="border-width:0;" class="panel panel-default">
	    <div class="panel-header"><% __('Fixed factors') |h %></div>
	    <div id="fixed_factors" class="panel-body factor_panel">

	      <!-- style="background-color:lightyellow;min-height:100px;height:auto;border-style:dotted;border-width:5px;color:grey" --></div>

          </div>
	  <div id="interaction_factor_collection_panel" class="panel panel-default factor_interaction_panel">
	    <!-- style="border-style:dotted;border-width:0px;margin-top:20px;height:auto;z-index:1" -->
            <div class="panel-header">
	      <% __('Fixed factors with interaction') |h %><br />
              <button  id="add_interaction_factor_button"><% __('add new interaction') |h %></button>
	    </div>
	    <div id="interaction_factors_collection" name="interaction_factors_collection" class="panel-body">
	    </div>
          </div>
	  <div id="variable_slope_intersect_collection_panel" class="panel panel-default factor_interaction_panel">

	    <!--    style="border-style:dotted;border-width:0px;margin-top:20px;height:auto;z-index:1" -->

            <div class="panel-header">
              <% __('Random factors with variable slope/intersects') |h %><br />
              <button  id="add_variable_slope_intersect_button"><% __('add new variable slope/intersect') |h %></button>
	    </div>
	    <div id="variable_slope_intersect_collection" class="panel-body">

	    </div>
	  </div>

	  <div style="height:30">&nbsp;</div>
          <div id="random_factors_panel" class="panel panel-default" style="border-width:0px">
            <div class="panel-header"><% __('Random factors') |h %></div>
	    <div id="random_factors" class="panel-body factor_panel">

	      <!-- style="background-color:lightyellow;min-height:100px;height:auto;border-style:dotted;border-width:5px;color:grey" -->
            </div>
          </div>
	</div>
      </div>
    </div>

    <br />
    <div id="tempfile" style="display:none" >
    </div>

    <div>
      <div style="float:right">
	<button style="position:relative;" id="run_mixed_model_button" class="btn btn-main" 	onclick="Workflow.complete(this)" ><% __('Run analysis and go to next step') |h %></button>
      </div>
    </div>
    <hr />

</&>

<&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Results"), 'h' ) &>

<& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Analysis Results"), 'h' ) &>

  <div>
    <ul class="nav nav-tabs">
      <li class="active"><a data-toggle="tab" id="adjusted_blups_tab_link" href="#adjusted_blups_tab"><% __('Adjusted means (BLUPs)') |h %></a></li>
      <li><a data-toggle="tab" id="blups_tab_link" href="#blups_tab">BLUPs</a></li>
      <li><a data-toggle="tab" id="adjusted_blues_tab_link" href="#adjusted_blues_tab"><% __('Adjusted means (BLUEs)') |h %></a></li>
      <li><a data-toggle="tab" id="blues_tab_link" href="#blues_tab">BLUEs</a></li>
    </ul>
    <div class="tab-content">
      <div id="adjusted_blups_tab" class="tab-pane fade in active">
	<br />
	  <button id="open_store_adjusted_blups_dialog_button" class="btn btn-primary" data-toggle="modal" data-analysis_type="adjusted_means"><% __('Save adjusted means') |h %></button>

	  <!-- button class="btn btn-primary">Download</button -->
	  <br />
	  <div id="mixed_models_adjusted_blups_results_div"><% __('[loading...]') |h %></div>
      </div>

      <div id="blups_tab" class="tab-pane fade">
	<br />
	<button id="open_store_blups_dialog_button" class="btn btn-primary" data-toggle="modal" data-analysis_type="blup" data-target="#generic_save_analysis_dialog"><% __('Save BLUPs') |h %></button>
	<div id="mixed_models_blups_results_div"><% __('[not available]') |h %></div>
      </div>

      <div id="adjusted_blues_tab" class="tab-pane fade">
	<br />
	<button id="open_store_adjusted_blues_dialog_button" class="btn btn-primary" data-toggle="modal" data-analysis_type="blues"><% __('Save adjusted BLUEs') |h %></button>

	<div id="mixed_models_adjusted_blues_results_div"><% __('[loading...]') |h %></div>
      </div>

      <div id="blues_tab" class="tab-pane fade">
	<br />
	<button id="open_store_blues_dialog_button" class="btn btn-primary" data-toggle="modal" data-analysis_type="blues"><% __('Save BLUEs') |h %></button>

	<div id="mixed_models_blues_results_div"><% __('[loading...]') |h %></div>
      </div>
    </div> <!-- results_tab div -->
  </div>

</&>

</&>

<script>

var check_outliers = "<% $c->get_conf('exclude_phenotype_outliers') || 0 %>";

if (parseInt(check_outliers) === 1) {
    document.getElementById('dataset_trait_outliers').checked = true;
}

$(document).ready( function() {
var mixedmodels = window.jsMod['mixedmodels'].init("mixedmodels");
});

</script>
