
<%doc>

</%doc>

<h1><% __('Submit a Genefamily') |h %></h1>

<form>
<table>
<tr><td><% __('Name:') |h %></td><td> <input name="gfname" size="20" /></td></tr>
<tr><td><% __('Description') |h %></td><td><input name="gfdesc" size="80" /></td></tr>
<tr><td><% __('Members:') |h %></td><td><textarea cols="30" rows="10" /></textarea></td></tr>
<tr><td colspan="2"><input type="submit" value="<% __('submit genefamily') |h %>" /></td></tr>
</table>
</form>

