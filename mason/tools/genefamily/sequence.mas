
<%args>
$seq_id
$build
$family
$desc => undef
$seq => undef

</%args>


<h1><% __('Sequence Details') |h %></h1>

<h2><% __('Identifier') |h %></h2>

<% $seq_id %></h1>

<h2><% __('Viewing Build') |h %></h2>

<% $build %>

<h2><% __('Family') |h %></h2>

<a href="/tools/genefamily/details/<% $build %>/<% $family %>"><% $family %></a>

<h2><% __('Description') |h %></h2>

<% $desc %>

<h2><% __('Sequence') |h %></h2>

Length: <% length($seq) %>

<pre>
% $seq =~ s/(.{60})/$1\n/g;
<% $seq %>
</pre>
