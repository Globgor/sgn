<meta http-equiv="refresh" content="0; URL='http://vigs.solgenomics.net'" />

<%args>

@databases
$sequence => undef
$default_db => undef
$f_size => 0

</%args>

<!-- import javascript libraries-->
<& /util/import_javascript.mas, classes => ['Text.Markup', 'sprintf', 'jquery', 'jqueryui', 'jquery.iframe-post-form', 'CXGN.List', 'tools/vigs'] &>

<& /page/page_title.mas, title=>$m->interp->apply_escapes( __("VIGS Tool"), 'h' ) &>



<&| /page/info_section.mas, id=>"vigs_input" , title=>$m->interp->apply_escapes( __("Run VIGS Tool"), 'h' ), collapsible => 1, collapsed => 0  &>
<center>
<div id="input_view">

<% __('Sequence:') |h %>

<script>
	var seq = ">Solyc10g047140.1.1 Receptor like kinase, RLK\\n";

	document.write("(<a href=\"javascript:example()\" title=\"Paste an example sequence\" >example sequence</a>)");

	function example() { 
	    document.getElementById("sequence").value=seq;
	}
	
	
	//use JQueryIu to define tooltip style
    $(function() {
	   $( document ).tooltip({
		   position: {
			   my: "center bottom-20",
			   at: "center top",
			   using: function( position, feedback ) {
				   $( this ).css( position );
				   $( "<div>" )
				   .addClass( "arrow" )
				   .addClass( feedback.vertical )
				   .addClass( feedback.horizontal )
				   .appendTo( this );
			   }
		   }
	   });
   });
	
</script>
<div id="status_wheel" style="display:none"><img src="/static/documents/img/wheel.gif" /></div>
<br />


<textarea class="input" id="sequence" name="sequence" cols=62" rows="8"></textarea>
<br />
<br />

<span title="<% __('siRNA selected size') |h %>"><% __('n-mer size') |h %></span> 
<input class="input" id="si_rna" type="input" value="21" name="fragment_size" size="2" />&nbsp; &nbsp; &nbsp;

<span title="<% __('Desired VIGS construct length') |h %>"><% __('Fragment length') |h %></span> 
<input class="input" id="f_length" type="input" value="300" name="seq_fragment" size="3" />&nbsp; &nbsp; &nbsp;

<span title="<% __('Number of mismatches allowed in Bowtie alignment') |h %>"><% __('mismatches') |h %></span> 
<input class="input" id="mm" type="input" value="0" name="mismatch" size="1" />
<br />
<br />
<% __('Database') |h %> <select class="input" id='bt2_db' name="database" title="<% __('Select plant species to host VIGS experiment') |h %>">
<br />

<%perl>

foreach my $d (@databases) {
	my $db_name = $d;
	$db_name =~ s/_/ /g;
	
	if ($default_db) {
		if ($d eq $default_db) {
			print "<option value=\"".$d."\" selected='selected'>".$db_name."</option><br />";
		} else {
			print "<option value=\"".$d."\">".$db_name."</option><br />";
		}
	} else {
		print "<option value=\"".$d."\">".$db_name."</option><br />";
	}
}
</%perl>
</select>
<br />
<br />


<form method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_expression_form" name="upload_expression_form" action="/ajax/upload_expression_file">
    <% __('Upload Expression file:') |h %> <input type="file" name="expression_file" id="expression_file" encoding="multipart/form-data" title="<% __('Insert a expression file in a tab-delimited format') |h %>"/>
</form>


<br />
<!-- <button class="input" id="clear_form" value="clear">Clear</button>&nbsp; &nbsp; &nbsp; -->
<button class="input" id="upload_expression_file" value="Run VIGS Analysis"><% __('Run VIGS Analysis') |h %></button>

<br />
<br />
<div id="coverage_val" val="0"></div>
<div id="seq_length" val="0"></div>
<div id="best_start" val="0"></div>
<div id="best_end" val="0"></div>
<div id="best_score" val="0"></div>
<div id="db_name" val="0"></div>
<div id="help_fsize" val="0"></div>
<div id="help_nmer" val="0"></div>
<div id="help_mm" val="0"></div>

</div>
</center>


<&| /page/info_section.mas, id=>"vigs_usage" , title=>$m->interp->apply_escapes( __("VIGS Usage"), 'h' ), collapsible => 1, collapsed => 1, is_subsection=>"1"  &>
  <div id="usage_view">
    <p>
        <b><% __('Usage:') |h %></b><br />
        <& /util/sentence.mas, text => __x('1. Paste a {bold}sequence{end_bold} like in one of the examples:'), bold => '<b>', end_bold => '</b>' &><br />
        <span style="background-color:#DCDCDC;">&nbsp;&nbsp;>gene_ID<br />&nbsp;&nbsp;ATGGATCAGTCGGTGTTGGCGATCT&nbsp;&nbsp;<br />&nbsp;&nbsp;ACAGCTTGGCCAACTCCAGAAATTG&nbsp;&nbsp;</span><br />
        &nbsp;&nbsp;<% __('or') |h %><br />
        <span style="background-color:#DCDCDC;">&nbsp;&nbsp;ATGGATCAGTCGGTGTTGGCGATCT&nbsp;&nbsp;</span><br />
        &nbsp;&nbsp;<& /util/sentence.mas, text => __x('Or paste the {bold}gene ID{end_bold}:'), bold => '<b>', end_bold => '</b>' &><br />
        <span style="background-color:#DCDCDC;">&nbsp;&nbsp;Solyc10g047140.1.1&nbsp;&nbsp;</span><br />
         
        <& /util/sentence.mas, text => __x('2. Choose {bold}n-mer size{end_bold}, nucleotide stretch size in bp, used to identify targeted regions (18-24, Default=21)'), bold => '<b>', end_bold => '</b>' &><br />
        <& /util/sentence.mas, text => __x('3. Choose {bold}Fragment length{end_bold}, desired VIGS fragment length in bp (100-Sequence length, Default=300)'), bold => '<b>', end_bold => '</b>' &><br />
        <& /util/sentence.mas, text => __x('4. Choose {bold}mismatches{end_bold}, number of mismatches allowed in the alignment (0-2, Default=0)'), bold => '<b>', end_bold => '</b>' &><br />
        <!-- 4. Choose <b>mismatches</b>, number of mismatches allowed in the alignment (0-1, Default=0)<br /> -->
        <& /util/sentence.mas, text => __x('5. Choose {bold}database{end_bold}'), bold => '<b>', end_bold => '</b>' &><br />
        <& /util/sentence.mas, text => __x('6. Upload a {bold}expression values file{end_bold} (optional), It must be a tab delimited text file, with gene identifiers in the first column and a header in the first row:'), bold => '<b>', end_bold => '</b>' &>
	</p>
	<table style="background-color:#DCDCDC;" cellspacing="5">
		<tr>
			<td>gene_id</td>
			<td>expr_val</td>
			<td>p_val ...</td>
		</tr>
		<tr>
			<td>Solyc10g047140.1.1</td>
			<td>4.56</td>
			<td>0.0001 ...</td>
		</tr>
		<tr>
			<td>Solyc01g000020.1.1</td>
			<td>3.64</td>
			<td>0.0032 ...</td>
		</tr>
		<tr>
			<td>...</td>
		</tr>
     </table>
  </div>
</&>

</&>


<!-- ##################################################################################### -->
<!-- OUTPUT VIEW -->
<!-- ##################################################################################### -->


<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Results"), 'h' ), collapsible => 1, collapsed => 0  &>

<div id="img_height" style="display:none;" value="601"></div>

<div id="hide1" style="display:none;">
<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Modify parameters"), 'h' ), collapsible => 1, collapsed => 0, subtitle=>'[<a id="help_dialog_1" class="help_dialog">Help</a>]', is_subsection=>"1"  &>
<table>
  <tr>
    <td id="score_p" style="text-align:'right';"></td>
  </tr>
</table>

<table>
  <tr>
    <td><% __('Region Start:') |h %> </td><td><input type="text" id="cbr_start" size="3"></td>
    <td><% __('Region End:') |h %> </td><td><input type="text" id="cbr_end" size="3"> &nbsp;</td>
    <td><button type="button" id="set_custom" value="set custom best region"><% __('Set Custom Region') |h %></button><br /></td>
  </tr>
  <tr>
    <td><% __('Target genes:') |h %> </td><td><input id="t_num" size="1" name="targets" min="1" /></td>
    <td><% __('Fragment size:') |h %></td><td><input id="f_size" size="3" name="seq_fragment" /></td>
    <td>
      <% __('n-mer:') |h %> <input id="n_mer" size="2" name="si_rna" />
      <% __('Mismatches:') |h %> <input id="align_mm" size="1" name="align_mm" />
    </td>
    <td><button id="change_par" type="button" value="recalculate"><% __('Change') |h %></button></td>
  </tr>
</table>
</&>

<span id="no_results" style="color:red;"></span>
<p style="color:red" id="cbr_p"></p>
</div>

<div id="hide2" style="display:none;">
<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Distribution of n-mers"), 'h' ), collapsible => 1, collapsed => 0, subtitle=>'[<a id="help_dialog_2" class="help_dialog">Help</a>]', is_subsection=>"1"  &>
    <div class="seq_map" id="seq_map">
         <div class="region_square" id="region_square"></div>
     	 <canvas id="myCanvas" width="700" height="600">
     	     <% __('Your browser does not support the HTML5 canvas') |h %>
     	 </canvas>
    </div>
    <br />
    <button id="collapse" value="1"><% __('Expand Graph') |h %></button>
    <button id="zoom" value="0"><% __('Zoom In') |h %></button>
    <button id="params_dialog"><% __('Parameters Used') |h %></button>

</&>
</div>

<div id="help_fsize"></div>
<div id="help_nmer"></div>
<div id="help_mm"></div>
<div id="help_db"></div>


<div id="hide3" style="display:none;">

<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Best region"), 'h' ), collapsible => 1, collapsed => 0, subtitle=>'[<a id="help_dialog_3" class="help_dialog">Help</a>]', is_subsection=>"1" &>
    <div id="br_seq">
    	 <p id="best_seq" style="font-family:courier;font-size:16px;"></p>
    </div>
</&>


<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Sequence overview"), 'h' ), collapsible => 1, collapsed => 0, subtitle=>'[<a id="help_dialog_4" class="help_dialog">Help</a>]', is_subsection=>"1" &>
    <span id="query" style="display:none"></span>
    <div id="markup" style="align:left;"></div>
</&>


<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Description of genes with matches of n-mers"), 'h' ), collapsible => 1, collapsed => 0, subtitle=>'[<a id="open_descriptions_dialog">View</a>]&nbsp;&nbsp;[<a id="help_dialog_5" class="help_dialog">Help</a>]', is_subsection=>"1" &>
    <table id="target_info"></table>
</&>

</div>


<div id="desc_dialog">
    <table id="dialog_info"></table>
</div>

<div id="params" style="display:none;"></div>
<div id="help_dialog_tmp" style="display:none;"></div>


</&>


<!-- STYLE -->

<style>
.seq_map {
    color: #777777;
    width: 700px;
    position:relative;
    overflow: auto;
    align: left;
}

.ui-dialog {
    position:relative;
}

#region_square {
    position:absolute;
    vertical-align:middle;
}

.help_dialog {
     color:blue;
}

#open_descriptions_dialog {
    color:blue;
}

#desc_dialog {
     overflow: auto;
     position: relative;
}




.ui-tooltip, .arrow:after {
	background: #000000;
	border: 2px solid white;
}
.ui-tooltip {
	padding: 5px 10px;
	color: white;
	border-radius: 10px;
	font: bold 12px "Helvetica Neue", Sans-Serif;
	box-shadow: 0 0 7px black;
}
.arrow {
	width: 70px;
	height: 16px;
	overflow: hidden;
	position: absolute;
	left: 50%;
	margin-left: -35px;
	bottom: -16px;
}
.arrow.top {
	top: -16px;
	bottom: auto;
}
.arrow.left {
	left: 20%;
}
.arrow:after {
	content: "";
	position: absolute;
	left: 20px;
	top: -20px;
	width: 25px;
	height: 25px;
	box-shadow: 6px 5px 9px -9px black;
	-webkit-transform: rotate(45deg);
	-moz-transform: rotate(45deg);
	-ms-transform: rotate(45deg);
	-o-transform: rotate(45deg);
	tranform: rotate(45deg);
}
.arrow.top:after {
	bottom: -20px;
	top: auto;
}


#sequence {
	background-color:#EEEEFE;
	border-color:#000;
	border-width:2px;
	border-style:solid;
	border-radius:5px;
	width: 700px;
	min-height: 80px;
	max-height: 300px;
	min-width: 700px;
	max-width: 700px;
}


#upload_expression_file {
background-color:#555555;
/*background-color:#4387FD;*/
border:0px;
border-radius:2px;
/*color:#fff;*/
color:#EEEEEE;
box-shadow: 1px 1px 0px 0px #C6C6C6;
font-family:Arial;
font-size:12px;
height:20px;
line-height:18px;
vertical-align: top;
}
#upload_expression_file:hover {
background-color:#444444;
/*background-color:#5EA1FF;*/
/*color:#acf;*/
color:#fff;
}
#upload_expression_file:active {
position:relative;
top:1px;
left:1px;
box-shadow: 0px 0px 0px 0px #fff;
}

</style>


