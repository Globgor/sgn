<div class="text-center">
    <p><% __('Last step! Here you can edit additional layout settings and/or save your design.') |h %></p>
    <p><% __('When you are ready, click \'Download pdf\' to generate your labels. If you are trying to download a very large set, you will be given the option to download your labels in batches.') |h %></p>
</div>
<div id="save-labels-display"></div>
<div style="clear: both"></div>
<div style="margin-top: 40px; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 20px 40px">
    <div>
        <label><% __('Sort Labels By:') |h %></label>
        <select class="form-control" id="sort_order_1" name="sort_by" style="max-width: 300px"></select>
    </div>

    <!-- Additional Sort Options -->
    <div id="sort_order_2_container" style="display: none">
        <label><& /util/sentence.mas, text => __x('...Then by:{span}Optional{end_span}'), span => '<span style="font-size: 60%; margin-left: 15px; padding: 5px; border-radius: 5px; background-color: #ccc;">', end_span => '</span>' &></label>
        <select class="form-control" id="sort_order_2" name="sort_by" style="max-width: 300px"></select>
    </div>
    <div id="sort_order_3_container" style="display: none">
        <label><& /util/sentence.mas, text => __x('...Then by:{span}Optional{end_span}'), span => '<span style="font-size: 60%; margin-left: 15px; padding: 5px; border-radius: 5px; background-color: #ccc;">', end_span => '</span>' &></label>
        <select class="form-control" id="sort_order_3" name="sort_by" style="max-width: 300px"></select>
    </div>

    <!-- Trial Layout Sort Options -->
    <div id="sort_order_layout_order_container" style="display: none">
        <label><% __('...Plot Order:') |h %></label>
        <select class="form-control" id="sort_order_layout_order" name="sort_by" style="max-width: 300px">
            <option value="by_col_serpentine"><% __('By Column: Serpentine') |h %></option>
            <option value="by_col_zigzag"><% __('By Column: Zigzag') |h %></option>
            <option value="by_row_serpentine"><% __('By Row: Serpentine') |h %></option>
            <option value="by_row_zigzag"><% __('By Row: Zigzag') |h %></option>
        </select>
    </div>
    <div id="sort_order_layout_start_container" style="display: none">
        <label><% __('...Starting Plot:') |h %></label>
        <select class="form-control" id="sort_order_layout_start" name="sort_by" style="max-width: 300px">
            <option value="bottom_left"><% __('Bottom Left') |h %></option>
            <option value="top_left"><% __('Top Left') |h %></option>
            <option value="top_right"><% __('Top Right') |h %></option>
            <option value="bottom_right"><% __('Bottom Right') |h %></option>
        </select>
    </div>
</div>
<div style="margin-top: 40px; margin-bottom: 40px; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 20px 40px">
    <div>
        <label><% __('Set margins, # of rows/cols, etc:') |h %></label>
        <div class="input-group">
            <button class="btn btn-primary" id="edit_additional_settings"><% __('Edit Additional Settings') |h %></button>
        </div>
    </div>
    <div>
        <label><% __('Save Label Design:') |h %></label>
        <div class="input-group" id="save_design_div">
            <input type="text" id="save_design_name" class="form-control" placeholder="<% __('Enter a name') |h %>" />
            <span class="input-group-btn">
                <button class="btn btn-default" id="d3-save-button" type="button"><% __('Save') |h %></button>
            </span>
        </div>
    </div>
    <div>
        <label><% __('Download Labels:') |h %></label>
        <div class="input-group">
            <button id="d3-pdf-button" value="pdf" class="btn btn-primary" style="display:none;"><% __('Download pdf') |h %></button>
            <button id="d3-zpl-button" value="zpl" class="btn btn-primary" style="display:none;"><% __('Download zpl file') |h %></button>
        </div>
    </div>
</div>
