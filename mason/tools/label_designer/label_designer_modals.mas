<div class="modal fade" id="customFieldModal" tabindex="-1" role="dialog" aria-labelledby="customFieldModal" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="row">
                    <center><label><% __('Custom_Field:') |h %></label></center>
                    <div class="col-md-3"></div>
                    <div class="col-md-6">
                        <center>
                            <input type="text" class="form-control" id="d3-custom-input" placeholder="<% __('Type here') |h %>" autofocus>
                        </center>
                    </div>
                    <div class="col-md-3"></div>
                </div>
                <br>
                <div class="row">
                    <div class="col-md-6">
                        <center>
                            <label><% __('Add Variable:') |h %></label><br>
                            <select id="d3-custom-add-field-input" class="form-control"></select>
                        </center>
                    </div>
                    <div class="col-md-6">
                        <center>
                            <label><% __('Add Custom Number:') |h %></label><br>
                            <input type="number" class="form-control" id="start_number" placeholder="<% __('Start Number') |h %>">
                            <input type="number" class="form-control" id="increment_number" placeholder="<% __('Increment Number') |h %>">
                            <button class="btn btn-primary" id="d3-add-number"><% __('Add') |h %></button>
                        </center>
                    </div>
                </div>
                <br>
                <div class="row">
                    <center><button class="btn btn-primary" id="d3-custom-preview"><% __('See Preview') |h %></button></center><br><br>
                    <div class="col-md-3"></div>
                    <div class="col-md-6">
                        <center><p id="d3-custom-content"></p></center>
                    </div>
                    <div class="col-md-3"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal"><% __('Close') |h %></button>
                <button id="d3-custom-field-save" type="button" class="btn btn-primary" data-dismiss="modal"><% __('Ok') |h %></button>
            </div>
        </div>
    </div>
</div>



<div class="modal fade" id="editAdditionalSettingsModal" tabindex="-1" role="dialog" aria-labelledby="editAdditionalSettingsModal" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="col-md-1"></div>
                    <div class="col-md-10">
                        <center>
                            <label><% __('Additional Settings:') |h %></label>
                        <br>
                        <img src="/static/img/print_setting_options.png" class="img-responsive" alt="<% __('printer settings') |h %>" height="196" width="480" style="border: 1px solid black;">
                    </center>
                    </div>
                    <div class="col-md-1"></div>
                </div>
                <div class="col-md-12" id="">
                    <center>
                        <label class='radio'><input type="radio" name="dimoptradio2" id="dim_inches2" class="radio-select-imperial" value="inch"><% __('Imperial (inches)') |h %></label>
                        <label class='radio'><input type="radio" name="dimoptradio2" id="dim_cm2" class="radio-select-metric" value="cm" checked><% __('Metric (cm)') |h %></label>
                    </center>
                    <div class="col-md-1">
                    </div>
                    <div class="col-md-5">
                        <center>
                            <br><label><% __('Top Margin:') |h %></label><br>
                            <input class="form-control"  type="number" id="top_margin" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-5">
                        <center>
                            <br><label><% __('Left Margin:') |h %></label><br>
                            <input class="form-control"  type="number" id="left_margin" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-1"></div>
                </div>
                <div class="col-md-12" id="">
                    <div class="col-md-1"></div>
                    <div class="col-md-5">
                        <center>
                            <br><label><% __('Horizontal Gap:') |h %></label><br>
                            <input class="form-control"  type="number" id="horizontal_gap" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-5">
                        <center>
                            <br><label><% __('Vertical Gap:') |h %></label><br>
                            <input class="form-control" type="number" id="vertical_gap" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-1"></div>
                </div>
                <div class="col-md-12" id="">
                    <div class="col-md-1"></div>
                    <div class="col-md-5">
                        <center>
                            <br><label><% __('Number of Columns:') |h %></label>
                            <input class="form-control" placeholder="<% __('Num labels across') |h %>" type="number" id="number_of_columns" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-5">
                        <center>
                            <br><label><% __('Number of Rows:') |h %></label>
                            <input class="form-control" placeholder="<% __('Num labels down') |h %>" type="number" id="number_of_rows" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-1"></div>
                </div>
                <div class="col-md-12">
                    <div class="col-md-1"></div>
                    <div class="col-md-5">
                        <center>
                        <br><label><% __('Limit by Rep:') |h %></label>
                            <select class="form-control" id="plot_filter" name="plot_filter" style="max-width: 100%">
                            </select>
                        </center>
                    </div>
                    <div class="col-md-5">
                        <center>
                            <br><label><% __('Copies per label:') |h %></label>
                            <input class="form-control" id="copies_per_plot" name="copies_per_plot" type="number" value="1" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-1"></div>
                </div>
                <div class="col-md-12">
                    <div class="col-md-1"></div>
                    <div class="col-md-5">
                        <center>
                            <br><label><% __('Total # to download:') |h %></label>
                            <input class="form-control" id="label_designer_labels_to_download" name="label_designer_labels_to_download" type="number" placeholder="10" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-5"></div>
                    <div class="col-md-1"></div>
                </div>
                <div class="col-md-12">
                    <div class="col-md-1"></div>
                    <div class="col-md-10">
                        <br /><br />
                        <p><strong><% __('Position of First Label:') |h %></strong><br />
                        <% __('Set the column and row number of where to print the first label, if using a sheet that has already been partially used') |h %></p>
                    </div>
                    <div class="col-md-1"></div>
                </div>
                <div class="col-md-12">
                    <div class="col-md-1"></div>
                    <div class="col-md-5">
                        <center>
                            <br><label><% __('Start Column:') |h %></label>
                            <input class="form-control" id="start_col" name="start_col" type="number" value="1" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-5">
                        <center>
                            <br><label><% __('Start Row:') |h %></label>
                            <input class="form-control" id="start_row" name="start_row" type="number" value="1" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-1"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal"><% __('Close') |h %></button>
                <button id="d3-edit-additional-settings" type="button" class="btn btn-primary" data-dismiss="modal"><% __('Save') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="batchDownloadModal" tabindex="-1" role="dialog" aria-labelledby="batchDownloadModal" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="col-md-12" id="">
                    <div class="col-md-1"></div>
                    <div class="col-md-10">
                        <center>
                            <label><% __('Batch Download:') |h %></label>
                        <br>
                        <p id="batch_download_message"></p>
                    </center>
                    </div>
                    <div class="col-md-1"></div>
                </div>
                <div class="col-md-12">
                    <div class="col-md-1"></div>
                    <div class="col-md-5">
                        <center>
                            <br><label><% __('Start Number:') |h %></label><br>
                            <input class="form-control" placeholder="0" type="number" id="label_designer_start_number" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-5">
                        <center>
                            <br><label><% __('End Number:') |h %></label><br>
                            <input class="form-control" placeholder="1000" type="number" id="label_designer_end_number" style="max-width: 100%;">
                        </center>
                    </div>
                    <div class="col-md-1"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal"><% __('Close') |h %></button>
                <button id="d3-batch-download-submit" type="button" class="btn btn-primary" data-dismiss="modal"><% __('Download') |h %></button>
            </div>
        </div>
    </div>
</div>
