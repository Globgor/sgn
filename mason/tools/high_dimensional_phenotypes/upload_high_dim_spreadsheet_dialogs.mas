<%args>
$high_dimensional_phenotype_type => undef #either NIRS, Transcriptomics, Metabolomics
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jqueryui', 'jquery.iframe-post-form' ] &>

<!--button class="btn btn-primary" name="upload_high_dim_phenotypes_spreadsheet_link">Upload High Dimensional Data</button-->

<%perl>
my @instrument_model_options = split ",", $c->config->{instrument_model_options};
my @library_method_options = split ",", $c->config->{library_method_options};
my @layout_options = split ",", $c->config->{layout_options};
my @mapping_software_options = split ",", $c->config->{mapping_software_options};
my @sequencing_platform_options = split ",", $c->config->{sequencing_platform_options};
my @na_extraction_method_options = split ",", $c->config->{na_extraction_method_options};
my @sequencing_center_options = split ",", $c->config->{genotyping_facilities};
</%perl>

<div class="modal fade" id="upload_high_dim_phenotypes_spreadsheet_dialog" name="upload_high_dim_phenotypes_spreadsheet_dialog" tabindex="-1" role="dialog" aria-labelledby="addHighDimDataDialog">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="addHighDimDataDialog"><% __('Upload High-Dimensional Phenotype Data') |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

            <&| /util/workflow.mas, id=> "high_dim_data_upload_workflow" &>
                <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Intro"), 'h' ) &>
                    <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("This workflow will guide you through uploading high-dimensional data into the database."), 'h' ) &>

                    <center>
                        <div class="well">
                            <h4><% __('High-dimensional phenotype data includes:') |h %></h4>
                            <p>NIRS</p>
                            <p><% __('Transcriptomics') |h %></p>
                            <p><% __('Metabolomics') |h %></p>
                        </div>
                    </center>

                    <center>
                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;"><% __('Go to Next Step') |h %></button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Samples"), 'h' ) &>
                    <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Make sure your samples are already in the database."), 'h' ) &>

                    <center>
                        <div class="well">
                            <h4><% __('The samples for which you are uploading high-dimensional phenotypes must exist in the database already. They can be field trial entities such as plot names, plant names, and tissue sample names. They can be genotyping plate well tissue sample names. They can also be sample names from a sampling trial in the database.') |h %></h4>
                            <p><& /util/sentence.mas, text => __x('Go to {link}Manage Tissue Samples{end_link} for more guidance.'), link => '<a href="/breeders/samples">', end_link => '</a>' &></p>
                            <p>You can upload or create a new sampling trial <button class="btn btn-sm btn-primary" style="margin:3px" name="create_sampling_trial_button"><% __('Create new sampling trial') |h %></button></p>
                        </div>
                    </center>

                    <center>
                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;"><% __('Go to Next Step') |h %></button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Data Type"), 'h' ) &>
                    <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Select the type of high-dimensional data being uploaded"), 'h' ) &>
                    <br/><br/>
                    <form class="form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% __('Data Type:') |h %> </label>
                            <div class="col-sm-9" >
                                <select class="form-control" id="high_dim_data_upload_type_select">
%  if ($high_dimensional_phenotype_type eq 'NIRS') {
                                    <option value=""><% __('Select One') |h %></option>
                                    <option value="NIRS">NIRS</option>
                                    <option disabled value="Transcriptomics"><% __('Transcriptomics') |h %></option>
                                    <option disabled value="Metabolomics"><% __('Metabolomics') |h %></option>
%  } elsif ($high_dimensional_phenotype_type eq 'Transcriptomics') {
                                    <option value=""><% __('Select One') |h %></option>
                                    <option value="Transcriptomics"><% __('Transcriptomics') |h %></option>
                                    <option disabled value="NIRS">NIRS</option>
                                    <option disabled value="Metabolomics"><% __('Metabolomics') |h %></option>
%  } elsif ($high_dimensional_phenotype_type eq 'Metabolomics') {
                                    <option value=""><% __('Select One') |h %></option>
                                    <option value="Metabolomics"><% __('Metabolomics') |h %></option>
                                    <option disabled value="Transcriptomics"><% __('Transcriptomics') |h %></option>
                                    <option disabled value="NIRS">NIRS</option>
%  } else {
                                    <option value=""><% __('Select One') |h %></option>
                                    <option value="NIRS">NIRS</option>
                                    <option value="Transcriptomics"><% __('Transcriptomics') |h %></option>
                                    <option value="Metabolomics"><% __('Metabolomics') |h %></option>
%  }
                                </select>
                            </div>
                        </div>
                    </form>
                    <center>
                    <button class="btn btn-primary" id="high_dim_data_upload_data_type_step"><% __('Go to Next Step') |h %></button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Protocol Info"), 'h' ) &>
                    <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Select a protocol for how your data was generated or create a new protocol"), 'h' ) &>

                    <div id="high_dim_data_upload_protocol_select">
                    </div>

                    <hr>
                    <center>
                    <button class="btn btn-primary" id="high_dim_data_upload_new_protocol"><% __('Protocol Not Shown. Create a New Protocol') |h %></button>
                    </center>
                    <br/><br/>

                    <div id="high_dim_data_upload_protocol_div" style="display:none">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Protocol Name:') |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_protocol_name" type="text">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Protocol Description:') |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_protocol_desc"  type="text">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="high_dim_data_upload_nirs_protocol_div" style="display:none">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('NIRS Device:') |h %> </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_nirs_device_type_select">
                                        <option value="SCIO">SCIO</option>
                                        <option value="QST">QST</option>
                                        <option value="Foss6500">Foss6500</option>
                                        <option value="Foss DS2500">Foss DS2500</option>
                                        <option value="Foss XDS">Foss XDS</option>
                                        <option value="BunchiN500">BunchiN500</option>
                                        <option value="LinkSquare">LinkSquare</option>
                                        <option value="ASD Qualityspec">ASD Qualityspec</option>
                                        <option value="ASD LabSpec">ASD LabSpec</option>
                                        <option value="Specim FX17">Specim FX17</option>
                                        <option value="FTIR6X">FT/IR-6X</option>
                                        <option value="InnoSpectraNIR-S-G1">InnoSpectraNIR-S-G1</option>
                                        <option value="Viavi microNIR">Viavi microNIR</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="high_dim_data_upload_transcriptomics_protocol_div" style="display:none">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Transcriptomics Unit:') |h %> </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_transcriptomics_unit_select">
                                    <option value="RPKM">RPKM</option>
                                    <option value="FPKM">FPKM</option>
                                    <option value="TPM">TPM</option>
                                    <option value="VST">VST</option>
                                    <option value="RawCount">RawCount</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Genome Version:') |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_transcriptomics_genome_version_select" type="text" placeholder="e.g. v6.1, v7.0, v8.0">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Genome Annotation Version:') |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_transcriptomics_genome_annotation_version_select" type="text" placeholder="e.g. v6.0, v6.1, v7.0">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Instrument Model:') |h %> </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_transcriptomics_instrument_model_select">
                                    <option value="blank"></option>
                                    <%perl>
                                    foreach my $model_option (@instrument_model_options) {
                                    </%perl>
                                    <option value="<% $model_option %>"><% $model_option %></option>
                                    <%perl>
                                    }
                                    </%perl>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Layout:') |h %> </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_transcriptomics_layout_select" type = "text" placeholder="e.g. Paired end">
                                    <option value="blank"></option>
                                    <%perl>
                                    foreach my $option (@layout_options) {
                                    </%perl>
                                    <option value="<% $option %>"><% $option %></option>
                                    <%perl>
                                    }
                                    </%perl>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Library Method:') |h %> </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_transcriptomics_library_method_select">
                                    <option value="blank"></option>
                                    <%perl>
                                    foreach my $option (@library_method_options) {
                                    </%perl>
                                    <option value="<% $option %>"><% $option %></option>
                                    <%perl>
                                    }
                                    </%perl>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Library Comments:') |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_transcriptomics_library_comments_select" type = "text" placeholder="<% __('e.g. Used the 3\'RNA-seq method') |h %>">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Mapping Software:') |h %> </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_transcriptomics_mapping_software_select" type = "text" placeholder="e.g. HISAT2">
                                    <option value="blank"></option>
                                    <%perl>
                                    foreach my $option (@mapping_software_options) {
                                    </%perl>
                                    <option value="<% $option %>"><% $option %></option>
                                    <%perl>
                                    }
                                    </%perl>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Sequencing Center:') |h %> </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_transcriptomics_sequencing_center_select" type = "text" placeholder="e.g. Cornell University Institute of Biotechnology">
                                    <option value="blank"></option>
                                    <%perl>
                                    foreach my $option (@sequencing_center_options) {
                                    </%perl>
                                    <option value="<% $option %>"><% $option %></option>
                                    <%perl>
                                    }
                                    </%perl>
                                    </select>
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Sequencing Platform:') |h %> </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_transcriptomics_sequencing_platform_select" type = "text" placeholder="e.g. Illumina">
                                    <option value="blank"></option>
                                    <%perl>
                                    foreach my $option (@sequencing_platform_options) {
                                    </%perl>
                                    <option value="<% $option %>"><% $option %></option>
                                    <%perl>
                                    }
                                    </%perl>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Read Length:') |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_transcriptomics_read_length_select" type = "text" placeholder="<% __('e.g. 5x depth with 150 bp reads') |h %>">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Nucleic Acid Extraction Method:') |h %> </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_transcriptomics_nucleic_acid_extraction_method_select" type = "text" placeholder="<% __('e.g. Hot borate') |h %>">
                                    <option value="blank"></option>
                                    <%perl>
                                    foreach my $option (@na_extraction_method_options) {
                                    </%perl>
                                    <option value="<% $option %>"><% $option %></option>
                                    <%perl>
                                    }
                                    </%perl>
                                    </select>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div id="high_dim_data_upload_metabolomics_protocol_div" style="display:none">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Equipment Type:') |h %> </label>
                                <div class="col-sm-9" >
                                    <select class="form-control" id="high_dim_data_upload_metabolomics_equipment_type">
                                        <option value="NMR">NMR</option>
                                        <option value="MS">MS</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Targeted:') |h %> </label>
                                <div class="col-sm-9" >
                                <select class="form-control" id="high_dim_data_upload_metabolomics_targeted">
                                    <option value="True"><% __('True') |h %></option>
                                    <option value="False"><% __('False') |h %></option>
                                </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Phenotype Protocol:') |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_metabolomics_phenotype_type" type="text" placeholder="e.g. relative abundance, BLUP, drBLUP, concentration">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Phenotype Units:') |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_metabolomics_phenotype_units" type="text" placeholder="e.g. ug/g">
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Sample Collection protocol:') |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_metabolomics_sample_collection_protocol" type="text" placeholder="<% __('e.g. mature dehulled oat seeds') |h %>">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Sample Extraction Protocol:') |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_metabolomics_sample_extraction_protocol" type="text" placeholder="<% __('e.g. describe extraction protocol used') |h %>">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('RawData Transformation Protocol:') |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_metabolomics_rawdata_transformation_protocol" type="text" placeholder="<% __('e.g. describe the raw data transformation protocol used') |h %>">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Metabolite Identification Protocol:') |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_metabolomics_metabolite_identification_protocol" type="text" placeholder="<% __('e.g. describe the metabolomics identification protocol used') |h %>">
                                </div>
                            </div>
                        </div>

                        <div id="high_dim_data_upload_metabolomics_protocol_ms_div" style="display:none">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% __('Chromatography Type:') |h %> </label>
                                    <div class="col-sm-9" >
                                        <select class="form-control" id="high_dim_data_upload_metabolomics_chromatography_type">
                                            <option value="LCMS">LCMS</option>
                                            <option value="GCMS">GCMS</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% __('Chromatography Instrument:') |h %> </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_chromatography_system_brand" type="text" placeholder="e.g. ThermoFisher MS100 System">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% __('Chromatography AutoSampler Model:') |h %> </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_chromatography_AutoSampler_Model" type="text" placeholder="<% __('e.g. write the name of AutoSampler Model used') |h %>">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% __('Chromatography Column Model:') |h %> </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_chromatography_column_brand" type="text" placeholder="e.g. ThermoFisher MS100 Column">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% __('Chromatography Column Type:') |h %> </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_chromatography_column_type" type="text" placeholder="<% __('e.g. high polarity') |h %>">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% __('Chromatography Protocol:') |h %> </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_chromatography_protocol" type="text" placeholder="<% __('e.g. describe chromatography protocol used') |h %>">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% __('Mass Spectrometry Protocol:') |h %> </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_mass_spectrometry_protocol" type="text" placeholder="<% __('e.g. describe mass spectrometry protocol used') |h %>">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% __('MS Instrument:') |h %> </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_ms_brand" type="text" placeholder="e.g. ThermoFisher MS100">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% __('MS Mass Analyzer:') |h %> </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_ms_mass_analyzer" type="text" placeholder="<% __('e.g. single quadropole') |h %>">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% __('MS Ion Source:') |h %> </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_ms_ion_source" type="text" placeholder="e.g. EI, ESI, APCI, MALDI">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% __('MS Scan Polarity:') |h %> </label>
                                    <div class="col-sm-9" >
                                        <select class="form-control" id="high_dim_data_upload_metabolomics_ms_scan_polarity">
                                            <option value="negative"><% __('Negative') |h %></option>
                                            <option value="positive"><% __('Positive') |h %></option>
                                            <option value="both"><% __('Both') |h %></option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% __('MS Scan MZ Range:') |h %> </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" id="high_dim_data_upload_metabolomics_ms_scan_MZ_Range" type="text" placeholder="e.g. 60-800">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Equipment Description:') |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_metabolomics_equipment_description" type="text" placeholder="<% __('e.g. ThermoFisher MS100 Electron Ionization TOF Negative Ion Mode') |h %>">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Data Process Description:') |h %> </label>
                                <div class="col-sm-9" >
                                    <textarea rows="10" class="form-control" id="high_dim_data_upload_metabolomics_data_process_description" placeholder="<% __('e.g. This describes mode, instrument settings, calibration procedure. Also, describes how the files from the LCMS machine were transformed into peak area. Finally, describes how metabolite annotations were assigned to peaks') |h %>"></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% __('Publication:') |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="high_dim_data_upload_metabolomics_publication" type="text" placeholder="e.g. https://doi.org/10.3389/fgene.2021.643733">
                                </div>
                            </div>
                        </div>
                    </div>

                    <center>
                    <button class="btn btn-primary" id="high_dim_data_upload_data_protocol_step"><% __('Go to Next Step') |h %></button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Template Info"), 'h' ) &>
                    <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("High-dimensional data must be uploaded using the template information provided"), 'h' ) &>

                    <center>
                    <&| /page/explanation.mas, title=>$m->interp->apply_escapes( __('Data Matrix Spreadsheet Template Information'), 'h' ) &>
                        <p>
                        <b><% __('File format information') |h %></b>
                        <br>
                        <a id="high_dim_data_spreadsheet_format_info"><% __('Data Matrix Spreadsheet Format') |h %></a>
                        </p>
                    </&>
                    </center>

                    <div id="high_dim_data_upload_transcriptomics_protocol_template_div">
                        <center>
                        <&| /page/explanation.mas, title=>$m->interp->apply_escapes( __('Transcript Details Spreadsheet Template Information'), 'h' ) &>
                            <p>
                            <b><% __('File format information') |h %></b>
                            <br>
                            <a id="high_dim_data_spreadsheet_transcripts_format_info"><% __('Functional Annotation Spreadsheet Format') |h %></a>
                            </p>
                        </&>
                        </center>
                    </div>

                    <div id="high_dim_data_upload_metabolomics_protocol_template_div">
                        <center>
                        <&| /page/explanation.mas, title=>$m->interp->apply_escapes( __('Metabolite Details Spreadsheet Template Information'), 'h' ) &>
                            <p>
                            <b><% __('File format information') |h %></b>
                            <br>
                            <a id="high_dim_data_spreadsheet_metabolites_format_info"><% __('Metabolite Details Spreadsheet Format') |h %></a>
                            </p>
                        </&>
                        </center>
                    </div>

                    <center>
                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;"><% __('Go to Next Step') |h %></button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Upload"), 'h' ) &>
                    <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Select your high-dimensional data file to upload"), 'h' ) &>

                    <div id="high_dim_data_upload_nirs_div" style="display:none">
                        <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_nirs_spreadsheet_file_form" name="upload_nirs_spreadsheet_file_form">
