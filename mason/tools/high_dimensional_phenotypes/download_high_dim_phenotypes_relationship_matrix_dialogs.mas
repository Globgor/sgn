<%args>
$high_dimensional_phenotype_type => undef #either NIRS, Transcriptomics, Metabolomics
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jqueryui', 'jquery.iframe-post-form' ] &>

<!--button class="btn btn-primary" name="high_dimensional_phenotype_relationship_matrix_download_button">Upload High Dimensional Data</button-->

<div class="modal fade" id="download_high_dim_phenotypes_relationship_matrix_dialog" name="download_high_dim_phenotypes_relationship_matrix_dialog" tabindex="-1" role="dialog" aria-labelledby="downloadHighDimRelationshipMatrixDataDialog">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% __('Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="downloadHighDimRelationshipMatrixDataDialog"><% __('Download High-Dimensional Phenotype Relationship Matrix') |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

            <&| /util/workflow.mas, id=> "high_dim_data_download_relationship_matrix_workflow" &>
                <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Intro"), 'h' ) &>
                    <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("This workflow will guide you through downloading a relationship matrix from high-dimensional data from the database."), 'h' ) &>

                    <center>
                        <div class="well">
                            <h4><% __('High-dimensional phenotype data includes:') |h %></h4>
                            <p>NIRS</p>
                            <p><% __('Transcriptomics') |h %></p>
                            <p><% __('Metabolomics') |h %></p>
                        </div>
                    </center>

                    <center>
                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;"><% __('Go to Next Step') |h %></button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Data Type"), 'h' ) &>
                    <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Select the type of high-dimensional data to download"), 'h' ) &>
                    <br/><br/>
                    <form class="form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% __('Data Type:') |h %> </label>
                            <div class="col-sm-9" >
                                <select class="form-control" id="high_dim_data_relationship_matrix_download_type_select"> 
%  if ($high_dimensional_phenotype_type eq 'NIRS') {
                                    <option value="NIRS">NIRS</option>
                                    <option disabled value="Transcriptomics"><% __('Transcriptomics') |h %></option>
                                    <option disabled value="Metabolomics"><% __('Metabolomics') |h %></option>
%  } elsif ($high_dimensional_phenotype_type eq 'Transcriptomics') {
                                    <option value="Transcriptomics"><% __('Transcriptomics') |h %></option>
                                    <option disabled value="NIRS">NIRS</option>
                                    <option disabled value="Metabolomics"><% __('Metabolomics') |h %></option>
%  } elsif ($high_dimensional_phenotype_type eq 'Metabolomics') {
                                    <option value="Metabolomics"><% __('Metabolomics') |h %></option>
                                    <option disabled value="Transcriptomics"><% __('Transcriptomics') |h %></option>
                                    <option disabled value="NIRS">NIRS</option>
%  } else {
                                    <option value="NIRS">NIRS</option>
                                    <option value="Transcriptomics"><% __('Transcriptomics') |h %></option>
                                    <option value="Metabolomics"><% __('Metabolomics') |h %></option>
%  }
                                </select>
                            </div>
                        </div>
                    </form>
                    <center>
                    <button class="btn btn-primary" id="high_dim_data_download_data_relationship_matrix_type_step"><% __('Go to Next Step') |h %></button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Protocol Info"), 'h' ) &>
                    <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Select a protocol for the data to download"), 'h' ) &>

                    <div id="high_dim_data_download_relationship_matrix_protocol_select">
                    </div>

                    <hr>
                    <center>
                    <button class="btn btn-primary" id="high_dim_data_download_relationship_matrix_protocol_step"><% __('Go to Next Step') |h %></button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Dataset"), 'h' ) &>
                    <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Select a dataset for the data to download"), 'h' ) &>

                    <div id="high_dim_data_download_relationship_matrix_dataset_select">
                    </div>

                    <hr>
                    <center>
                    <button class="btn btn-primary" id="high_dim_data_download_relationship_matrix_dataset_step"><% __('Go to Next Step') |h %></button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> $m->interp->apply_escapes( __("Download"), 'h' ) &>
                    <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Download high dimensional phenotypes relationship matrix"), 'h' ) &>

                    <div class="form-horizontal" >
                        <div class="form-group">
                            <label class="col-sm-6 control-label"><% __('Query Associated Stocks (e.g. Your dataset contains accessions, however, the high-dim phenotypes are saved for tissue samples of the accession):') |h %> </label>
                            <div class="col-sm-6" >
                                <select class="form-control" id="high_dim_data_download_relationship_matrix_associated_stocks" name="high_dim_data_download_relationship_matrix_associated_stocks">
                                    <option value="yes"><% __('Yes') |h %></option>
                                    <option value="no"><% __('No') |h %></option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <hr>
                    <center>
                        <button type="button" class="btn btn-primary" name="high_dim_data_download_relationship_matrix_submit" id="high_dim_data_download_relationship_matrix_submit" title="<% __('Download') |h %>"><% __('Download') |h %></button>
                    </center>

                </&>
            </&>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% __('Close') |h %></button>
      </div>
    </div>
  </div>
</div>

<script>
jQuery(document).ready(function() {

    jQuery('button[name=high_dimensional_phenotype_relationship_matrix_download_button]').click( function() {
        jQuery('#download_high_dim_phenotypes_relationship_matrix_dialog').modal("show");

        get_select_box('datasets','high_dim_data_download_relationship_matrix_dataset_select', {'checkbox_name':'high_dim_data_download_relationship_matrix_dataset_select_id'});
    });

    var high_dim_data_download_relationship_matrix_type = '';
    jQuery('#high_dim_data_download_data_relationship_matrix_type_step').click(function(){
        high_dim_data_download_relationship_matrix_type = jQuery('#high_dim_data_download_type_select').val();

        if (high_dim_data_download_relationship_matrix_type == 'NIRS') {
            get_select_box('high_dimensional_phenotypes_protocols','high_dim_data_download_relationship_matrix_protocol_select', {'checkbox_name':'high_dim_data_download_relationship_matrix_protocol_id', 'high_dimensional_phenotype_protocol_type':'high_dimensional_phenotype_nirs_protocol'});
        }
        else if (high_dim_data_download_relationship_matrix_type == 'Transcriptomics') {
            get_select_box('high_dimensional_phenotypes_protocols','high_dim_data_download_relationship_matrix_protocol_select', {'checkbox_name':'high_dim_data_download_relationship_matrix_protocol_id', 'high_dimensional_phenotype_protocol_type':'high_dimensional_phenotype_transcriptomics_protocol'});
        }
        else if (high_dim_data_download_relationship_matrix_type == 'Metabolomics') {
            get_select_box('high_dimensional_phenotypes_protocols','high_dim_data_download_relationship_matrix_protocol_select', {'checkbox_name':'high_dim_data_download_relationship_matrix_protocol_id', 'high_dimensional_phenotype_protocol_type':'high_dimensional_phenotype_metabolomics_protocol'});
        }

        Workflow.complete("#high_dim_data_download_data_relationship_matrix_type_step");
        Workflow.focus('#high_dim_data_download_relationship_matrix_workflow', 2);
    });

    var high_dim_data_download_relationship_matrix_protocol_id;
    jQuery('#high_dim_data_download_relationship_matrix_protocol_step').click(function(){
        var selected = [];
        jQuery('input[name="high_dim_data_download_relationship_matrix_protocol_id"]:checked').each(function() {
            selected.push(jQuery(this).val());
        });

        if(selected.length > 1 || selected.length == 0) {
            alert(<% __('Please select one dataset!') |js %>);
            return false;
        }
        else {
            high_dim_data_download_relationship_matrix_protocol_id = selected[0];

            Workflow.complete("#high_dim_data_download_relationship_matrix_protocol_step");
            Workflow.focus('#high_dim_data_download_relationship_matrix_workflow', 3);
        }
    });

    var high_dim_data_download_relationship_matrix_dataset_id;
    jQuery('#high_dim_data_download_relationship_matrix_dataset_step').click(function(){
        var selected = [];
        jQuery('input[name="high_dim_data_download_relationship_matrix_dataset_select_id"]:checked').each(function() {
            selected.push(jQuery(this).val());
        });

        if(selected.length > 1 || selected.length == 0) {
            alert(<% __('Please select one dataset!') |js %>);
            return false;
        }
        else {
            high_dim_data_download_relationship_matrix_dataset_id = selected[0];

            Workflow.complete("#high_dim_data_download_relationship_matrix_dataset_step");
            Workflow.focus('#high_dim_data_download_relationship_matrix_workflow', 4);
        }
    });

    jQuery('#high_dim_data_download_relationship_matrix_submit').click(function(e){
        e.preventDefault();

        jQuery.ajax({
            url : '/ajax/highdimensionalphenotypes/download_relationship_matrix_file',
            type : 'POST',
            data : {
                'dataset_id' : high_dim_data_download_relationship_matrix_dataset_id,
                'nd_protocol_id': high_dim_data_download_relationship_matrix_protocol_id,
                'query_associated_stocks': jQuery('#high_dim_data_download_relationship_matrix_associated_stocks').val(),
                'high_dimensional_phenotype_type': high_dim_data_download_relationship_matrix_type
            },
            beforeSend: function(){
                jQuery('#working_modal').modal('show');
            },
            success: function(response){
                console.log(response);
                jQuery('#working_modal').modal('hide');

                if (response.error) {
                    alert(response.error);
                    return false;
                }

                window.location.href = response.download_file_link;
            },
            error: function(response){
                alert(<% __('Error downloading high dim phenotype relationship matrix file!') |js %>);
                jQuery('#working_modal').modal('hide');
            }
        });
    });

});
</script>
