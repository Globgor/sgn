<%args>
$transcriptomics_files => undef
$deleted_transcriptomics_files => undef
$all_transcriptomics_files => undef
$all_deleted_transcriptomics_files => undef
$locations => undef
$sampling_facilities => ()
$sample_tissue_types => ()
</%args>

<& /tools/high_dimensional_phenotypes/upload_high_dim_spreadsheet_dialogs.mas &>
<& /tools/high_dimensional_phenotypes/download_high_dim_phenotypes_dialogs.mas &>
<& /breeders_toolbox/sampling_trials/create_sampling_trials_dialogs.mas, sampling_facilities=>$sampling_facilities, sample_tissue_types=>$sample_tissue_types &>

<div class="well">
<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Uploaded Transcriptomic Data'), 'h' ), is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>$m->interp->apply_escapes( __('View and manage uploaded transcriptomic data files'), 'h' ) &>

    <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Your Uploaded Transcriptomic Data'), 'h' ), is_subsection=>1, collapsible=>1, collapsed=>1 &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$transcriptomics_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Your Obsoleted Transcriptomic Data'), 'h' ), is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>$m->interp->apply_escapes( __('These are deleted transcriptomic files'), 'h' ) &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$deleted_transcriptomics_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('All Uploaded Transcriptomic Data'), 'h' ), is_subsection=>1, collapsible=>1, collapsed=>1 &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$all_transcriptomics_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('All Obsoleted Transcriptomic Data'), 'h' ), is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>$m->interp->apply_escapes( __('These are deleted transcriptomic files'), 'h' ) &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$all_deleted_transcriptomics_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
</&>
</div>

<div class="well">
<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Transcriptomic Analyses'), 'h' ), is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>$m->interp->apply_escapes( __('View and manage your transcriptomic analyses'), 'h' ) &>
    <div class="panel panel-default">
        <div class="panel-body">
            <table class="table table-bordered table-hover" id="analyses_by_user_table">
              <thead>
              <tr>
                <th>
                  <% __('Analysis Name') |h %>
                </th>
                <th>
                  <% __('Description') |h %>
                </th>
                <th>
                  <% __('Model Type') |h %>
                </th>
                <th>
                  <% __('Protocol') |h %>
                </th>
                <th>
                  <% __('Application') |h %>
                </th>
                <th>
                  <% __('Language') |h %>
                </th>
              </tr>
              </thead>
              <tbody>
              </tbody>
            </table>
        </div>
    </div>
</&>
</div>

