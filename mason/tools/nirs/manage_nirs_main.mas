<%args>
$nirs_files => undef
$deleted_nirs_files => undef
$all_nirs_files => undef
$all_deleted_nirs_files => undef
$locations => undef
$sampling_facilities => ()
$sample_tissue_types => ()
</%args>

<& /tools/high_dimensional_phenotypes/upload_high_dim_spreadsheet_dialogs.mas &>
<& /tools/high_dimensional_phenotypes/download_high_dim_phenotypes_dialogs.mas &>
<& /tools/high_dimensional_phenotypes/download_high_dim_phenotypes_relationship_matrix_dialogs.mas &>
<& /tools/nirs/nirs_analysis_train_dialogs.mas &>
<& /tools/nirs/nirs_analysis_predict_dialogs.mas &>
<& /tools/nirs/nirs_analysis_plot_spectra_dialogs.mas &>
<& /breeders_toolbox/sampling_trials/create_sampling_trials_dialogs.mas, sampling_facilities=>$sampling_facilities, sample_tissue_types=>$sample_tissue_types &>

<div class="well">
<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Uploaded NIRS Data'), 'h' ), is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>$m->interp->apply_escapes( __('View and manage uploaded NIRS data files'), 'h' ) &>

    <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Your Uploaded NIRS Data'), 'h' ), is_subsection=>1, collapsible=>1, collapsed=>1 &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$nirs_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Your Obsoleted NIRS Data'), 'h' ), is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>$m->interp->apply_escapes( __('These are deleted NIRS files'), 'h' ) &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$deleted_nirs_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('All Uploaded NIRS Data'), 'h' ), is_subsection=>1, collapsible=>1, collapsed=>1 &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$all_nirs_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('All Obsoleted NIRS Data'), 'h' ), is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>$m->interp->apply_escapes( __('These are deleted NIRS files'), 'h' ) &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$all_deleted_nirs_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
</&>
</div>

<div class="well">
<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('NIRS Analyses'), 'h' ), is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>$m->interp->apply_escapes( __('View and manage your NIRS analyses'), 'h' ) &>
    <div class="panel panel-default">
        <div class="panel-body">
            <table class="table table-bordered table-hover" id="analyses_by_user_table">
              <thead>
              <tr>
                <th>
                  <% __('Analysis Name') |h %>
                </th>
                <th>
                  <% __('Description') |h %>
                </th>
                <th>
                  <% __('Model Type') |h %>
                </th>
                <th>
                  <% __('Protocol') |h %>
                </th>
                <th>
                  <% __('Application') |h %>
                </th>
                <th>
                  <% __('Language') |h %>
                </th>
              </tr>
              </thead>
              <tbody>
              </tbody>
            </table>
        </div>
    </div>
</&>
</div>


<div class="well">
<&| /page/info_section.mas, title=>$m->interp->apply_escapes( __('Trained NIRS Models'), 'h' ), is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>$m->interp->apply_escapes( __('View and manage your NIRS models'), 'h' ) &>
    <div class="panel panel-default">
        <div class="panel-body">
            <table class="table table-bordered table-hover" id="models_by_user_table">
              <thead>
              <tr>
                <th>
                  <% __('Model Name') |h %>
                </th>
                <th>
                  <% __('Description') |h %>
                </th>
                <th>
                  <% __('Model Type') |h %>
                </th>
                <th>
                  <% __('Protocol') |h %>
                </th>
                <th>
                  <% __('Application') |h %>
                </th>
                <th>
                  <% __('Language') |h %>
                </th>
              </tr>
              </thead>
              <tbody>
              </tbody>
            </table>
        </div>
    </div>
</&>
</div>

<script>
jQuery(document).ready(function(){
    jQuery('#analyses_by_user_table').DataTable({
        'ajax': { 'url': '/ajax/analyses/by_user?analysis_model_type=waves_nirs_spectral_predictions' }
    });

    jQuery('#models_by_user_table').DataTable({
        'ajax': { 'url': '/ajax/analyses/models/by_user?analysis_model_type=waves_nirs_spectral_predictions' }
    });
});
</script>
