<%args>
$errors => ''
$blast_res => ''
$pcr_seq => ''
$gel_url => ''
</%args>

<& /page/page_title.mas, title=>$m->interp->apply_escapes( __("In Silico PCR Results"), 'h' ) &>
<br>
<center>
  <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("In Silico Gel"), 'h' ), collapsible=>1, collapsed=>0 &>
  <img class="img-thumbnail" src=<% $gel_url %>>
  </&>
  <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("BLAST Results"), 'h' ), collapsible=>1, collapsed=>1 &>
  <pre class="text-left"><% $blast_res %></pre>
  </&>
  <br><br>
  <&| /page/info_section.mas, title=>$m->interp->apply_escapes( __("Amplified Fragments"), 'h' ), collapsible=>1, collapsed=>0 &>
  <pre class="text-left"><% $pcr_seq %></pre>
  </&>
</center>
