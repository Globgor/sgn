<%args>
    $content => ''
    $sha1
    $bulk_js_menu
    $bulk_download_stats
    $bulk_download_success
</%args>

<& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Gene Download Summary"), 'h' ) &>

% if($bulk_download_success) {
    <% __('Your query was successful.') |h %><br>
<div id="bulk_download_stats">
<% $bulk_download_stats %>
</div>
<& /util/sentence.mas, text => __x('Download as {link}Fasta{end_link}'), link => '<a href="/bulk/gene/download/' . $sha1 . '.fasta">', end_link => '</a>' &>
% } else {
    <% __('Your query did not contain any valid identifiers. Please try again.') |h %>
% }
