
<%args>
$summary_data => {}
</%args>

    <& /page/page_title.mas, title=>$m->interp->apply_escapes( __("Bulk download summary"), 'h' ) &>

    <& /util/sentence.mas, text => __x('The query you submitted contained {count} lines.'), count => $summary_data->{numlines} &><br />
    <& /util/sentence.mas, text => __x('Your query resulted in {count} lines being retrieved in {seconds} seconds.'), count => $summary_data->{total}, seconds => $summary_data->{query_time} &><br />
    <% $summary_data->{missing_ids_msg} %><br /><br />

%    if ( $summary_data->{total} == 0 ) {

     <& /util/sentence.mas, text => __x('Please verify that you used the correct search and that you chose the right unigene or bac assembly to download from. Also make sure that the submitted identifiers are appropriately formatted.') &><br />
     
     <% __('Please try your search again.') |h %><br /><br />
%   }
%   else {
 
    <& /util/sentence.mas, text => __x('The file size is {size} kBytes.'), size => $summary_data->{filesize} &>
    <br /><br />
    <& /util/sentence.mas, text => __x('{link}Browse{end_link} the results.'), link => '<a href="/tools/bulk/display?outputType=HTML&amp;line_count=$line_count&amp;dumpfile=' . $summary_data->{file} . '&amp;page=1&amp;idType=' . $summary_data->{idType} . '">', end_link => '</a>' &>
    <br />
    <br />

    <table border="0" cellpadding="0"><tr><td width="120"><b><% __('View') |h %></b></td><td width="120">
    <b><% __('Download to disk') |h %></b></td></tr>
    <tr><td>

    as <a href="/tools/bulk/display?outputType=text&amp;dumpfile=<% $summary_data->{file} %>&amp;idType=<% $summary_data->{idType} %>">Text</a>
    <br />
    as <% $summary_data->{fastalink} %><br />

    </td><td>

    as <a href="/tools/bulk/display?outputType=text&amp;dumpfile=<% $summary_data->{file} %>&amp;idType=<% $summary_data->{idType} %>&amp;download=1">
    Text</a><br />
    as <% $summary_data->{fastadownload} %><br />

    </td></tr></table>
    <br /><br /><% $summary_data->{fastamessage} %><br />

%}
