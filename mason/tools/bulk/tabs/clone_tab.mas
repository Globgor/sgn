
<%args>
$ug_build_select => ''
$debug => ''
</%args>


<form name="bulkform" action="/tools/bulk/download" method="post" enctype="multipart/form-data">
  
  <br />
  <table summary="" cellpadding="10" width="100%"><tr><td valign="top" bgcolor="#EEEEEE" width="320">
	
	<% $ug_build_select %>
	<br />
	
	<% __('Enter a list of identifiers or upload a file containing identifers, one per line:') |h %><br />
	<table summary="" width="100%"><tr><td>
	      <textarea id="ids" name="ids" rows="5" cols="20"></textarea>
	    </td>
	    <td>
	      <i>Example:</i> #example box
	      <div style="border: 1px solid gray; width: 10em; height: 5em">
<pre><div id="clone_example_ids">cLEB-1-A2
cLEB-1-A3
cLEB-1-A4</div></pre><a href="javascript:copy_example_data()"><% __('[copy]') |h %></a>
</div> 

<script>
function copy_example_data() { 
document.getElementById("ids").innerHTML=document.getElementById("clone_example_ids").innerHTML;
}
</script>
	 
	</td></tr></table>
	
	<br />
	<br />
	<% __('And/or upload list file:') |h %> <br /><input type="file" name="file" />
	<br />
	<br />
	
    </td><td valign="top" bgcolor="#EEEEEE" width="320">
	<b><% __('Please select the information you would like for each identifier:') |h %></b><br />
	<input type="checkbox" name="clone_name" checked="checked" /> <% __('clone name') |h %><br />
	<input type="checkbox" name="SGN_C" checked="checked" /> <% __('clone id (SGN-C)') |h %><br />
	<input type="checkbox" name="SGN_T" checked="checked" /> <% __('sequence read id (SGN-T)') |h %><br />
	<input type="checkbox" name="SGN_E" checked="checked" /> <% __('est id (SGN-E)') |h %><br />
	<input type="checkbox" name="build_nr" checked="checked" /> <% __('unigene build nr') |h %><br />
	<input type="checkbox" name="SGN_U" checked="checked" /> <% __('unigene id (SGN-U)') |h %><br />
	<input type="checkbox" name="chipname" checked="checked" /> <% __('chipname') |h %><br />
	<input type="checkbox" name="SGN_S" checked="checked" /> <% __('microarray spot id (SGN-S)') |h %><br />
	<input type="checkbox" name="TUS" checked="checked" /> <% __('TUS number (used to order clones)') |h %><br />
	<input type="checkbox" name="manual_annotation" /> <% __('manual annotation') |h %><br />
	<input type="checkbox" name="automatic_annotation" /> <% __('automatic (BLAST) annotation') |h %><br />
	<input type="checkbox" name="sequence" onclick="check_fasta_option()" /> <% __('sequence') |h %><br />
	&nbsp;&nbsp;&nbsp;<input type="radio" name="seq_type" value="est_seq" checked="checked" /> <% __('EST sequence') |h %><br />
	&nbsp;&nbsp;&nbsp;<input type="radio" name="seq_type" value="unigene_seq" /> <% __('Unigene sequence') |h %><br />

</td></tr></table>

%    if ( $debug eq "1" ) {
%        print
%qq|<input type="checkbox" checked="checked" name="debug" /> print debug statements<br /><br />\n|;
%    }

 	<input type="hidden" name="idType" value="clone" />
	<input type="reset" />&nbsp;&nbsp;
        <input type="submit" value="<% __('Submit') |h %>" /><br />
   </form>


