<%args>
$prefill_ids => ''
</%args>


<form name="bulk_feature" action="/bulk/feature/submit/" method="post" enctype="multipart/form-data">
<table summary="" cellpadding="10" width="100%"><tr><td valign="top" bgcolor="#EEEEEE" width="320">
<% __('Enter a list of feature identifier or upload a file containing one identifier separated by whitespace (returns, spaces or tabs):') |h %><br />
<table summary="" width="100%" cellpadding="0"><tr><td>
<textarea name="ids" rows="10" cols="30">
<% $prefill_ids |h%>
</textarea>
</td>
<td>
<i><% __('Example:') |h %></i>
<pre style="border: 1px solid gray; padding: 5px">
SGN-E398616
C06HBa0229B01.1
AP009262
Solyc01g005080.2.1
</pre>
</td></tr></table>
<br />
<br />

<% __('And/or upload list file:') |h %> <br /><input type="file" name="feature_file" />
<br />
<br />

</td>
<td valign="top" bgcolor="#EEEEEE" width="320">

<b><% __('Download feature information') |h %></b>:<br />
<div style="padding-left: 1em">
    <input type="checkbox" name="feature_sequence" onchange="this.checked='checked'" checked="checked" /> <% __('feature sequence') |h %> <br />
</div>
</td>
</tr></table>

<input type="submit" value="<% __('Submit') |h %>" /><br />
</form>
