
<%args>

</%args>

<form id="converter_form" action="/tools/bulk/download" method="post" enctype="multipart/form-data">

<br />
<table summary="" cellpadding="10" width="100%"><tr><td valign="top" bgcolor="#EEEEEE" width="320">

<br />
<% __('Enter a list of identifiers (SGN unigene ids or TOM1 array ids) or upload a file containing one identifer separated by whitespace (returns, spaces or tabs):') |h %><br />

<table summary="" width="100%" cellpadding="0"><tr><td>
<textarea name="ids" rows="5" cols="20"></textarea>
</td>
<td>
<i><% __('Example:') |h %></i>
<pre style="border: 1px solid gray; width: 10em; height: 5em">
SGN-U562661
SGN-U562662
SGN-U562663
</pre>
</td></tr></table>
<br />
<br />

<% __('And/or upload list file:') |h %> <br /><input type="file" name="file" />
<br />
<br />

</td><td valign="top" bgcolor="#EEEEEE" width="320">

      <input type="hidden" name="idType" value="converter" />

      <input type="radio" name="converter_type" value="unigene_solyc_converter" checked="1" /> <% __('Convert unigene ids to tomato genome ids') |h %><br />
      <input type="radio" name="converter_type" value="unigene_version_converter" /> <% __('Convert to newest version') |h %><br />

<br />
<br />
<br />
<br />
<br />
<br />
</td></tr></table>
	<input type="reset" />&nbsp;&nbsp;
<input type="submit" value="<% __('Submit') |h %>" /><br />


</form>
