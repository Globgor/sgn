
<%args>
$debug => ''
</%args>

<%perl>

=head2 bac_end_search

  Desc: sub bac_end_search
  Args: n/a
  Ret : BAC end tab format

  Defines the format of the BAC end=head2 bac_end_search tab using html & perl.
  Specifies information fields available for searching BAC ends. Prints the debug
  checkbox when debug parameter is set to one.

=cut

</%perl>

<form name="bulkform" action="/tools/bulk/download" method="post" enctype="multipart/form-data">

<br />
<table summary="" cellpadding="10" width="100%"><tr><td valign="top" bgcolor="#EEEEEE" width="370">


<br />
<% __('Enter a list of identifiers or upload a file containing identifiers separated by whitespace (returns, spaces or tabs):') |h %><br />
<table summary="" width="100%"><tr><td>
<textarea name="ids" rows="5" cols="25"></textarea>
</td>
<td>
<i><% __('Example:') |h %></i>
<pre style="border: 1px solid gray; width: 15em; height: 5em">
LE_HBa0011C24_SP6_121022
SL_MboI0033A13_SP6_294865
SL_EcoRI0022A07_T7_229350

</pre>
</td></tr></table>
<br />
<br />
<% __('And/or upload list file:') |h %> <br /><input type="file" name="file" />
<br />
<br />

</td><td valign="top" bgcolor="#EEEEEE" width="280">

<b><% __('Download BAC end information:') |h %></b><br />
<div style="margin-left: 1em; white-space: nowrap">
  <input type="checkbox" name="bac_id" checked= "checked" /> <% __('bac end identifier') |h %> <br />
  <input type="checkbox" name="clone_type" checked="checked" /> <% __('clone type') |h %> <br />
  <input type="checkbox" name="org_name" checked="checked" /> <% __('organism name') |h %> <br />
  <input type="checkbox" name="accession_name" checked="checked" /> <% __('accession name') |h %> <br />
  <input type="checkbox" name="library_name" checked="checked" /> <% __('library name') |h %> <br />
  <input type="checkbox" name="estimated_length" checked="checked" /> <% __('estimated length') |h %> <br />
  <input type="checkbox" name="genbank_accession" checked="checked" /> <% __('genbank accession') |h %><br />
  <!--	<input type="checkbox" name="overgo_matches" checked="checked" DISABLED /> overgo matches <br /> -->  <br />
  <b><% __('Choose format and type:') |h %></b><br />
  <input type="checkbox" name="bac_end_sequence" checked="checked" /> <% __('bac end sequence') |h %> <br />
  <input type="checkbox" name="qual_value_seq" checked="checked" /> <% __('quality value') |h %> <br />
  <div style="margin-left: 1em">
    <input type="radio" name="bac_seq_type" value="raw_seq" /><% __('raw sequence and/or quality') |h %><br />
    <input type="radio" name="bac_seq_type" value="trim_seq" checked="checked" /><% __('trimmed seq. and/or quality') |h %><br />
  </div>
</div>
	
	
</td></tr></table>

%    if ( $debug eq "1" ) {
%        print qq|<input type="checkbox" checked="checked" name="debug" /> print debug statements<br /><br />|;
%    }

	<input type="hidden" name="idType" value="bac_end" />
	<input type="reset" />&nbsp;&nbsp;
        <input type="submit" value="<% __('Submit') |h %>"><br />
   </form>


